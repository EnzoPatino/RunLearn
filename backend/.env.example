# ============================================================
# RunLearn backend — variables de entorno
# Copiá este archivo a .env para desarrollo local.
# En Render (producción) se configuran en el Dashboard del servicio.
# ============================================================

# --- Servidor ---
# Render asigna el puerto dinámicamente; local/docker usa 5000.
PORT=5000
NODE_ENV=development

# Secreto para firmar/verificar JWT. OBLIGATORIO en producción (Render).
# Generá uno con: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# --- CORS ---
# Lista separada por comas de orígenes permitidos. Default: * (cualquiera).
# Producción recomendado:
# CORS_ORIGINS=https://run-learn.vercel.app
CORS_ORIGINS=*

# --- PostgreSQL (Supabase en producción) ---
# Si DATABASE_URL está definida, se usa este connection string (con TLS).
# Supabase: Project Settings > Database > Connection string (URI).
# Ejemplo: postgresql://postgres.xxxx:password@aws-0.region.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# Fallback local (docker-compose): se usan SOLO si DATABASE_URL no está definida.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=runlearn_db

# --- Redis (Upstash en producción) ---
# Si REDIS_URL está definida, se usa esta URL (Upstash usa rediss:// con TLS).
# Upstash: Database > Connect > Redis protocol.
# Ejemplo: rediss://default:password@host.upstash.io:6379
# REDIS_URL=

# Fallback local (docker-compose): se usan SOLO si REDIS_URL no está definida.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
