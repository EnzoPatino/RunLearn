# Supabase > Project Settings > API. The anon/publishable key is safe for browser use
# when Row Level Security is enabled for any exposed database tables.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# URL base del backend Express.
# En desarrollo local: http://localhost:5000 (fallback por defecto de getApiBaseUrl()).
# En Vercel NO se usa localhost: hay que configurar la variable de entorno
# PUBLIC_API_URL con la URL pública del backend desplegado (Render, Railway, Fly.io, etc.).
# Importante: no apuntar esta variable al frontend de Vercel, sino al backend.
PUBLIC_API_URL=http://localhost:5000
