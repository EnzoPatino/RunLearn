# Supabase > Project Settings > API. The anon/publishable key is safe for browser use
# when Row Level Security is enabled for any exposed database tables.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional. Host the Express API separately (Render, Railway, Fly.io, etc.) for the
# interactive backend demonstrations. Do not point this to the Vercel frontend.
PUBLIC_API_URL=http://localhost:5000
