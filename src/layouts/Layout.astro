---
interface Props {
  title?: string;
}

const { title = "DevPlatform – Dashboard & Aula Virtual" } = Astro.props;
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <meta name="theme-color" content="#0b0c0a" />

  <!-- Google Fonts: Space Grotesk, Plus Jakarta Sans & JetBrains Mono (Non-blocking font loading) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@500;700&family=Space+Grotesk:wght@500;700&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@500;700&family=Space+Grotesk:wght@500;700&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@500;700&family=Space+Grotesk:wght@500;700&display=swap"
    />
  </noscript>
</head>
<body>
  <!-- Interactive flashlight cursor grid (solo en desktop con mouse) -->
  <div class="spot" id="spot" aria-hidden="true"></div>

  <!-- Ambient Lighting Effects -->
  <div class="ambient-glow ambient-glow--top" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow--bottom" aria-hidden="true"></div>

  <!-- Main App Shell -->
  <div class="app-viewport">
    <main class="dashboard" role="main">
      <slot />
    </main>
  </div>

  <script>
    // Solo activar el spotlight en dispositivos con mouse real (hover y pointer fino)
    const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hasFinePointer && !reducedMotion) {
      const spot = document.getElementById('spot');
      if (spot) {
        window.addEventListener('pointermove', (e) => {
          spot.style.setProperty('--sx', e.clientX + 'px');
          spot.style.setProperty('--sy', e.clientY + 'px');
        }, { passive: true });
      }
    }
  </script>
</body>
</html>
