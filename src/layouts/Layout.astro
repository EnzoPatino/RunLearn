---
interface Props {
  title?: string;
}

const { title = "DevPlatform – Dashboard & Aula Virtual" } = Astro.props;
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Google Fonts: Inter Display & Text -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <!-- Ambient Lighting Effects -->
  <div class="ambient-glow ambient-glow--top" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow--bottom" aria-hidden="true"></div>

  <!-- Main App Shell -->
  <div class="app-viewport">
    <main class="dashboard" role="main">
      <slot />
    </main>
  </div>
</body>
</html>
