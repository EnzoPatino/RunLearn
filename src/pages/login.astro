---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión – DevPlatform">
  <div class="login-wrapper">
    <div class="login-card">
      <h1 class="login-title">Iniciar Sesión</h1>
      <p class="login-subtitle">Accede a tu dashboard</p>

      <form id="loginForm" class="login-form" novalidate>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" placeholder="tu@email.com" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" placeholder="Tu contraseña" required autocomplete="current-password" />
        </div>

        <div id="errorMsg" class="error" hidden></div>

        <button type="submit" class="btn-login">Entrar</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .login-wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .login-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-white);
    text-align: center;
    letter-spacing: -0.02em;
  }

  .login-subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field input {
    background: var(--surface-inset);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-family: var(--font-main);
    font-size: 0.95rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field input:focus {
    border-color: var(--brand-blue);
    box-shadow: 0 0 0 3px var(--brand-blue-glow);
  }

  .field input::placeholder {
    color: var(--text-muted);
  }

  .error {
    background: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #f43f5e;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    text-align: center;
  }

  .btn-login {
    background: var(--brand-blue);
    color: var(--text-white);
    font-family: var(--font-main);
    font-size: 0.95rem;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    padding: 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
    margin-top: 0.25rem;
  }

  .btn-login:hover {
    background: #2563eb;
    box-shadow: 0 0 20px var(--brand-blue-glow);
  }

  .btn-login:active {
    transform: scale(0.98);
  }

  .btn-login:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  function setupLoginForm() {
    const form = document.getElementById('loginForm') as HTMLFormElement | null;
    const errorMsg = document.getElementById('errorMsg');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorMsg) {
        errorMsg.hidden = true;
        errorMsg.textContent = '';
      }

      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const passwordInput = document.getElementById('password') as HTMLInputElement | null;
      const email = emailInput?.value.trim() || '';
      const password = passwordInput?.value || '';

      const btn = form.querySelector('.btn-login') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Entrando...';
      }

      const apiBase =
        (window as any).RUNLEARN_API_URL ||
        (window as any).API_URL ||
        import.meta.env?.PUBLIC_API_URL ||
        'http://localhost:5000';

      try {
        const res = await fetch(`${apiBase}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        if (res.status === 401) {
          const data = await res.json().catch(() => ({}));
          if (errorMsg) {
            errorMsg.textContent = data.message || 'Credenciales inválidas';
            errorMsg.hidden = false;
          }
          return;
        }

        if (!res.ok) throw new Error('Error en el servidor');

        const data = await res.json();
        localStorage.setItem('token', data.token);
        window.dispatchEvent(new CustomEvent('auth-change'));
        window.location.href = '/';
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent = 'Error de conexión. Inténtalo de nuevo.';
          errorMsg.hidden = false;
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Entrar';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLoginForm);
  } else {
    setupLoginForm();
  }

  document.addEventListener('astro:page-load', setupLoginForm);
</script>
