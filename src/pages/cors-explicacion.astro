  button.ghost:hover { color: var(--text-white); border-color: var(--border-hover); }

  .browser-console { background: #090c10; border: 1px solid var(--api-border-soft); border-radius: 8px; overflow: hidden; }
  .console-header { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--api-muted-2); padding: 6px 10px; background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--api-border-soft); }
  .console-output { padding: 8px 10px; min-height: 96px; max-height: 180px; overflow-y: auto; font-family: var(--font-mono); font-size: 11px; line-height: 1.6; }
  .console-output div { white-space: pre-wrap; word-break: break-word; }
  .c-req { color: #93c5fd; }
