---
import Layout from '../layouts/Layout.astro';
import BackendErrorBanner from '../components/BackendErrorBanner.astro';
---

<Layout title="RunLearn — CORS (Cross-Origin Resource Sharing)">
  <div class="api-page">
    <div class="topbar">
      <div class="topbar-main">
        <a class="brand-link" href="/" aria-label="Volver al inicio de RunLearn">
          <span class="brand-mark">RL</span>
          <span>RunLearn</span>
        </a>
        <div class="crumbs" aria-label="Ruta actual">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <span class="current">CORS</span>
        </div>
      </div>
      <div class="topbar-actions">
        <button class="sound-btn" id="btn-toggle-sound" type="button" aria-pressed="false">
          <span id="sound-icon" aria-hidden="true"></span>
          <span id="sound-text">Sonido activo</span>
        </button>
        <a class="home-action" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10.8 9-7.2 9 7.2"/>
            <path d="M5.5 9.5V20h13V9.5"/>
            <path d="M9.5 20v-6h5v6"/>
          </svg>
          Inicio
        </a>
        <div class="badge-live"><span class="dot"></span>módulo interactivo</div>
      </div>
    </div>

    <h1>CORS (Cross-Origin Resource Sharing)</h1>
    <p class="lede">
      Por <strong>Same-Origin Policy</strong>, el navegador no permite que un sitio lea la respuesta de otro dominio. <strong>CORS</strong> es el mecanismo por el cual el servidor autoriza (o no) esos orígenes con el header <code>Access-Control-Allow-Origin</code>. Probá ambos modos: en <strong>restrictivo</strong> la pestaña externa queda bloqueada; en <strong>abierto</strong> (<code>*</code>) la respuesta llega sin problema.
    </p>

    <!-- MODE SELECTOR -->
    <div class="mode-selector-card">
      <div class="mode-toggle-group">
        <button type="button" class="mode-btn active" id="btn-mode-restrictivo" data-mode="restrictivo">
          <svg class="mode-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <div class="mode-btn-text">
            <span class="mode-name">Modo restrictivo</span>
            <span class="mode-desc">Access-Control-Allow-Origin: sólo mi dominio</span>
          </div>
        </button>
        <button type="button" class="mode-btn" id="btn-mode-abierto" data-mode="abierto">
          <svg class="mode-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <div class="mode-btn-text">
            <span class="mode-name">Modo abierto</span>
            <span class="mode-desc">Access-Control-Allow-Origin: *</span>
          </div>
        </button>
      </div>
      <div class="mode-status-badge safe" id="mode-status-badge">
        <span class="mode-status-dot"></span>
        <span id="mode-status-text">RESTRINGIDO — ACAO sólo para el portal</span>
      </div>
    </div>

    <!-- Banner de error si el backend no responde -->
    <BackendErrorBanner
      id="cors-backend-error"
      message="No se pudo conectar con el servidor. Verificá que el backend esté corriendo."
      hint="Este módulo comprueba encabezados CORS reales enviados por Express en /api/cors-demo."
    />

    <!-- BROWSER TABS -->
    <div class="tabs-container">
      <!-- PESTAÑA: EL PORTAL (este sitio) -->
      <div class="browser-tab portal-tab">
        <div class="tab-bar">
          <div class="tab-dots">
            <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
          </div>
          <div class="tab-url">
            <svg class="tab-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span id="portal-url">este sitio</span>
          </div>
        </div>
        <div class="tab-body">
          <div class="site-head">
            <span class="site-logo">RL</span>
            <div>
              <div class="site-name">RunLearn (el portal)</div>
              <div class="site-sub">Es el dueño del recurso → su propio origen</div>
            </div>
          </div>
          <button class="primary tab-run" id="btn-run-portal" type="button">fetch('/api/cors-demo')</button>
          <div class="browser-console">
            <div class="console-header">Consola de la pestaña</div>
            <div class="console-output" id="portal-console"></div>
          </div>
        </div>
      </div>

      <!-- PESTAÑA: SITIO EXTERNO -->
      <div class="browser-tab external-tab">
        <div class="tab-bar ext-bar">
          <div class="tab-dots">
            <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
          </div>
          <div class="tab-url ext-url">
            <svg class="tab-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>https://sitio-externo.com</span>
          </div>
        </div>
        <div class="tab-body ext-body">
          <div class="site-head">
            <span class="site-logo ext-logo">EXT</span>
            <div>
              <div class="site-name">sitio-externo.com</div>
              <div class="site-sub">Otro dominio quiere consumir la API de RunLearn</div>
            </div>
          </div>
          <button class="danger tab-run" id="btn-run-externo" type="button">fetch('/api/cors-demo')</button>
          <div class="browser-console">
            <div class="console-header">Consola de la pestaña</div>
            <div class="console-output" id="extern-console"></div>
          </div>
        </div>
      </div>
    </div>

    <p class="sim-note">
      Nota: la pestaña externa es una <strong>representación visual</strong> de otro sitio. La petición real sale de esta página hacia el backend, así que la consola de tu navegador imprime el mismo error de CORS con el origen de esta página.
    </p>

    <!-- DIAGRAMA -->
    <div class="diagram-card">
      <div class="diagram-meta">
        <span class="status-pill" id="status-pill">Listo para simular</span>
        <span class="mode-hint" id="mode-hint">Restrictivo: el header sólo se envía si el origen está en la lista blanca</span>
      </div>

      <div class="diagram" id="diagram">
        <svg class="lines">
          <line x1="12%" y1="50%" x2="88%" y2="50%" stroke="var(--api-line)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="node" id="node-sitio" style="left:12%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <path d="M3 9h18"/>
              <path d="M6.5 6.5h.01"/>
            </svg>
          </div>
          <div class="label" id="node-sitio-label">sitio-externo.com</div>
        </div>

        <div class="node" id="node-browser" style="left:50%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v6c0 4-3 7-7 8-4-1-7-4-7-8V6z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div class="label">Navegador</div>
        </div>

        <div class="node" id="node-api" style="left:88%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="7" rx="2"/>
              <rect x="3" y="13" width="18" height="7" rx="2"/>
              <path d="M7 7.5h.01M7 16.5h.01"/>
            </svg>
          </div>
          <div class="label">API /api/cors-demo</div>
        </div>

        <div class="packet" id="packet"></div>
      </div>
    </div>

    <div class="controls">
      <div class="step-track" id="step-track"></div>
      <span class="step-count" id="step-count">0 / 5</span>
      <button class="ghost" id="btn-reset" type="button">Reiniciar</button>
    </div>

    <!-- RESULT BANNER -->
    <div class="result-banner" id="result-banner" style="display:none">
      <div class="result-icon" id="result-icon"></div>
      <div class="result-body">
        <div class="result-title" id="result-title"></div>
        <div class="result-desc" id="result-desc"></div>
      </div>
    </div>

    <!-- SPLIT: CÓDIGO + EXPLICACIÓN -->
    <div class="split">
      <div class="panel">
        <div class="panel-head">
          <span class="title">Código</span>
          <span class="filename" id="code-filename">cors-demo.js</span>
        </div>
        <pre class="code"><span class="line" data-key="fetch"><span class="cm">// la pestaña (JavaScript)</span></span>
<span class="line" data-key="fetch"><span class="kw">const</span> res = <span class="kw">await</span> <span class="fn">fetch</span>(<span class="str">'/api/cors-demo?mode=…'</span>);</span>
<span class="line" data-key="origin"><span class="cm">// el navegador agrega Origin: https://sitio-externo.com</span></span>
<span class="line" data-key="origin"><span class="cm">// (lo escribe el navegador, el sitio no puede cambiarlo)</span></span>
<span class="line">&nbsp;</span>
<span class="line" data-key="check"><span class="cm">// el navegador revisa el header antes de entregar la respuesta</span></span>
<span class="line" data-key="check"><span class="kw">if</span> (!autorizado) <span class="kw">throw new</span> <span class="fn">TypeError</span>(<span class="str">'Failed to fetch'</span>);</span>
<span class="line" data-key="ok"><span class="kw">const</span> data = <span class="kw">await</span> res.<span class="fn">json</span>(); <span class="cm">// sí se puede leer</span></span>
<span class="line" data-key="blocked"><span class="cm">// el body existió en la red, pero el JS nunca lo ve</span></span></pre>
        <div class="code-divider"></div>
        <pre class="code"><span class="line" data-key="portal"><span class="cm">// lista blanca: sólo los orígenes del portal</span></span>
<span class="line" data-key="portal"><span class="kw">const</span> PORTAL_ORIGINS = [<span class="str">'http://localhost:4321'</span>, …];</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="restrictivo"><span class="kw">if</span> (mode === <span class="str">'restrictivo'</span>) {</span>
<span class="line" data-key="restrictivo">  <span class="kw">if</span> (PORTAL_ORIGINS.<span class="fn">includes</span>(origin)) {</span>
<span class="line" data-key="restrictivo">    res.<span class="fn">set</span>(<span class="str">'Access-Control-Allow-Origin'</span>, origin); <span class="cm">// mi dominio</span></span>
<span class="line" data-key="restrictivo">  }</span>
<span class="line" data-key="deny">  <span class="cm">// sin header → el navegador bloquea la respuesta</span></span>
<span class="line" data-key="restrictivo">}</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="abierto"><span class="kw">if</span> (mode === <span class="str">'abierto'</span>) {</span>
<span class="line" data-key="abierto">  res.<span class="fn">set</span>(<span class="str">'Access-Control-Allow-Origin'</span>, <span class="str">'*'</span>); <span class="cm">// cualquiera</span></span>
<span class="line" data-key="abierto">}</span></pre>
      </div>

      <div class="panel">
        <div class="panel-head">
          <span class="title">Qué está pasando</span>
        </div>
        <div class="explain-body">
          <div id="explain-idle" class="explain-idle">
            Elegí un modo arriba y hacé clic en <strong>fetch('/api/cors-demo')</strong> en una de las dos pestañas. La pestaña externa simula un sitio de otro dominio intentando consumir la API de RunLearn; la pestaña del portal es este mismo sitio.
          </div>
          <div id="explain-active" style="display:none">
            <div class="explain-tag" id="explain-tag">petición</div>
            <div class="explain-text" id="explain-text"></div>
          </div>
          <div class="console-line" id="console-line" style="display:none"></div>

          <div class="concepts-grid">
            <div class="concept-item">
              <div>
                <strong>Same-Origin Policy:</strong> el navegador agrupa por «origen» a <em>protocolo + dominio + puerto</em> (<code>https://sitio-externo.com:443</code>). Por defecto, un sitio puede hacer peticiones a otro, pero <strong>no puede leer su respuesta</strong>. Es la base del aislamiento de la web: sin ella, cualquier página podría leer tu correo, tu banco o tu panel admin con solo visitarla.
              </div>
            </div>
            <div class="concept-item">
              <div>
                <strong>¿Por qué existe CORS?</strong> Same-Origin Policy es demasiado rígida para la web moderna (SPA + API en otro dominio). CORS es la válvula de escape controlada por el <em>servidor</em>: si responde con <code>Access-Control-Allow-Origin</code> indicando tu origen, el navegador te entrega la respuesta; si no lo envía, la bloquea. El navegador hace cumplir la regla: un <code>curl</code> ignora CORS, pero también no tiene cookies ni sesión de tu navegador.
              </div>
            </div>
            <div class="concept-item">
              <div>
                <strong>Restrictivo vs. abierto:</strong> APIs <em>públicas</em> (clima, mapas, datos abiertos, sin credenciales) pueden usar <code>Access-Control-Allow-Origin: *</code> para que cualquiera las consuma. APIs <em>privadas</em> (con cookies, tokens o datos de usuarios) deben ir <strong>restrictivas</strong>: devolver sólo el origen exacto permitido, en lista blanca, y nunca <code>*</code>. Además, si usás <code>credentials: 'include'</code>, el navegador <strong>prohíbe</strong> el <code>*</code> — sólo funciona un origen puntual.
              </div>
            </div>
            <div class="concept-item">
              <div>
                <strong>CORS no es autenticación:</strong> CORS sólo controla qué sitio puede <em>leer</em> la respuesta en un navegador. Un cliente sin navegador puede mandar el <code>Origin</code> que quiera. Si el recurso es sensible, protegé el endpoint (login, JWT, rate limit) — CORS es una capa extra, no la seguridad principal.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
import { initSoundControls } from '../lib/soundControls.js';
import {
  fetchWithTimeout,
  getApiBaseUrl,
  showBackendErrorBanner,
  hideBackendErrorBanner,
} from '../lib/apiClient.js';

(function () {
  function setupCorsDemo() {
    const sound = initSoundControls();

    const API_BASE = `${getApiBaseUrl()}/api/cors-demo`;
    const API_ORIGIN = new URL(API_BASE).origin;
    const EXTERNAL_ORIGIN = 'https://sitio-externo.com';
    const STEP_COUNT = 5;
    const GAP = 1400;

    let mode = 'restrictivo';
    let running = false;

    const btnRestrictivo = document.getElementById('btn-mode-restrictivo');
    const btnAbierto = document.getElementById('btn-mode-abierto');
    const modeStatusBadge = document.getElementById('mode-status-badge');
    const modeStatusText = document.getElementById('mode-status-text');
    const modeHint = document.getElementById('mode-hint');
    const portalUrl = document.getElementById('portal-url');
    const btnRunPortal = document.getElementById('btn-run-portal');
    const btnRunExterno = document.getElementById('btn-run-externo');
    const portalConsole = document.getElementById('portal-console');
    const externConsole = document.getElementById('extern-console');
    const statusPill = document.getElementById('status-pill');
    const nodeSitioLabel = document.getElementById('node-sitio-label');
    const packet = document.getElementById('packet');
    const stepTrack = document.getElementById('step-track');
    const stepCount = document.getElementById('step-count');
    const btnReset = document.getElementById('btn-reset');
    const resultBanner = document.getElementById('result-banner');
    const resultIcon = document.getElementById('result-icon');
    const resultTitle = document.getElementById('result-title');
    const resultDesc = document.getElementById('result-desc');
    const codeFilename = document.getElementById('code-filename');
    const explainIdle = document.getElementById('explain-idle');
    const explainActive = document.getElementById('explain-active');
    const explainTag = document.getElementById('explain-tag');
    const explainText = document.getElementById('explain-text');
    const consoleLine = document.getElementById('console-line');
    const codeLines = document.querySelectorAll('.line');

    const nodePos = { sitio: 12, browser: 50, api: 88 };
    const nodeEls = ['sitio', 'browser', 'api'].map((id) => document.getElementById('node-' + id));

    if (portalUrl) portalUrl.textContent = location.host || location.origin;

    for (let i = 0; i < STEP_COUNT; i++) {
      const seg = document.createElement('div');
      seg.className = 'seg';
      seg.dataset.dir = i < 2 ? 'request' : 'response';
      stepTrack.appendChild(seg);
    }
    const segs = stepTrack.querySelectorAll('.seg');

    function sleep(ms) {
      return new Promise((r) => setTimeout(r, ms));
    }

    function escapeHtml(str) {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return String(str).replace(/[&<>"']/g, (c) => map[c]);
    }

    function highlightCode(keys) {
      codeLines.forEach((line) => {
        const k = line.getAttribute('data-key');
        line.classList.toggle('active', keys.includes(k));
      });
    }

    function clearNodes() {
      nodeEls.forEach((n) => n && n.classList.remove('active'));
    }

    function setNodeActive(id, color) {
      const node = document.getElementById('node-' + id);
      if (!node) return;
      node.classList.add('active');
      node.style.setProperty('--node-color', color);
    }

    function setStatus(text, kind) {
      if (!statusPill) return;
      statusPill.textContent = text;
      statusPill.className = 'status-pill' + (kind ? ' ' + kind : '');
    }

    function logTo(el, cls, text) {
      if (!el) return;
      const div = document.createElement('div');
      div.className = 'c-' + cls;
      div.textContent = text;
      el.appendChild(div);
      el.scrollTop = el.scrollHeight;
    }

    function setButtonsDisabled(disabled) {
      if (btnRunPortal) btnRunPortal.disabled = disabled;
      if (btnRunExterno) btnRunExterno.disabled = disabled;
    }

    function setMode(newMode) {
      mode = newMode;
      if (mode === 'restrictivo') {
        btnRestrictivo?.classList.add('active');
        btnAbierto?.classList.remove('active');
        modeStatusBadge.className = 'mode-status-badge safe';
        modeStatusText.textContent = 'RESTRINGIDO — ACAO sólo para el portal';
        modeHint.textContent = 'Restrictivo: el header sólo se envía si el origen está en la lista blanca';
        highlightCode(['portal', 'restrictivo']);
      } else {
        btnAbierto?.classList.add('active');
        btnRestrictivo?.classList.remove('active');
        modeStatusBadge.className = 'mode-status-badge warn';
        modeStatusText.textContent = 'ABIERTO — Access-Control-Allow-Origin: *';
        modeHint.textContent = 'Abierto: cualquier origen recibe Access-Control-Allow-Origin: *';
        highlightCode(['abierto']);
      }
      resetAll();
    }

    function resetAll() {
      running = false;
      setButtonsDisabled(false);
      if (portalConsole) portalConsole.innerHTML = '';
      if (externConsole) externConsole.innerHTML = '';
      if (resultBanner) resultBanner.style.display = 'none';
      if (explainIdle) explainIdle.style.display = 'block';
      if (explainActive) explainActive.style.display = 'none';
      if (consoleLine) consoleLine.style.display = 'none';
      if (codeFilename) codeFilename.textContent = 'cors-demo.js';
      if (nodeSitioLabel) nodeSitioLabel.textContent = 'sitio-externo.com';
      if (packet) packet.classList.remove('visible');
      clearNodes();
      segs.forEach((seg) => seg.classList.remove('done'));
      stepCount.textContent = '0 / ' + STEP_COUNT;
      setStatus('Listo para simular', '');
      highlightCode(mode === 'restrictivo' ? ['portal', 'restrictivo'] : ['abierto']);
    }

    function buildUrl(who) {
      const u = new URL(API_BASE);
      u.searchParams.set('mode', mode);
      if (who === 'externo') u.searchParams.set('origin', EXTERNAL_ORIGIN);
      return u.toString();
    }

    const originOf = (who) => (who === 'externo' ? EXTERNAL_ORIGIN : location.origin);
    const siteOf = (who) => (who === 'externo' ? 'sitio-externo.com' : location.host || location.origin);

    async function doFetch(url) {
      try {
        const res = await fetchWithTimeout(url, {}, 5000);
        if (res.status === 404) return { error: 'http', status: 404 };
        const data = await res.json();
        if (!data || data.ok !== true) return { error: 'http', status: res.status };
        hideBackendErrorBanner('cors-backend-error');
        return { ok: true, data };
      } catch (err: any) {
        if (err?.isTimeout) {
          showBackendErrorBanner('cors-backend-error', 'Tiempo de espera agotado al conectar con el servidor.');
          return { error: 'network', isTimeout: true };
        }
        // ¿Fue CORS o el backend está caído?
        try {
          await fetchWithTimeout(url, { mode: 'no-cors' }, 3000);
          hideBackendErrorBanner('cors-backend-error');
          return { error: 'cors' };
        } catch {
          showBackendErrorBanner('cors-backend-error', 'No se pudo conectar con el servidor. Verificá que el backend esté corriendo.');
          return { error: 'network' };
        }
      }
    }

    function showStep(i, s) {
      const color =
        s.dir === 'request' ? 'var(--amber)' : s.dir === 'blocked' ? 'var(--red)' : 'var(--blue)';

      sound.play('playStep');
      clearNodes();
      setNodeActive(s.from, color);
      setNodeActive(s.to, color);

      packet.classList.add('visible');
      packet.style.background = color;
      packet.style.left = nodePos[s.from] + '%';
      void packet.offsetWidth;
      packet.style.left = nodePos[s.to] + '%';

      highlightCode(s.keys);
      codeFilename.textContent = s.file;

      explainIdle.style.display = 'none';
      explainActive.style.display = 'block';
      explainTag.textContent = s.tag;
      explainTag.className = 'explain-tag' + (s.tagClass ? ' ' + s.tagClass : '');
      explainText.innerHTML = s.text;
      consoleLine.style.display = 'none';

      segs.forEach((seg, idx) => seg.classList.toggle('done', idx <= i));
      stepCount.textContent = i + 1 + ' / ' + STEP_COUNT;
    }

    function showBanner(kind, title, desc) {
      if (!resultBanner) return;
      resultBanner.style.display = 'flex';
      resultIcon.textContent = kind === 'ok' ? '✓' : kind === 'network' ? '!' : '✕';
      resultTitle.textContent = title;
      resultTitle.className = 'result-title ' + (kind === 'ok' ? 'safe' : 'danger');
      resultDesc.textContent = desc;
    }

    async function runSimulation(who) {
      if (running) return;
      running = true;
      setButtonsDisabled(true);
      setStatus('Simulando…', 'pending');
      if (resultBanner) resultBanner.style.display = 'none';
      if (nodeSitioLabel) nodeSitioLabel.textContent = siteOf(who);

      const consoleEl = who === 'externo' ? externConsole : portalConsole;
      if (consoleEl) consoleEl.innerHTML = '';

      const url = buildUrl(who);
      const origin = originOf(who);
      logTo(consoleEl, 'req', '> GET ' + url);

      showStep(0, {
        from: 'sitio',
        to: 'browser',
        dir: 'request',
        keys: ['fetch', 'origin'],
        file: 'la pestaña',
        tag: 'petición →',
        text:
          'La pestaña <strong>' + escapeHtml(siteOf(who)) + '</strong> ejecuta <code>fetch()</code> contra la API de RunLearn. ' +
          'El navegador adjunta automáticamente <code>Origin: ' + escapeHtml(origin) + '</code>: el sitio no puede modificarlo ni inventarlo.',
      });
      await sleep(GAP);

      showStep(1, {
        from: 'browser',
        to: 'api',
        dir: 'request',
        keys: ['fetch'],
        file: 'la pestaña',
        tag: 'petición →',
        text:
          'Sale la petición <strong>GET /api/cors-demo</strong> hacia <code>' + escapeHtml(API_ORIGIN) + '</code> ' +
          '(modo <strong>' + mode + '</strong>). Es un <em>simple request</em>: sin headers especiales ni método raro, así que no hay preflight (OPTIONS).',
      });
      const result = await doFetch(url);
      await sleep(GAP);

      showStep(2, buildStep3(who, result));
      await sleep(GAP);

      showStep(3, buildStep4(who, result));
      await sleep(GAP);

      showStep(4, buildStep5(who, result));
      finish(who, consoleEl, result);

      running = false;
      setButtonsDisabled(false);
    }

    function buildStep3(who, result) {
      const base = {
        from: 'api',
        to: 'browser',
        dir: 'response',
        file: 'cors-demo.js',
        tag: 'respuesta ←',
        tagClass: 'response',
      };

      if (result.error === 'network') {
        return {
          ...base,
          keys: [],
          text:
            'No llegó respuesta: el navegador no pudo conectar con <code>' + escapeHtml(API_ORIGIN) +
            '</code>. Esto <strong>no</strong> es un error de CORS, es un error de red — ¿está corriendo el backend?',
        };
      }
      if (result.error === 'http') {
        return {
          ...base,
          keys: [],
          text:
            'El servidor respondió pero la ruta no existe (HTTP ' + result.status +
            '). Reconstruí el backend: <code>cd backend && docker compose up -d --build</code>.',
        };
      }
      if (mode === 'abierto') {
        return {
          ...base,
          keys: ['abierto'],
          text: result.ok
            ? 'El servidor responde <strong>200 OK</strong> con el JSON y agrega <code>Access-Control-Allow-Origin: *</code> ' +
              '— «esta respuesta la puede leer cualquier sitio». Es la configuración típica de una <strong>API pública</strong>.'
            : 'El modo abierto responde <strong>200 OK</strong> + <code>Access-Control-Allow-Origin: *</code>, pero la petición no se completó. ' +
              'Revisá que el backend esté corriendo y reconstruílo con <code>docker compose up -d --build</code>.',
        };
      }
      if (result.ok) {
        return {
          ...base,
          keys: ['portal', 'restrictivo'],
          text:
            'El servidor responde <strong>200 OK</strong> + <code>Access-Control-Allow-Origin: ' +
            escapeHtml(result.data.acao) + '</code> — exactamente el origen pedido, porque está en la lista blanca del portal.',
        };
      }
      return {
        ...base,
        keys: ['portal', 'restrictivo', 'deny'],
        text:
          'El servidor responde <strong>200 OK</strong> con el JSON… pero <strong>no envía Access-Control-Allow-Origin</strong>: ' +
          '<code>' + escapeHtml(originOf(who)) + '</code> no pertenece a los orígenes permitidos del portal.',
      };
    }

    function buildStep4(who, result) {
      const base = {
        from: 'browser',
        to: 'browser',
        dir: 'response',
        file: 'la pestaña',
        tag: 'validación',
        tagClass: 'response',
      };

      if (result.error === 'network' || result.error === 'http') {
        return {
          ...base,
          keys: ['blocked'],
          text: 'No hay respuesta que validar: el fetch ya falló antes de llegar a la política de same-origin.',
        };
      }

      return {
        ...base,
        keys: ['check'],
        text:
          'El navegador compara <code>Access-Control-Allow-Origin</code> con el <code>Origin</code> de la petición (' +
          escapeHtml(originOf(who)) + '). <strong>Sin header, o si no coincide, no entrega la respuesta al JavaScript</strong>: ' +
          '<code>fetch()</code> se rechaza con <code>TypeError: Failed to fetch</code>.',
      };
    }

    function buildStep5(who, result) {
      if (result.ok) {
        return {
          from: 'browser',
          to: 'sitio',
          dir: 'response',
          keys: ['check', 'ok'],
          file: 'la pestaña',
          tag: 'entregado',
          tagClass: 'safe',
          text:
            'El header autoriza este origen: el body cruza hacia la pestaña y <code>await res.json()</code> puede leerlo. ' +
            'Los datos quedan disponibles para el JavaScript del sitio.',
        };
      }
      if (result.error === 'cors') {
        return {
          from: 'browser',
          to: 'browser',
          dir: 'blocked',
          keys: ['check', 'blocked'],
          file: 'la pestaña',
          tag: 'bloqueado',
          tagClass: 'danger',
          text:
            'El navegador descarta la respuesta. El servidor <strong>sí respondió 200</strong>, pero el JavaScript de la pestaña ' +
            'nunca lo ve: en consola aparece el error de CORS y el <code>fetch()</code> queda rechazado.',
        };
      }
      return {
        from: 'browser',
        to: 'browser',
        dir: 'blocked',
        keys: ['blocked'],
        file: 'la pestaña',
        tag: 'error',
        tagClass: 'danger',
        text:
          'La petición falló por un problema del servidor o de red, no por CORS. Levantá el backend con ' +
          '<code>cd backend && docker compose up -d</code> y volvé a probar.',
      };
    }

    function finish(who, consoleEl, result) {
      const origin = originOf(who);

      if (result.ok) {
        logTo(consoleEl, 'ok', '< 200 OK');
        logTo(consoleEl, 'hdr', 'access-control-allow-origin: ' + result.data.acao);
        logTo(consoleEl, 'json', JSON.stringify(result.data, null, 2));
        sound.play('playSuccess');
        setStatus('Respuesta entregada al JavaScript', 'success');
        showBanner(
          'ok',
          mode === 'abierto' ? 'Respuesta entregada — API abierta' : 'Respuesta entregada — origen permitido',
          mode === 'abierto'
            ? 'El servidor envió Access-Control-Allow-Origin: *, así que el navegador entregó el body a la pestaña sin importar de dónde viniera la petición.'
            : 'El servidor envió Access-Control-Allow-Origin: ' + result.data.acao + ', exactamente el origen que pidió. Sólo ese dominio puede leer la respuesta.'
        );

        if (explainIdle) explainIdle.style.display = 'none';
        if (explainActive) explainActive.style.display = 'block';
        if (explainTag) {
          explainTag.textContent = 'respuesta entregada';
          explainTag.className = 'explain-tag safe';
        }
        if (explainText) {
          explainText.innerHTML =
            '<strong style="color:var(--green,#10b981)">La respuesta llegó al JavaScript:</strong> el header ' +
            '<code>Access-Control-Allow-Origin: ' + escapeHtml(result.data.acao) + '</code> autorizó a ' +
            '<code>' + escapeHtml(origin) + '</code> a leer el cuerpo de la respuesta. El navegador verificó el header antes de entregarlo.';
        }
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line success';
          consoleLine.innerHTML = '200 OK · Access-Control-Allow-Origin: ' + escapeHtml(result.data.acao);
        }
        return;
      }

      if (result.error === 'cors') {
        logTo(
          consoleEl,
          'err',
          "Access to fetch at '" + buildUrl(who) + "' from origin '" + origin +
            "' has been blocked by CORS policy: No 'Access-Control-Allow-Origin' header is present on the requested resource."
        );
        logTo(consoleEl, 'info', 'El servidor respondió 200, pero el navegador no entregó la respuesta al JavaScript.');
        sound.play('playBlocked');
        setStatus('Bloqueado por CORS', 'danger');
        showBanner(
          'blocked',
          'Respuesta bloqueada por CORS',
          'El servidor contestó 200 con el JSON, pero no envió Access-Control-Allow-Origin para ' + origin + '. El navegador ocultó la respuesta y el fetch falló con TypeError: Failed to fetch.'
        );

        if (explainIdle) explainIdle.style.display = 'none';
        if (explainActive) explainActive.style.display = 'block';
        if (explainTag) {
          explainTag.textContent = 'bloqueado por CORS';
          explainTag.className = 'explain-tag danger';
        }
        if (explainText) {
          explainText.innerHTML =
            '<strong style="color:var(--red,#ef4444)">El navegador bloqueó la lectura:</strong> en modo restrictivo el servidor no envía ' +
            '<code>Access-Control-Allow-Origin</code> para orígenes ajenos al portal. La respuesta viajó por la red, pero la Same-Origin Policy ' +
            'impide que el JavaScript de ' + escapeHtml(origin) + ' la lea. Fijate en la consola real de tu navegador: ahí aparece este mismo error.';
        }
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line danger';
          consoleLine.innerHTML = "CORS: No 'Access-Control-Allow-Origin' header is present on the requested resource.";
        }
        return;
      }

      logTo(consoleEl, 'err', 'Failed to fetch — sin respuesta de ' + API_ORIGIN);
      logTo(consoleEl, 'info', 'Esto es un error de red, no de CORS. ¿Backend corriendo? (cd backend && docker compose up -d)');
      sound.play('playAlert');
      setStatus('Sin conexión con el backend', 'danger');
      showBanner(
        'network',
        result.error === 'http' ? 'Endpoint no encontrado' : 'No se pudo conectar con el backend',
        result.error === 'http'
          ? 'La ruta no existe en la API. Reconstruí la imagen: cd backend && docker compose up -d --build'
          : 'No hay respuesta de ' + API_ORIGIN + '. Levantá el backend con: cd backend && docker compose up -d'
      );

      if (explainIdle) explainIdle.style.display = 'none';
      if (explainActive) explainActive.style.display = 'block';
      if (explainTag) {
        explainTag.textContent = 'error de conexión';
        explainTag.className = 'explain-tag danger';
      }
      if (explainText) {
        explainText.innerHTML =
          'No hay backend en <code>' + escapeHtml(API_ORIGIN) + '</code>. Abrí una terminal y ejecutá ' +
          '<code>cd backend && docker compose up -d</code>; después volvé a probar la simulación.';
      }
      if (consoleLine) {
        consoleLine.style.display = 'block';
        consoleLine.className = 'console-line danger';
        consoleLine.innerHTML = 'Sin respuesta de ' + escapeHtml(API_ORIGIN) + ' — revisá que el backend esté corriendo.';
      }
    }

    btnRestrictivo?.addEventListener('click', () => setMode('restrictivo'));
    btnAbierto?.addEventListener('click', () => setMode('abierto'));
    btnRunPortal?.addEventListener('click', () => runSimulation('portal'));
    btnRunExterno?.addEventListener('click', () => runSimulation('externo'));
    btnReset?.addEventListener('click', () => {
      if (running) return;
      resetAll();
    });

    document.querySelector('[data-retry-target="cors-backend-error"]')?.addEventListener('click', () => {
      runSimulation('portal');
    });

    setMode('restrictivo');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCorsDemo);
  } else {
    setupCorsDemo();
  }
})();
</script>

