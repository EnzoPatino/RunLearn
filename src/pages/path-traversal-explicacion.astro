---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RunLearn — Path Traversal">
  <div class="api-page">
    <div class="topbar">
      <div class="topbar-main">
        <a class="brand-link" href="/" aria-label="Volver al inicio de RunLearn">
          <span class="brand-mark">RL</span>
          <span>RunLearn</span>
        </a>
        <div class="crumbs" aria-label="Ruta actual">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <span class="current">Path Traversal</span>
        </div>
      </div>
      <div class="topbar-actions">
        <button class="sound-btn" id="btn-toggle-sound" type="button" aria-pressed="false">
          <span id="sound-icon" aria-hidden="true"></span>
          <span id="sound-text">Sonido activo</span>
        </button>
        <a class="home-action" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10.8 9-7.2 9 7.2"/>
            <path d="M5.5 9.5V20h13V9.5"/>
            <path d="M9.5 20v-6h5v6"/>
          </svg>
          Inicio
        </a>
        <div class="badge-live"><span class="dot"></span>módulo interactivo</div>
      </div>
    </div>

    <h1>Path Traversal</h1>
    <p class="lede">
      Si el servidor arma la ruta de un archivo con lo que escribe el usuario, basta un <code>../</code> para subir un nivel y leer algo que estaba fuera de la carpeta permitida. Acá sólo se leen archivos de la demo (<code>backend/archivos-demo/</code>) y un señuelo adentro de <code>backend/</code>: <strong>no se toca ningún archivo real del sistema</strong>. Probá ambos modos con el payload <code>../secreto-simulado.txt</code>.
    </p>

    <!-- MODE SELECTOR -->
    <div class="mode-selector-card">
      <div class="mode-toggle-group">
        <button type="button" class="mode-btn active" id="btn-mode-vulnerable" data-mode="vulnerable">
          <svg class="mode-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
          <div class="mode-btn-text">
            <span class="mode-name">Modo vulnerable</span>
            <span class="mode-desc">path.join(base, nombre) sin validar</span>
          </div>
        </button>
        <button type="button" class="mode-btn" id="btn-mode-seguro" data-mode="seguro">
          <svg class="mode-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <div class="mode-btn-text">
            <span class="mode-name">Modo seguro</span>
            <span class="mode-desc">Rechaza ".." y separadores de ruta</span>
          </div>
        </button>
      </div>
      <div class="mode-status-badge danger" id="mode-status-badge">
        <span class="mode-status-dot"></span>
        <span id="mode-status-text">VULNERABLE — la ruta se arma sin validar</span>
      </div>
    </div>

    <!-- DIAGRAMA + INPUT -->
    <div class="diagram-card">
      <div class="diagram-meta">
        <span class="status-pill" id="status-pill">Listo para simular</span>
        <span class="mode-hint" id="mode-hint">Vulnerable: el input se concatena directo a la ruta base</span>
      </div>

      <div class="diagram" id="diagram">
        <svg class="lines">
          <line x1="14%" y1="50%" x2="86%" y2="50%" stroke="var(--api-line)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="node" id="node-entrada" style="left:14%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h4l10-10a2.5 2.5 0 0 0-3.5-3.5L4.5 16.5z"/>
              <path d="m13.5 7.5 3 3"/>
            </svg>
          </div>
          <div class="label">Input del usuario</div>
        </div>

        <div class="node" id="node-join" style="left:50%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 8-4 4 4 4"/>
              <path d="m15 8 4 4-4 4"/>
            </svg>
          </div>
          <div class="label">path.join()</div>
        </div>

        <div class="node" id="node-disco" style="left:86%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
              <path d="M14 3v5h5"/>
              <path d="M9 13h6M9 17h4"/>
            </svg>
          </div>
          <div class="label">archivo en disco</div>
        </div>

        <div class="packet" id="packet"></div>
      </div>

      <div class="input-zone">
        <label for="pt-input" class="input-label">Archivo a leer (relativo a <code>backend/archivos-demo/</code>):</label>
        <div class="input-row">
          <input type="text" id="pt-input" class="pt-input" value="reporte.txt" autocomplete="off" spellcheck="false" />
          <button class="primary" id="btn-read" type="button">Leer archivo</button>
        </div>
        <div class="preset-buttons">
          <button class="ghost preset-btn" id="btn-preset-reporte" type="button">
            <span class="preset-text">Archivo normal<br /><code>reporte.txt</code></span>
          </button>
          <button class="ghost preset-btn" id="btn-preset-notas" type="button">
            <span class="preset-text">Otro normal<br /><code>notas.txt</code></span>
          </button>
          <button class="ghost preset-btn danger-preset" id="btn-preset-payload" type="button">
            <span class="preset-text">Payload de escape<br /><code>../secreto-simulado.txt</code></span>
          </button>
        </div>
      </div>

      <div class="result-zone" id="result-zone" style="display:none">
        <div class="result-section">
          <div class="result-label">Petición:</div>
          <pre class="path-display" id="req-display"></pre>
        </div>
        <div class="result-section">
          <div class="result-label">Ruta resuelta en el servidor:</div>
          <pre class="path-display" id="path-display"></pre>
        </div>
        <div class="result-section">
          <div class="result-label" id="output-label">Contenido:</div>
          <pre class="file-display" id="file-display"></pre>
        </div>
        <div class="result-warning" id="result-warning" style="display:none"></div>
      </div>
    </div>

    <div class="controls">
      <div class="step-track" id="step-track"></div>
      <span class="step-count" id="step-count">0 / 4</span>
      <button class="ghost" id="btn-reset" type="button">Reiniciar</button>
    </div>

    <!-- SPLIT: CÓDIGO + EXPLICACIÓN -->
    <div class="split">
      <div class="panel">
        <div class="panel-head">
          <span class="title">Código del endpoint</span>
          <span class="filename" id="code-filename">path-traversal-demo.js</span>
        </div>
        <pre class="code"><span class="line" data-key="input"><span class="cm">// sandbox demo: sólo backend/, nunca .env ni .git</span></span>
<span class="line" data-key="input"><span class="kw">const</span> nombre = req.query.archivo;  <span class="cm">// llega del usuario</span></span>
<span class="line">&nbsp;</span>
<span class="line" data-key="vuln"><span class="cm">// VULNERABLE — concatenar sin validar</span></span>
<span class="line" data-key="vuln"><span class="kw">const</span> ruta = path.<span class="fn">join</span>(BASE_DIR, nombre);</span>
<span class="line" data-key="vuln"><span class="cm">// '../secreto-simulado.txt' → sube un nivel y escapa</span></span>
<span class="line" data-key="vuln"><span class="kw">const</span> contenido = <span class="kw">await</span> fs.<span class="fn">readFile</span>(ruta, <span class="str">'utf8'</span>);</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="safe"><span class="cm">// SEGURO — sanear ANTES de tocar el disco</span></span>
<span class="line" data-key="safe"><span class="kw">if</span> (nombre.<span class="fn">includes</span>(<span class="str">'..'</span>) || <span class="str">/[\\/]/</span>.<span class="fn">test</span>(nombre)) &#123;</span>
<span class="line" data-key="safe">  <span class="kw">return</span> res.status(<span class="num">400</span>).json(&#123; error: <span class="str">'Ruta inválida'</span> &#125;);</span>
<span class="line" data-key="safe">&#125;</span>
<span class="line" data-key="safe"><span class="kw">const</span> ruta = path.<span class="fn">resolve</span>(BASE_DIR, nombre);</span>
<span class="line" data-key="check"><span class="kw">if</span> (!ruta.<span class="fn">startsWith</span>(BASE_DIR + <span class="str">'/'</span>)) <span class="kw">return</span> res.status(<span class="num">403</span>);</span>
<span class="line" data-key="send">res.<span class="fn">json</span>(&#123; ok: <span class="kw">true</span>, contenido &#125;);</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="why"><span class="cm">// La defensa real no es "buscar ..": es RESOLVER la ruta</span></span>
<span class="line" data-key="why"><span class="cm">// absoluta (path.resolve / realpath) y comprobar que siga</span></span>
<span class="line" data-key="why"><span class="cm">// DENTRO del directorio permitido antes de servirla.</span></span></pre>
      </div>

      <div class="panel">
        <div class="panel-head">
          <span class="title">Qué está pasando</span>
        </div>
        <div class="explain-body">
          <div id="explain-idle" class="explain-idle">
            Elegí un modo y tocá <strong>Leer archivo</strong> (o uno de los presets). Primero probá un archivo normal como <code>reporte.txt</code>; después mandá el payload <code>../secreto-simulado.txt</code> en modo <strong>vulnerable</strong> para ver el escape de directorio, y repetilo en modo <strong>seguro</strong> para verlo rechazado.
          </div>
          <div id="explain-active" style="display:none">
            <div class="explain-tag" id="explain-tag">lectura</div>
            <div class="explain-text" id="explain-text"></div>
          </div>
          <div class="console-line" id="console-line" style="display:none"></div>

          <div class="concepts-grid">
            <div class="concept-item">
              <div>
                <strong>¿Qué es Path Traversal?</strong> También llamado <em>Directory Traversal</em>: el atacante introduce secuencias como <code>../</code> («subir un nivel») en un parámetro que el servidor usa para armar la ruta de un archivo. Con <code>../../etc/passwd</code>, <code>../../../.env</code> o rutas absolutas, la lectura sale del directorio que el programador tenía en mente.
              </div>
            </div>
            <div class="concept-item">
              <div>
                <strong>¿Por qué ocurre?</strong> El sistema de archivos no entiende de «carpetas permitidas»: sólo de rutas. Si el servidor concatena el input y confía en el resultado (<code>path.join(BASE, nombre)</code>), cualquier <code>../</code> que no esté contemplado mueve la ruta hacia arriba. El error no está en <code>path.join</code>, está en <strong>no verificar dónde termina la ruta</strong>.
              </div>
            </div>
            <div class="concept-item">
              <div>
                <strong>Resolver y validar ANTES de servir:</strong> la defensa correcta es armar la ruta absoluta (<code>path.resolve()</code> o <code>fs.realpath()</code>) y comprobar que <strong>sigue dentro del directorio base</strong> (<code>ruta.startsWith(BASE + '/')</code>) antes de abrir el archivo. Filtrar sólo «<code>..</code>» es frágil: hay variantes codificadas (<code>%2e%2e</code>), separadores mezclados y symlinks; la verificación de la ruta final las cubre todas.
              </div>
            </div>
            <div class="concept-item">
              <div>
                <strong>Buenas prácticas extra:</strong> usar una <em>allow-list</em> de nombres en vez de rutas libres, servir sólo el <code>basename</code>, correr el proceso con permisos mínimos y no devolver rutas internas en los errores. Comparar la ruta <em>después</em> de abrir el archivo ya no sirve: el contenido se leyó igual.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
import { initSoundControls } from '../lib/soundControls.js';

(function () {
  function setupPathTraversalDemo() {
    const sound = initSoundControls();

    const API_BASE = (window.RUNLEARN_API_URL || 'http://localhost:5000') + '/api/path-traversal-demo';
    const STEP_COUNT = 4;
    const GAP = 1300;

    let mode = 'vulnerable';
    let running = false;

    const btnVulnerable = document.getElementById('btn-mode-vulnerable');
    const btnSeguro = document.getElementById('btn-mode-seguro');
    const modeStatusBadge = document.getElementById('mode-status-badge');
    const modeStatusText = document.getElementById('mode-status-text');
    const modeHint = document.getElementById('mode-hint');
    const ptInput = document.getElementById('pt-input');
    const btnRead = document.getElementById('btn-read');
    const btnPresetReporte = document.getElementById('btn-preset-reporte');
    const btnPresetNotas = document.getElementById('btn-preset-notas');
    const btnPresetPayload = document.getElementById('btn-preset-payload');
    const resultZone = document.getElementById('result-zone');
    const reqDisplay = document.getElementById('req-display');
    const pathDisplay = document.getElementById('path-display');
    const outputLabel = document.getElementById('output-label');
    const fileDisplay = document.getElementById('file-display');
    const resultWarning = document.getElementById('result-warning');
    const statusPill = document.getElementById('status-pill');
    const stepTrack = document.getElementById('step-track');
    const stepCount = document.getElementById('step-count');
    const btnReset = document.getElementById('btn-reset');
    const codeFilename = document.getElementById('code-filename');
    const explainIdle = document.getElementById('explain-idle');
    const explainActive = document.getElementById('explain-active');
    const explainTag = document.getElementById('explain-tag');
    const explainText = document.getElementById('explain-text');
    const consoleLine = document.getElementById('console-line');
    const codeLines = document.querySelectorAll('.line');

    const nodePos = { entrada: 14, join: 50, disco: 86 };
    const nodeEls = ['entrada', 'join', 'disco'].map((id) => document.getElementById('node-' + id));
    const packet = document.getElementById('packet');

    for (let i = 0; i < STEP_COUNT; i++) {
      const seg = document.createElement('div');
      seg.className = 'seg';
      seg.dataset.dir = i < 3 ? 'request' : 'response';
      stepTrack.appendChild(seg);
    }
    const segs = stepTrack.querySelectorAll('.seg');

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    function escapeHtml(str) {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return String(str).replace(/[&<>"']/g, (c) => map[c]);
    }

    function highlightCode(keys) {
      codeLines.forEach((line) => {
        const k = line.getAttribute('data-key');
        line.classList.toggle('active', keys.includes(k));
      });
    }

    function clearNodes() {
      nodeEls.forEach((n) => n && n.classList.remove('active'));
    }

    function setNodeActive(id, color) {
      const node = document.getElementById('node-' + id);
      if (!node) return;
      node.classList.add('active');
      node.style.setProperty('--node-color', color);
    }

    function setStatus(text, kind) {
      if (!statusPill) return;
      statusPill.textContent = text;
      statusPill.className = 'status-pill' + (kind ? ' ' + kind : '');
    }

    function setMode(newMode) {
      mode = newMode;
      if (mode === 'vulnerable') {
        btnVulnerable?.classList.add('active');
        btnSeguro?.classList.remove('active');
        modeStatusBadge.className = 'mode-status-badge danger';
        modeStatusText.textContent = 'VULNERABLE — la ruta se arma sin validar';
        modeHint.textContent = 'Vulnerable: el input se concatena directo a la ruta base';
        highlightCode(['vuln']);
      } else {
        btnSeguro?.classList.add('active');
        btnVulnerable?.classList.remove('active');
        modeStatusBadge.className = 'mode-status-badge safe';
        modeStatusText.textContent = 'SEGURO — ".." y separadores rechazados';
        modeHint.textContent = 'Seguro: se valida y se resuelve la ruta antes de abrir el archivo';
        highlightCode(['safe']);
      }
      resetAll();
    }

    function resetAll() {
      running = false;
      if (btnRead) btnRead.disabled = false;
      if (resultZone) resultZone.style.display = 'none';
      if (resultWarning) resultWarning.style.display = 'none';
      if (explainIdle) explainIdle.style.display = 'block';
      if (explainActive) explainActive.style.display = 'none';
      if (consoleLine) consoleLine.style.display = 'none';
      if (codeFilename) codeFilename.textContent = 'path-traversal-demo.js';
      if (packet) packet.classList.remove('visible');
      clearNodes();
      segs.forEach((seg) => seg.classList.remove('done'));
      stepCount.textContent = '0 / ' + STEP_COUNT;
      setStatus('Listo para simular', '');
      highlightCode(mode === 'vulnerable' ? ['vuln'] : ['safe']);
    }

    function showStep(i, s) {
      const color =
        s.dir === 'request' ? 'var(--amber)' : s.dir === 'blocked' ? 'var(--red)' : 'var(--blue)';

      sound.play('playStep');
      clearNodes();
      setNodeActive(s.from, color);
      setNodeActive(s.to, color);

      packet.classList.add('visible');
      packet.style.background = color;
      packet.style.left = nodePos[s.from] + '%';
      void packet.offsetWidth;
      packet.style.left = nodePos[s.to] + '%';

      highlightCode(s.keys);
      if (codeFilename) codeFilename.textContent = s.file;

      explainIdle.style.display = 'none';
      explainActive.style.display = 'block';
      explainTag.textContent = s.tag;
      explainTag.className = 'explain-tag' + (s.tagClass ? ' ' + s.tagClass : '');
      explainText.innerHTML = s.text;
      consoleLine.style.display = 'none';

      segs.forEach((seg, idx) => seg.classList.toggle('done', idx <= i));
      stepCount.textContent = i + 1 + ' / ' + STEP_COUNT;
    }

    async function doFetch(nombre) {
      const url =
        API_BASE + '?archivo=' + encodeURIComponent(nombre) + '&mode=' + encodeURIComponent(mode);
      try {
        const res = await fetch(url);
        const data = await res.json().catch(() => null);
        return { url, status: res.status, data };
      } catch {
        return { url, status: 0, data: null };
      }
    }

    async function runFlow(nombre) {
      if (running) return;
      if (!nombre) {
        setStatus('Escribí el nombre de un archivo', 'danger');
        return;
      }

      running = true;
      if (btnRead) btnRead.disabled = true;
      if (resultZone) resultZone.style.display = 'none';
      if (resultWarning) resultWarning.style.display = 'none';
      setStatus('Consultando…', 'pending');

      showStep(0, {
        from: 'entrada',
        to: 'join',
        dir: 'request',
        keys: ['input'],
        file: 'entrada del usuario',
        tag: 'petición →',
        text:
          'El usuario pide leer <code>' + escapeHtml(nombre) + '</code>. El nombre viaja tal cual en ' +
          '<code>?archivo=</code>: el servidor no sabe si es un archivo cualquiera o una ruta con <code>../</code>.',
      });
      await sleep(GAP);

      showStep(1, {
        from: 'join',
        to: 'join',
        dir: 'request',
        keys: mode === 'vulnerable' ? ['vuln'] : ['safe', 'check'],
        file: 'path-traversal-demo.js',
        tag: mode === 'vulnerable' ? 'concatenación' : 'validación',
        text:
          mode === 'vulnerable'
            ? '<strong style="color:var(--red,#ef4444)">Sin validar:</strong> <code>path.join(BASE_DIR, nombre)</code> concatena lo que venga. ' +
              '<code>../secreto-simulado.txt</code> sube un nivel y queda <code>backend/secreto-simulado.txt</code>.'
            : '<strong style="color:var(--green,#10b981)">Antes de tocar el disco:</strong> se rechaza cualquier <code>..</code>, <code>/</code> o <code>\\</code> ' +
              'y recién después se arma la ruta con <code>path.resolve(BASE_DIR, nombre)</code>.',
      });
      const result = await doFetch(nombre);
      await sleep(GAP);

      showStep(2, buildStep2(nombre, result));
      await sleep(GAP);

      showStep(3, buildStep3(nombre, result));
      finish(nombre, result);

      running = false;
      if (btnRead) btnRead.disabled = false;
    }

    function buildStep2(nombre, result) {
      const base = {
        from: 'join',
        to: 'disco',
        dir: 'request',
        file: 'path-traversal-demo.js',
        tag: 'al disco',
      };

      if (result.status === 0) {
        return {
          ...base,
          dir: 'blocked',
          keys: ['why'],
          text: 'No hubo respuesta: el backend no está en <code>' + escapeHtml(API_BASE.replace('/api/path-traversal-demo', '')) + '</code>. ¿Docker corriendo?',
        };
      }

      const data = result.data || {};

      if (data.ok === true && data.fueraDeBase) {
        return {
          ...base,
          dir: 'blocked',
          keys: ['vuln', 'why'],
          tag: 'escape de directorio',
          tagClass: 'danger',
          text:
            'La ruta resolvió a <code>' + escapeHtml(data.ruta) + '</code>: <strong style="color:var(--red,#ef4444)">quedó FUERA de ' +
            '<code>archivos-demo/</code></strong>. <code>path.join()</code> no valida nada, así que el <code>../</code> hizo efecto.',
        };
      }

      if (data.ok === true) {
        return {
          ...base,
          keys: mode === 'vulnerable' ? ['vuln'] : ['safe', 'check'],
          text:
            'La ruta resolvió a <code>' + escapeHtml(data.ruta) + '</code> — dentro de la carpeta permitida. ' +
            'El servidor abre el archivo con <code>fs.readFile()</code> y lo manda de vuelta.',
        };
      }

      if (data.code === 'ENTRADA_INVALIDA') {
        return {
          ...base,
          dir: 'response',
          keys: ['safe'],
          tag: 'entrada rechazada',
          tagClass: 'safe',
          text:
            'La validación frenó el input con <strong>400</strong> y <strong>nunca se abrió ningún archivo</strong>. ' +
            'La ruta que se habría formado (<code>' + escapeHtml(data.rutaEvitada || nombre) + '</code>) jamás llegó al disco.',
        };
      }

      if (data.code === 'NO_ENCONTRADO') {
        return {
          ...base,
          dir: 'response',
          keys: mode === 'vulnerable' ? ['vuln'] : ['safe', 'check'],
          tag: '404',
          tagClass: 'danger',
          text: 'La ruta estaba permitida pero no existe ningún archivo llamado <code>' + escapeHtml(nombre) + '</code>: responde <strong>404</strong>.',
        };
      }

      return {
        ...base,
        dir: 'response',
        keys: ['check', 'why'],
        tag: 'bloqueado',
        tagClass: 'danger',
        text:
          'El servidor se negó con <strong>' + result.status + '</strong>: <code>' + escapeHtml(data.error || 'error') + '</code> ' +
          '(el sandbox de esta demo sólo permite leer dentro de <code>backend/</code>).',
      };
    }

    function buildStep3(nombre, result) {
      const base = { from: 'disco', to: 'entrada', dir: 'response', file: 'path-traversal-demo.js' };
      const data = result.data || {};

      if (result.status === 0) {
        return {
          ...base,
          dir: 'blocked',
          keys: ['why'],
          tag: 'sin conexión',
          tagClass: 'danger',
          text: 'Sin respuesta del backend: levantalo con <code>cd backend && docker compose up -d</code> y volvé a probar.',
        };
      }

      if (data.ok === true && data.fueraDeBase) {
        return {
          ...base,
          dir: 'blocked',
          keys: ['vuln', 'why'],
          tag: '¡leak!',
          tagClass: 'danger',
          text:
            'El contenido del señuelo llegó al navegador. En un sistema real esa misma ruta podría ser ' +
            '<code>.env</code>, un backup o <code>/etc/passwd</code>: el ataque es idéntico, cambia el archivo.',
        };
      }

      if (data.ok === true) {
        return {
          ...base,
          keys: ['send'],
          tag: 'archivo servido',
          tagClass: 'safe',
          text: 'Respuesta <strong>200</strong> con el contenido de <code>' + escapeHtml(data.ruta) + '</code>: una lectura normal y esperada.',
        };
      }

      if (data.code === 'ENTRADA_INVALIDA') {
        return {
          ...base,
          dir: 'response',
          keys: ['safe', 'check'],
          tag: 'bloqueado',
          tagClass: 'safe',
          text:
            'El navegador recibe <strong>400 Entrada inválida</strong> con un error claro. ' +
            'Compará con el modo vulnerable: acá el <code>../</code> ni siquiera llegó a formarse como ruta.',
        };
      }

      if (data.code === 'NO_ENCONTRADO') {
        return {
          ...base,
          keys: ['send'],
          tag: '404',
          tagClass: 'danger',
          text: 'El servidor responde <strong>404</strong> y sugiere los archivos válidos de la demo.',
        };
      }

      return {
        ...base,
        keys: ['check', 'why'],
        tag: 'rechazado',
        tagClass: 'danger',
        text: 'La petición terminó en <strong>' + result.status + '</strong>: el archivo quedó fuera del alcance de esta demo.',
      };
    }

    function finish(nombre, result) {
      const data = result.data || {};
      const reqEl = document.getElementById('req-display');
      const pathEl = document.getElementById('path-display');
      const labelEl = document.getElementById('output-label');
      const fileEl = document.getElementById('file-display');
      const warnEl = document.getElementById('result-warning');

      if (resultZone) resultZone.style.display = 'block';

      if (reqEl) {
        reqEl.textContent = '/api/path-traversal-demo?archivo=' + nombre + '&mode=' + mode;
        reqEl.className = 'path-display';
      }

      if (result.status === 0) {
        if (pathEl) {
          pathEl.textContent = '—';
          pathEl.className = 'path-display';
        }
        if (labelEl) labelEl.textContent = 'Respuesta del servidor:';
        if (fileEl) {
          fileEl.textContent = 'Failed to fetch — sin respuesta de ' + API_BASE;
          fileEl.className = 'file-display error';
        }
        if (warnEl) {
          warnEl.style.display = 'block';
          warnEl.className = 'result-warning';
          warnEl.innerHTML = '<strong>Sin conexión con el backend.</strong> Abrí una terminal y ejecutá <code>cd backend && docker compose up -d</code>.';
        }
        sound.play('playAlert');
        setStatus('Sin conexión con el backend', 'danger');
        setExplain('error de conexión', 'danger',
          'No hubo respuesta de <code>' + escapeHtml(API_BASE) + '</code>. Esta parte no tiene nada que ver con path traversal: es que el servidor no está corriendo.');
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line danger';
          consoleLine.textContent = 'Sin respuesta del backend.';
        }
        return;
      }

      if (data.ok === true) {
        const escaped = !!data.fueraDeBase;
        if (pathEl) {
          pathEl.textContent = 'backend/' + data.ruta;
          pathEl.className = 'path-display' + (escaped ? ' escaped' : '');
        }
        if (labelEl) labelEl.textContent = 'Contenido del archivo:';
        if (fileEl) {
          fileEl.textContent = data.contenido;
          fileEl.className = 'file-display' + (escaped ? ' error' : '');
        }

        if (escaped) {
          if (warnEl) {
            warnEl.style.display = 'block';
            warnEl.className = 'result-warning danger';
            warnEl.innerHTML =
              '<strong>Path Traversal funcionó:</strong> se leyó un archivo fuera de <code>backend/archivos-demo/</code>. ' +
              'La ruta permitida era <code>archivos-demo/</code> y el resultado quedó en <code>backend/' + escapeHtml(data.ruta) + '</code>.';
          }
          sound.play('playBlocked');
          setStatus('Escape de directorio: archivo fuera de la base', 'danger');
          setExplain('¡escape de directorio!', 'danger',
            '<strong style="color:var(--red,#ef4444)">El payload salió de la carpeta permitida:</strong> <code>../secreto-simulado.txt</code> ' +
            'hizo que <code>path.join()</code> resolviera un nivel más arriba. El archivo señuelo es inofensivo, pero la técnica es la misma que ' +
            'se usa para leer <code>.env</code>, llaves o bases de datos. En modo <strong>seguro</strong> este mismo input ni llega al disco.');
          if (consoleLine) {
            consoleLine.style.display = 'block';
            consoleLine.className = 'console-line danger';
            consoleLine.textContent = '200 OK · backend/' + data.ruta + ' — fuera de archivos-demo/';
          }
        } else {
          if (warnEl) warnEl.style.display = 'none';
          sound.play('playSuccess');
          setStatus('Archivo leído', 'success');
          setExplain('archivo leído', 'safe',
            'Lectura normal: <code>' + escapeHtml(data.ruta) + '</code> está dentro de la carpeta permitida, así que el servidor la devuelve sin problema. ' +
            'Este es el único escenario que debería funcionar en ambos modos.');
          if (consoleLine) {
            consoleLine.style.display = 'block';
            consoleLine.className = 'console-line success';
            consoleLine.textContent = '200 OK · backend/' + data.ruta;
          }
        }
        return;
      }

      if (pathEl) {
        pathEl.textContent = data.ruta ? 'backend/' + data.ruta : data.rutaEvitada ? 'backend/' + data.rutaEvitada + ' (evitada)' : '—';
        pathEl.className = 'path-display';
      }
      if (labelEl) labelEl.textContent = 'Respuesta del servidor:';
      if (fileEl) {
        fileEl.textContent = data.error || 'Error desconocido';
        fileEl.className = 'file-display error';
      }

      if (data.code === 'ENTRADA_INVALIDA') {
        if (warnEl) {
          warnEl.style.display = 'block';
          warnEl.className = 'result-warning safe';
          warnEl.innerHTML = '<strong>Entrada rechazada antes de tocar el disco:</strong> nunca se abrió ningún archivo. La ruta que se habría formado era <code>backend/' + escapeHtml(data.rutaEvitada || nombre) + '</code>.';
        }
        sound.play('playSuccess');
        setStatus('Entrada inválida rechazada (400)', 'success');
        setExplain('entrada rechazada', 'safe',
          '<strong style="color:var(--green,#10b981)">La validación hizo su trabajo:</strong> el input contenía <code>..</code> y/o un separador de ruta, ' +
          'así que el servidor respondió <strong>400</strong> sin abrir nada. Fijate que el mensaje dice exactamente qué se rechazó y por qué.');
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line success';
          consoleLine.textContent = '400 · ' + data.error;
        }
        return;
      }

      if (data.code === 'NO_ENCONTRADO') {
        if (warnEl) {
          warnEl.style.display = 'block';
          warnEl.className = 'result-warning';
          warnEl.innerHTML = '<strong>Archivo inexistente:</strong> la ruta era válida pero no hay ningún <code>' + escapeHtml(nombre) + '</code> en la demo. Probá con <code>reporte.txt</code>, <code>notas.txt</code> o <code>presupuesto.txt</code>.';
        }
        sound.play('playAlert');
        setStatus('Archivo no encontrado (404)', 'pending');
        setExplain('404', 'danger',
          'El servidor resolvió la ruta sin problemas, pero no existe ese archivo en <code>backend/archivos-demo/</code>.');
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line danger';
          consoleLine.textContent = '404 · ' + data.error;
        }
        return;
      }

      if (warnEl) {
        warnEl.style.display = 'block';
        warnEl.className = 'result-warning danger';
        warnEl.innerHTML = '<strong>Bloqueado (' + result.status + '):</strong> ' + escapeHtml(data.error || 'ruta fuera del alcance de la demo');
      }
      sound.play('playBlocked');
      setStatus('Bloqueado (' + result.status + ')', 'danger');
      setExplain('bloqueado', 'danger',
        'Esta demo sólo permite leer dentro de <code>backend/</code> y nunca archivos ocultos (como <code>.env</code>): ' +
        'es un límite de la simulación, no la defensa de la lección. La defensa real está en resolver y validar la ruta.');
      if (consoleLine) {
        consoleLine.style.display = 'block';
        consoleLine.className = 'console-line danger';
        consoleLine.textContent = result.status + ' · ' + (data.error || 'bloqueado');
      }
    }

    function setExplain(tag, cls, html) {
      if (explainIdle) explainIdle.style.display = 'none';
      if (explainActive) explainActive.style.display = 'block';
      if (explainTag) {
        explainTag.textContent = tag;
        explainTag.className = 'explain-tag ' + cls;
      }
      if (explainText) explainText.innerHTML = html;
    }

    function runWith(value) {
      if (ptInput) ptInput.value = value;
      runFlow(value.trim());
    }

    btnVulnerable?.addEventListener('click', () => setMode('vulnerable'));
    btnSeguro?.addEventListener('click', () => setMode('seguro'));
    btnRead?.addEventListener('click', () => runFlow((ptInput?.value || '').trim()));
    ptInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') runFlow((ptInput.value || '').trim());
    });
    btnPresetReporte?.addEventListener('click', () => runWith('reporte.txt'));
    btnPresetNotas?.addEventListener('click', () => runWith('notas.txt'));
    btnPresetPayload?.addEventListener('click', () => runWith('../secreto-simulado.txt'));
    btnReset?.addEventListener('click', () => {
      if (running) return;
      resetAll();
    });

    setMode('vulnerable');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPathTraversalDemo);
  } else {
    setupPathTraversalDemo();
  }
})();
</script>

