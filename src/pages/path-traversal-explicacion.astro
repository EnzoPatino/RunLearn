  /* MODE SELECTOR */
  .mode-selector-card { display: flex; justify-content: space-between; align-items: center; background: var(--api-panel); border: 1px solid var(--api-border); border-radius: var(--radius-lg); padding: 1rem 1.4rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 14px; }
