---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RunLearn — Protección contra Bots y Rate Limiting">
  <div class="api-page">
    <div class="topbar">
      <div class="topbar-main">
        <a class="brand-link" href="/" aria-label="Volver al inicio de RunLearn">
          <span class="brand-mark">RL</span>
          <span>RunLearn</span>
        </a>
        <div class="crumbs" aria-label="Ruta actual">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <span class="current">Bots & Rate Limiting</span>
        </div>
      </div>
      <div class="topbar-actions">
        <a class="home-action" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10.8 9-7.2 9 7.2"/>
            <path d="M5.5 9.5V20h13V9.5"/>
            <path d="M9.5 20v-6h5v6"/>
          </svg>
          Inicio
        </a>
        <div class="badge-live"><span class="dot"></span>simulación interactiva</div>
      </div>
    </div>

    <h1>Protección del Servidor contra Bots</h1>
    <p class="lede">
      Un ataque de bots o fuerza bruta no requiere supercomputadoras: basta con un script que dispare cientos de peticiones por segundo. Compará en tiempo real cómo responde un servidor <strong>SIN protección</strong> (saturación y caída) versus <strong>CON rate limiting</strong> (bloqueo preventivo con código <code>HTTP 429</code>).
    </p>

    <!-- SELECTOR DE MODO (TOGGLE ARRIBA) -->
    <div class="mode-selector-card">
      <div class="mode-toggle-group">
        <button type="button" class="mode-btn active" id="btn-mode-unprotected" data-mode="unprotected">
          <span class="mode-icon">🔓</span>
          <div class="mode-btn-text">
            <span class="mode-name">Sin seguridad</span>
            <span class="mode-desc">Vulnerable a sobrecarga</span>
          </div>
        </button>

        <button type="button" class="mode-btn" id="btn-mode-protected" data-mode="protected">
          <span class="mode-icon">🛡️</span>
          <div class="mode-btn-text">
            <span class="mode-name">Con seguridad</span>
            <span class="mode-desc">Rate Limiting activo (máx 3 req/10s)</span>
          </div>
        </button>
      </div>

      <div class="mode-status-badge" id="mode-status-badge">
        <span class="mode-status-dot"></span>
        <span id="mode-status-text">Modo actual: Servidor expuesto sin límites</span>
      </div>
    </div>

    <!-- RESUMEN RÁPIDO: QUÉ ESTÁ POR VER -->
    <div class="overview-panel" id="overview-panel">
      <div class="overview-icon">⚡</div>
      <div class="overview-body">
        <p class="overview-text" id="overview-text">
          <strong>Sin protección:</strong> 6 bots envían peticiones al servidor sin límite. Sin control, lo saturan y se cae.
        </p>
        <p class="overview-rule" id="overview-rule">
          <strong>Con rate limiting:</strong> cada IP solo puede hacer 3 peticiones cada 10 segundos. Si pasa de ese cupo, el servidor la bloquea de inmediato con <code>HTTP 429</code> sin ni siquiera procesarla.
        </p>
      </div>
    </div>

    <!-- DIAGRAMA INTERACTIVO DE BOTS VS SERVIDOR -->
    <div class="diagram-card" id="diagram-container">
      <div class="diagram-stage">
        <!-- Columna de Bots -->
        <div class="bots-column" id="bots-column">
          <div class="bots-header">
            <span>Enjambre de Bots (6 agentes simulados)</span>
          </div>

          <div class="bots-list">
            <div class="bot-node" id="bot-0" data-ip="192.168.1.101">
              <div class="bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
                  <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
                </svg>
              </div>
              <div class="bot-info">
                <span class="bot-label">Bot #1</span>
                <span class="bot-ip">192.168.1.101</span>
              </div>
              <span class="bot-counter" id="bot-counter-0"></span>
              <span class="bot-status" id="bot-status-0">idle</span>
              <span class="bot-blocked-badge" id="bot-blocked-0">🚫 429</span>
            </div>

            <div class="bot-node" id="bot-1" data-ip="192.168.1.102">
              <div class="bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
                  <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
                </svg>
              </div>
              <div class="bot-info">
                <span class="bot-label">Bot #2</span>
                <span class="bot-ip">192.168.1.102</span>
              </div>
              <span class="bot-counter" id="bot-counter-1"></span>
              <span class="bot-status" id="bot-status-1">idle</span>
              <span class="bot-blocked-badge" id="bot-blocked-1">🚫 429</span>
            </div>

            <div class="bot-node" id="bot-2" data-ip="192.168.1.103">
              <div class="bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
                  <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
                </svg>
              </div>
              <div class="bot-info">
                <span class="bot-label">Bot #3</span>
                <span class="bot-ip">192.168.1.103</span>
              </div>
              <span class="bot-counter" id="bot-counter-2"></span>
              <span class="bot-status" id="bot-status-2">idle</span>
              <span class="bot-blocked-badge" id="bot-blocked-2">🚫 429</span>
            </div>

            <div class="bot-node" id="bot-3" data-ip="192.168.1.104">
              <div class="bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
                  <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
                </svg>
              </div>
              <div class="bot-info">
                <span class="bot-label">Bot #4</span>
                <span class="bot-ip">192.168.1.104</span>
              </div>
              <span class="bot-counter" id="bot-counter-3"></span>
              <span class="bot-status" id="bot-status-3">idle</span>
              <span class="bot-blocked-badge" id="bot-blocked-3">🚫 429</span>
            </div>

            <div class="bot-node" id="bot-4" data-ip="192.168.1.105">
              <div class="bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
                  <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
                </svg>
              </div>
              <div class="bot-info">
                <span class="bot-label">Bot #5</span>
                <span class="bot-ip">192.168.1.105</span>
              </div>
              <span class="bot-counter" id="bot-counter-4"></span>
              <span class="bot-status" id="bot-status-4">idle</span>
              <span class="bot-blocked-badge" id="bot-blocked-4">🚫 429</span>
            </div>

            <div class="bot-node" id="bot-5" data-ip="192.168.1.106">
              <div class="bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
                  <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
                </svg>
              </div>
              <div class="bot-info">
                <span class="bot-label">Bot #6</span>
                <span class="bot-ip">192.168.1.106</span>
              </div>
              <span class="bot-counter" id="bot-counter-5"></span>
              <span class="bot-status" id="bot-status-5">idle</span>
              <span class="bot-blocked-badge" id="bot-blocked-5">🚫 429</span>
            </div>
          </div>
        </div>

        <!-- Zona media: Canal de tráfico / Barrera de Firewall -->
        <div class="traffic-channel" id="traffic-channel">
          <div class="channel-track"></div>
          
          <div class="firewall-barrier" id="firewall-barrier">
            <div class="barrier-shield">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <span class="barrier-title">Rate Limiter</span>
            <span class="barrier-rule">Ventana: 10s · Máx: 3 req</span>
          </div>

          <!-- Contenedor dinámico de partículas de tráfico -->
          <div class="packets-layer" id="packets-layer"></div>
        </div>

        <!-- Columna Servidor -->
        <div class="server-column">
          <div class="server-node" id="server-target-node">
            <div class="server-top-header">
              <div class="server-title-group">
                <span class="server-badge">Node.js / Express</span>
                <h3 class="server-name">Servidor Web (:5000)</h3>
              </div>
              <div class="server-health-chip" id="server-health-chip">
                <span class="health-dot"></span>
                <span id="server-health-text">200 OK · Saludable</span>
              </div>
            </div>

            <div class="server-metrics-box">
              <div class="server-metric-item">
                <div class="metric-label-row">
                  <span>Carga de CPU:</span>
                  <strong id="metric-cpu-val">12%</strong>
                </div>
                <div class="metric-bar-bg">
                  <div class="metric-bar-fill" id="metric-cpu-bar" style="width: 12%"></div>
                </div>
              </div>

              <div class="server-metric-item">
                <div class="metric-label-row">
                  <span>Event Loop Lag:</span>
                  <strong id="metric-lag-val">1.2 ms</strong>
                </div>
                <div class="metric-bar-bg">
                  <div class="metric-bar-fill" id="metric-lag-bar" style="width: 8%"></div>
                </div>
              </div>

              <div class="server-stats-row">
                <div class="stat-pill">
                  <span class="stat-label">Peticiones procesadas:</span>
                  <strong id="stat-processed">0</strong>
                </div>
                <div class="stat-pill">
                  <span class="stat-label">Bloqueadas (429):</span>
                  <strong id="stat-blocked">0</strong>
                </div>
              </div>
            </div>

            <div class="server-alert-box" id="server-alert-box" style="display:none">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <div id="server-alert-msg">¡Servidor saturado! CPU 100% y peticiones colgadas.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CONTROLES -->
    <div class="controls">
      <div class="controls-left">
        <button class="primary" id="btn-run-sim">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Simular ráfaga de bots
        </button>
        <button class="ghost" id="btn-reset-sim">Reiniciar</button>
        <button class="sound-btn" id="btn-toggle-sound" title="Alternar efectos sonoros">
          <span id="sound-icon">🔊</span>
          <span id="sound-text">Sonido activo</span>
        </button>
      </div>

      <div class="controls-left">
        <div class="sim-phase-badge" id="sim-phase-badge">Esperando inicio</div>
      </div>
    </div>

    <!-- RESUMEN FINAL DE LA SIMULACIÓN -->
    <div class="summary-panel" id="summary-panel" style="display:none">
      <div class="summary-header">
        <span class="summary-title" id="summary-title">Resumen de la simulación</span>
      </div>
      <div class="summary-grid">
        <div class="summary-cell">
          <span class="summary-cell-label">Servidor</span>
          <span class="summary-cell-value" id="summary-server-state">—</span>
        </div>
        <div class="summary-cell">
          <span class="summary-cell-label">Peticiones procesadas</span>
          <span class="summary-cell-value" id="summary-processed">0</span>
        </div>
        <div class="summary-cell">
          <span class="summary-cell-label">Bloqueadas (429)</span>
          <span class="summary-cell-value" id="summary-blocked">0</span>
        </div>
        <div class="summary-cell">
          <span class="summary-cell-label">Bots bloqueados</span>
          <span class="summary-cell-value" id="summary-bots-blocked">0 / 6</span>
        </div>
      </div>
    </div>

    <!-- SPLIT: CÓDIGO DEL MIDDLEWARE VS EXPLICACIÓN -->
    <div class="split">
      <div class="panel">
        <div class="panel-head">
          <span class="title">Código del Middleware</span>
          <span class="filename" id="code-filename">middleware/rateLimit.js</span>
        </div>

        <pre class="code" id="code-view"><span class="line" data-key="import"><span class="kw">import</span> rateLimit <span class="kw">from</span> <span class="str">'express-rate-limit'</span>;</span>
<span class="line" data-key="config"><span class="comment">// Configuración del limitador por IP</span></span>
<span class="line" data-key="config"><span class="kw">const</span> botLimiter = rateLimit(&#123;</span>
<span class="line" data-key="window">  windowMs: <span class="num">10 * 1000</span>, <span class="comment">// Ventana de 10 segundos</span></span>
<span class="line" data-key="max">  max: <span class="num">3</span>,             <span class="comment">// Máximo 3 peticiones por IP</span></span>
<span class="line" data-key="handler">  standardHeaders: <span class="kw">true</span>,</span>
<span class="line" data-key="handler">  legacyHeaders: <span class="kw">false</span>,</span>
<span class="line" data-key="handler">  message: &#123;</span>
<span class="line" data-key="handler">    error: <span class="str">'Demasiadas peticiones. Intenta más tarde.'</span>,</span>
<span class="line" data-key="handler">    code: <span class="num">429</span></span>
<span class="line" data-key="handler">  &#125;</span>
<span class="line" data-key="config">&#125;);</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="apply"><span class="comment">// Aplicar en las rutas sensibles</span></span>
<span class="line" data-key="apply"><span class="kw">app</span>.use(<span class="str">'/api/'</span>, botLimiter);</span></pre>
      </div>

      <div class="panel">
        <div class="panel-head">
          <span class="title">Qué está pasando en el sistema</span>
        </div>
        <div class="explain-body">
          <div id="explain-idle" class="explain-idle">
            Seleccioná un modo con el switch superior y tocá <strong>«Simular ráfaga de bots»</strong>. Vas a ver la diferencia entre recibir tráfico abusivo sin protección versus filtrar en la puerta de entrada con Rate Limiting.
          </div>

          <div id="explain-active" style="display:none">
            <div class="explain-tag" id="explain-tag">fase de simulación</div>
            <div class="explain-text" id="explain-text"></div>
          </div>

          <div class="console-line" id="console-line" style="display:none"></div>

          <div class="concepts-grid">
            <div class="concept-item">
              <div class="concept-icon">⏱️</div>
              <div>
                <strong>¿Qué es Rate Limiting?</strong> Es una técnica que cuenta cuántas peticiones realiza una misma dirección IP dentro de una ventana de tiempo (ej. 10s). Si excede el cupo, responde de inmediato con <code>HTTP 429 Too Many Requests</code> sin gastar CPU ni tocar la base de datos.
              </div>
            </div>

            <div class="concept-item">
              <div class="concept-icon">💥</div>
              <div>
                <strong>¿Por qué se cae sin protección?</strong> Cada petición no controlada consume memoria, abre sockets y ocupa un turno en el Event Loop. Si un atacante dispara cientos de peticiones, el servidor agota sus recursos y los usuarios legítimos quedan sin servicio.
              </div>
            </div>

            <div class="concept-item">
              <div class="concept-icon">🛡️</div>
              <div>
                <strong>Otras defensas en la industria:</strong>
                <ul class="defenses-list">
                  <li><strong>CAPTCHA:</strong> Desafíos (Cloudflare Turnstile, reCAPTCHA) ante picos sospechosos.</li>
                  <li><strong>Bloqueo por IP / Reputación:</strong> Listas negras automáticas para atacantes reincidentes.</li>
                  <li><strong>WAF (Web Application Firewall):</strong> Filtrado perimetral previo a nivel DNS/Cloud (Cloudflare, AWS WAF).</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
import { initSoundControls } from '../lib/soundControls.js';

(function () {
  let mode = 'unprotected'; // 'unprotected' | 'protected'
  let simulating = false;
  const sound = initSoundControls();

  const btnUnprotected = document.getElementById('btn-mode-unprotected');
  const btnProtected = document.getElementById('btn-mode-protected');
  const modeStatusBadge = document.getElementById('mode-status-badge');
  const modeStatusText = document.getElementById('mode-status-text');
  const firewallBarrier = document.getElementById('firewall-barrier');
  const packetsLayer = document.getElementById('packets-layer');

  const btnRunSim = document.getElementById('btn-run-sim');
  const btnResetSim = document.getElementById('btn-reset-sim');
  const simPhaseBadge = document.getElementById('sim-phase-badge');

  const serverTargetNode = document.getElementById('server-target-node');
  const serverHealthChip = document.getElementById('server-health-chip');
  const serverHealthText = document.getElementById('server-health-text');
  const metricCpuVal = document.getElementById('metric-cpu-val');
  const metricCpuBar = document.getElementById('metric-cpu-bar');
  const metricLagVal = document.getElementById('metric-lag-val');
  const metricLagBar = document.getElementById('metric-lag-bar');
  const statProcessed = document.getElementById('stat-processed');
  const statBlocked = document.getElementById('stat-blocked');
  const serverAlertBox = document.getElementById('server-alert-box');
  const serverAlertMsg = document.getElementById('server-alert-msg');

  const explainIdle = document.getElementById('explain-idle');
  const explainActive = document.getElementById('explain-active');
  const explainTag = document.getElementById('explain-tag');
  const explainText = document.getElementById('explain-text');
  const consoleLine = document.getElementById('console-line');
  const codeLines = document.querySelectorAll('.line');

  const overviewText = document.getElementById('overview-text');
  const overviewRule = document.getElementById('overview-rule');
  const summaryPanel = document.getElementById('summary-panel');
  const summaryTitle = document.getElementById('summary-title');
  const summaryServerState = document.getElementById('summary-server-state');
  const summaryProcessed = document.getElementById('summary-processed');
  const summaryBlocked = document.getElementById('summary-blocked');
  const summaryBotsBlocked = document.getElementById('summary-bots-blocked');
  const botCounters = Array.from({ length: 6 }, (_, i) => document.getElementById(`bot-counter-${i}`));
  const botBlockedBadges = Array.from({ length: 6 }, (_, i) => document.getElementById(`bot-blocked-${i}`));

  function safePlay(fnName: 'playStep' | 'playBlocked' | 'playSuccess' | 'playAlert') {
    sound.play(fnName);
  }

  // Cambio de Modo
  function setMode(newMode: 'unprotected' | 'protected') {
    if (simulating) return;
    mode = newMode;

    if (mode === 'unprotected') {
      btnUnprotected?.classList.add('active');
      btnProtected?.classList.remove('active');
      if (modeStatusBadge) modeStatusBadge.className = 'mode-status-badge danger';
      if (modeStatusText) modeStatusText.textContent = 'Modo actual: Servidor expuesto sin rate limiting';
      if (firewallBarrier) firewallBarrier.classList.remove('active');
      if (overviewText) overviewText.innerHTML = '<strong>Sin protección:</strong> 6 bots envían peticiones al servidor sin límite. Sin control, lo saturan y se cae.';
      if (overviewRule) overviewRule.innerHTML = '<strong>Lo que vas a ver:</strong> cada bot dispara varias peticiones concurrentes. El servidor las acepta todas, el CPU se dispara al 100% y los usuarios reales quedan fuera.';
    } else {
      btnProtected?.classList.add('active');
      btnUnprotected?.classList.remove('active');
      if (modeStatusBadge) modeStatusBadge.className = 'mode-status-badge safe';
      if (modeStatusText) modeStatusText.textContent = 'Modo actual: Rate Limiting activo (máx 3 peticiones / 10s)';
      if (firewallBarrier) firewallBarrier.classList.add('active');
      if (overviewText) overviewText.innerHTML = '<strong>Con rate limiting:</strong> cada IP solo puede hacer 3 peticiones cada 10 segundos. Si pasa de ese cupo, el servidor la bloquea de inmediato con <code>HTTP 429</code> sin ni siquiera procesarla.';
      if (overviewRule) overviewRule.innerHTML = '<strong>Lo que vas a ver:</strong> los primeros 3 bots pasan sus peticiones legítimas. Los demás y los reintentos son rechazados en la puerta de entrada, antes de tocar la base de datos.';
    }

    resetSimulation();
  }

  btnUnprotected?.addEventListener('click', () => setMode('unprotected'));
  btnProtected?.addEventListener('click', () => setMode('protected'));

  function highlightCode(key: string) {
    codeLines.forEach(line => {
      const k = line.getAttribute('data-key');
      if (k === key) {
        line.classList.add('active');
      } else {
        line.classList.remove('active');
      }
    });
  }

  function resetSimulation() {
    simulating = false;
    if (btnRunSim) {
      btnRunSim.removeAttribute('disabled');
      btnRunSim.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px"><polygon points="5 3 19 12 5 21 5 3"/></svg> Simular ráfaga de bots`;
    }

    if (packetsLayer) packetsLayer.innerHTML = '';
    if (simPhaseBadge) {
      simPhaseBadge.textContent = 'Esperando inicio';
      simPhaseBadge.className = 'sim-phase-badge';
    }

    // Reset bots visuales
    for (let i = 0; i < 6; i++) {
      const bNode = document.getElementById(`bot-${i}`);
      const bStatus = document.getElementById(`bot-status-${i}`);
      if (bNode) bNode.className = 'bot-node';
      if (bStatus) {
        bStatus.textContent = 'idle';
        bStatus.className = 'bot-status';
      }
      if (botCounters[i]) {
        botCounters[i].textContent = '';
        botCounters[i].className = 'bot-counter';
      }
      if (botBlockedBadges[i]) {
        botBlockedBadges[i].classList.remove('visible');
      }
    }

    // Reset servidor
    if (serverTargetNode) serverTargetNode.className = 'server-node';
    if (serverHealthChip) serverHealthChip.className = 'server-health-chip healthy';
    if (serverHealthText) serverHealthText.textContent = '200 OK · Saludable';
    if (metricCpuVal) metricCpuVal.textContent = '12%';
    if (metricCpuBar) {
      metricCpuBar.style.width = '12%';
      metricCpuBar.className = 'metric-bar-fill';
    }
    if (metricLagVal) metricLagVal.textContent = '1.2 ms';
    if (metricLagBar) {
      metricLagBar.style.width = '8%';
      metricLagBar.className = 'metric-bar-fill';
    }
    if (statProcessed) statProcessed.textContent = '0';
    if (statBlocked) statBlocked.textContent = '0';
    if (serverAlertBox) serverAlertBox.style.display = 'none';

    // Reset summary
    if (summaryPanel) summaryPanel.style.display = 'none';

    // Reset explicación
    if (explainIdle) explainIdle.style.display = 'block';
    if (explainActive) explainActive.style.display = 'none';
    if (consoleLine) consoleLine.style.display = 'none';
    codeLines.forEach(l => l.classList.remove('active'));
  }

  btnResetSim?.addEventListener('click', resetSimulation);

  // Crear partícula de petición en el canal
  function launchPacket(botIndex: number, outcome: 'success' | 'blocked' | 'crashed', delayMs: number) {
    setTimeout(() => {
      if (!simulating) return;
      const bNode = document.getElementById(`bot-${botIndex}`);
      if (!bNode || !packetsLayer) return;

      const p = document.createElement('div');
      p.className = `traffic-packet ${outcome === 'blocked' ? 'blocked' : outcome === 'crashed' ? 'crashed' : 'ok'}`;
      
      // Posición vertical según el bot
      const topPct = 8 + botIndex * 15;
      p.style.top = `${topPct}%`;
      p.style.left = '4%';
      packetsLayer.appendChild(p);

      safePlay(outcome === 'blocked' ? 'playBlocked' : 'playStep');

      // Animación de viaje
      requestAnimationFrame(() => {
        p.style.opacity = '1';
        if (outcome === 'blocked') {
          // Llega hasta la barrera del firewall (48%) y rebota/desaparece
          p.style.left = '48%';
          setTimeout(() => {
            p.classList.add('deflected');
            setTimeout(() => p.remove(), 400);
          }, 600);
        } else {
          // Cruza hasta el servidor (92%)
          p.style.left = '92%';
          setTimeout(() => {
            p.remove();
          }, 750);
        }
      });
    }, delayMs);
  }

  // Ejecución de la simulación
  function runSimulation() {
    if (simulating) return;
    simulating = true;
    if (btnRunSim) {
      btnRunSim.setAttribute('disabled', 'true');
      btnRunSim.textContent = 'Simulando ráfaga...';
    }

    if (explainIdle) explainIdle.style.display = 'none';
    if (explainActive) explainActive.style.display = 'block';

    if (mode === 'unprotected') {
      runUnprotectedSequence();
    } else {
      runProtectedSequence();
    }
  }

  btnRunSim?.addEventListener('click', runSimulation);

  // -------------------------------------------------------------
  // SECUENCIA MODO SIN PROTECCIÓN
  // -------------------------------------------------------------
  function runUnprotectedSequence() {
    highlightCode('apply');
    if (simPhaseBadge) {
      simPhaseBadge.textContent = 'Paso 1/3: Ráfaga inicial masiva';
      simPhaseBadge.className = 'sim-phase-badge danger';
    }
    if (explainTag) explainTag.textContent = 'Ataque en progreso';
    if (explainText) {
      explainText.innerHTML = 'Los 6 bots disparan peticiones concurrentes simultáneas al servidor. Al <strong>no existir límite por IP</strong>, cada petición es aceptada directamente en memoria.';
    }

    let processedCount = 0;

    // Onda 1 de bots
    for (let i = 0; i < 6; i++) {
      const bot = document.getElementById(`bot-${i}`);
      const bStatus = document.getElementById(`bot-status-${i}`);
      if (bot) bot.classList.add('attacking');
      if (bStatus) {
        bStatus.textContent = 'enviando...';
        bStatus.className = 'bot-status attacking';
      }
      if (botCounters[i]) botCounters[i].textContent = 'req 1';
      launchPacket(i, 'crashed', i * 150);
    }

    // Paso 2: Servidor empieza a saturarse
    setTimeout(() => {
      if (!simulating) return;
      highlightCode('apply');
      processedCount = 18;
      if (statProcessed) statProcessed.textContent = String(processedCount);
      if (metricCpuVal) metricCpuVal.textContent = '68%';
      if (metricCpuBar) {
        metricCpuBar.style.width = '68%';
        metricCpuBar.className = 'metric-bar-fill warn';
      }
      if (metricLagVal) metricLagVal.textContent = '48.5 ms';
      if (metricLagBar) {
        metricLagBar.style.width = '55%';
        metricLagBar.className = 'metric-bar-fill warn';
      }

      if (serverHealthChip) serverHealthChip.className = 'server-health-chip warning';
      if (serverHealthText) serverHealthText.textContent = 'Degradado · Alto consumo';

      if (simPhaseBadge) simPhaseBadge.textContent = 'Paso 2/3: Event Loop saturado';
      if (explainText) {
        explainText.innerHTML = 'El CPU sube a 68% y el lag del Event Loop se dispara. El servidor intenta procesar todos los requests simultáneamente sin filtrar ninguno.';
      }

      for (let i = 0; i < 6; i++) {
        if (botCounters[i]) botCounters[i].textContent = 'req 2+';
        launchPacket(i, 'crashed', i * 120);
      }
    }, 1800);

    // Paso 3: Colapso total del servidor
    setTimeout(() => {
      if (!simulating) return;
      processedCount = 42;
      if (statProcessed) statProcessed.textContent = String(processedCount);
      if (metricCpuVal) metricCpuVal.textContent = '100%';
      if (metricCpuBar) {
        metricCpuBar.style.width = '100%';
        metricCpuBar.className = 'metric-bar-fill danger';
      }
      if (metricLagVal) metricLagVal.textContent = '5200 ms (Timeout)';
      if (metricLagBar) {
        metricLagBar.style.width = '100%';
        metricLagBar.className = 'metric-bar-fill danger';
      }

      if (serverTargetNode) serverTargetNode.classList.add('crashed');
      if (serverHealthChip) serverHealthChip.className = 'server-health-chip danger';
      if (serverHealthText) serverHealthText.textContent = '503 Service Unavailable';
      if (serverAlertBox) {
        serverAlertBox.style.display = 'flex';
        if (serverAlertMsg) serverAlertMsg.textContent = '¡Servidor caído! El proceso no responde y agota el pool de conexiones.';
      }

      for (let i = 0; i < 6; i++) {
        const bStatus = document.getElementById(`bot-status-${i}`);
        if (bStatus) {
          bStatus.textContent = 'saturó servidor';
          bStatus.className = 'bot-status success';
        }
        if (botCounters[i]) botCounters[i].textContent = 'múltiples';
      }

      if (simPhaseBadge) simPhaseBadge.textContent = 'Resultado: Servidor caído';
      if (explainTag) explainTag.textContent = 'Colapso total';
      if (explainText) {
        explainText.innerHTML = '<strong style="color:var(--red,#ef4444)">Servidor colapsado:</strong> Sin rate limiting, un puñado de scripts puede tumbar la aplicación. Cualquier usuario real que intente entrar en este momento recibe pantalla de error o timeout infinito.';
      }

      if (consoleLine) {
        consoleLine.style.display = 'block';
        consoleLine.className = 'console-line danger';
        consoleLine.innerHTML = '[FATAL]: Event loop blocked &gt; 5000ms. Error 503 / 504 Gateway Timeout. Servidor sin respuesta.';
      }

      // Show summary
      if (summaryPanel) summaryPanel.style.display = 'block';
      if (summaryTitle) summaryTitle.textContent = 'Resumen: Sin protección';
      if (summaryServerState) {
        summaryServerState.textContent = 'CAÍDO (503)';
        summaryServerState.className = 'summary-cell-value danger';
      }
      if (summaryProcessed) summaryProcessed.textContent = '42';
      if (summaryBlocked) summaryBlocked.textContent = '0';
      if (summaryBotsBlocked) summaryBotsBlocked.textContent = '0 / 6';

      safePlay('playAlert');

      if (btnRunSim) {
        btnRunSim.removeAttribute('disabled');
        btnRunSim.textContent = 'Simulación finalizada';
      }
    }, 3800);
  }

  // -------------------------------------------------------------
  // SECUENCIA MODO CON SEGURIDAD (RATE LIMITING)
  // -------------------------------------------------------------
  function runProtectedSequence() {
    highlightCode('config');
    if (simPhaseBadge) {
      simPhaseBadge.textContent = 'Paso 1/3: Inspección de ventana';
      simPhaseBadge.className = 'sim-phase-badge safe';
    }
    if (explainTag) explainTag.textContent = 'Protección activa';
    if (explainText) {
      explainText.innerHTML = 'Los bots inician la ráfaga. El middleware <code>botLimiter</code> intercepta cada petición y cuenta cuántas peticiones ha hecho cada IP en los últimos 10 segundos.';
    }

    let processed = 0;
    let blocked = 0;

    // Ráfaga: los primeros 3 bots reciben paso legítimo (3 requests acumulados de prueba), los siguientes 3 y reintentos son bloqueados
    for (let i = 0; i < 6; i++) {
      const isBlocked = i >= 3;
      const bot = document.getElementById(`bot-${i}`);
      const bStatus = document.getElementById(`bot-status-${i}`);
      if (bot) bot.classList.add(isBlocked ? 'blocked' : 'attacking');
      if (bStatus) {
        bStatus.textContent = isBlocked ? 'esperando...' : 'req 1/3';
        bStatus.className = `bot-status ${isBlocked ? 'blocked' : 'attacking'}`;
      }
      if (botCounters[i]) botCounters[i].textContent = isBlocked ? '' : 'req 1/3';
      if (isBlocked && botBlockedBadges[i]) botBlockedBadges[i].classList.add('visible');
      launchPacket(i, isBlocked ? 'blocked' : 'ok', i * 160);
    }

    // Paso 2: Intercepción con HTTP 429
    setTimeout(() => {
      if (!simulating) return;
      highlightCode('window');
      processed = 3;
      blocked = 3;
      if (statProcessed) statProcessed.textContent = String(processed);
      if (statBlocked) statBlocked.textContent = String(blocked);

      if (metricCpuVal) metricCpuVal.textContent = '18%';
      if (metricCpuBar) {
        metricCpuBar.style.width = '18%';
        metricCpuBar.className = 'metric-bar-fill';
      }
      if (metricLagVal) metricLagVal.textContent = '1.8 ms';
      if (metricLagBar) {
        metricLagBar.style.width = '10%';
        metricLagBar.className = 'metric-bar-fill';
      }

      if (simPhaseBadge) simPhaseBadge.textContent = 'Paso 2/3: Límite alcanzado';
      if (explainText) {
        explainText.innerHTML = 'La regla <code>max: 3</code> se activa. Las IPs que exceden 3 peticiones son repelidas de inmediato con <strong>HTTP 429 Too Many Requests</strong> en el perímetro sin entrar a la aplicación.';
      }

      // Segunda oleada: todos son bloqueados al haber alcanzado el cupo
      for (let i = 0; i < 6; i++) {
        const bStatus = document.getElementById(`bot-status-${i}`);
        if (bStatus) {
          bStatus.textContent = '429 Bloqueado';
          bStatus.className = 'bot-status blocked';
        }
        if (botCounters[i]) botCounters[i].textContent = 'req 2+';
        if (botBlockedBadges[i]) botBlockedBadges[i].classList.add('visible');
        launchPacket(i, 'blocked', i * 140);
      }
    }, 2000);

    // Paso 3: Servidor completamente estable
    setTimeout(() => {
      if (!simulating) return;
      highlightCode('handler');
      blocked = 9;
      if (statBlocked) statBlocked.textContent = String(blocked);

      if (metricCpuVal) metricCpuVal.textContent = '15%';
      if (metricCpuBar) {
        metricCpuBar.style.width = '15%';
        metricCpuBar.className = 'metric-bar-fill';
      }
      if (metricLagVal) metricLagVal.textContent = '1.4 ms';

      if (serverTargetNode) serverTargetNode.className = 'server-node protected-success';
      if (serverHealthChip) serverHealthChip.className = 'server-health-chip healthy';
      if (serverHealthText) serverHealthText.textContent = '200 OK · Protegido';

      if (simPhaseBadge) simPhaseBadge.textContent = 'Resultado: Ataque mitigado';
      if (explainTag) explainTag.textContent = 'Ataque neutralizado';
      if (explainText) {
        explainText.innerHTML = '<strong style="color:var(--green,#10b981)">Servidor 100% estable:</strong> El middleware descartó los paquetes antes de ejecutar lógica pesada. El CPU se mantuvo en 15% y los usuarios legítimos pueden navegar sin notar el ataque.';
      }

      if (consoleLine) {
        consoleLine.style.display = 'block';
        consoleLine.className = 'console-line success';
        consoleLine.innerHTML = '[RateLimit]: IP 192.168.1.104 excedió máx requests. Respondiendo 429 Too Many Requests (Retry-After: 10s). Servidor a salvo.';
      }

      // Show summary
      if (summaryPanel) summaryPanel.style.display = 'block';
      if (summaryTitle) summaryTitle.textContent = 'Resumen: Con Rate Limiting';
      if (summaryServerState) {
        summaryServerState.textContent = 'ESTABLE (200)';
        summaryServerState.className = 'summary-cell-value safe';
      }
      if (summaryProcessed) summaryProcessed.textContent = '3';
      if (summaryBlocked) summaryBlocked.textContent = '9';
      if (summaryBotsBlocked) summaryBotsBlocked.textContent = '6 / 6';

      safePlay('playSuccess');

      if (btnRunSim) {
        btnRunSim.removeAttribute('disabled');
        btnRunSim.textContent = 'Simulación finalizada';
      }
    }, 4000);
  }

  // Inicialización
  setMode('unprotected');
})();
</script>

