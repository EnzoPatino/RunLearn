---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Crear Cuenta – DevPlatform">
  <div class="login-wrapper">
    <div class="login-card">
      <h1 class="login-title">Crear Cuenta</h1>
      <p class="login-subtitle">Registrate para acceder a tu dashboard</p>

      <form id="registerForm" class="login-form" novalidate>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" placeholder="tu@email.com" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" placeholder="Mínimo 8 caracteres" required minlength="8" autocomplete="new-password" />
        </div>
        <div class="field">
          <label for="passwordConfirm">Confirmar contraseña</label>
          <input id="passwordConfirm" name="passwordConfirm" type="password" placeholder="Repetí tu contraseña" required minlength="8" autocomplete="new-password" />
        </div>

        <div id="errorMsg" class="error" hidden></div>
        <div id="successMsg" class="success" role="status" aria-live="polite" hidden></div>

        <button type="submit" class="btn-login">Crear cuenta</button>
      </form>

      <p class="login-switch">
        ¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  .login-wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .login-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-white);
    text-align: center;
    letter-spacing: -0.02em;
  }

  .login-subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field input {
    background: var(--surface-inset);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-family: var(--font-main);
    font-size: 0.95rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field input:focus {
    border-color: var(--brand-blue);
    box-shadow: 0 0 0 3px var(--brand-blue-glow);
  }

  .field input::placeholder {
    color: var(--text-muted);
  }

  .error {
    background: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #f43f5e;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    text-align: center;
  }

  .success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #86efac;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    text-align: center;
  }

  .btn-login {
    background: var(--brand-blue);
    color: var(--text-white);
    font-family: var(--font-main);
    font-size: 0.95rem;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    padding: 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
    margin-top: 0.25rem;
  }

  .btn-login:hover {
    background: #2563eb;
    box-shadow: 0 0 20px var(--brand-blue-glow);
  }

  .btn-login:active {
    transform: scale(0.98);
  }

  .btn-login:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .login-switch {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-align: center;
    margin-top: -0.5rem;
  }

  .login-switch a {
    color: var(--brand-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .login-switch a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  import { getSupabaseAuthError, isSupabaseConfigured, supabase } from '../lib/supabaseClient.js';

  function setupRegisterForm() {
    const form = document.getElementById('registerForm') as HTMLFormElement | null;
    const errorMsg = document.getElementById('errorMsg');
    const successMsg = document.getElementById('successMsg');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    function showError(message: string) {
      if (!errorMsg) return;
      errorMsg.textContent = message;
      errorMsg.hidden = false;
    }

    function showSuccess(message: string) {
      if (!successMsg) return;
      successMsg.textContent = message;
      successMsg.hidden = false;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorMsg) {
        errorMsg.hidden = true;
        errorMsg.textContent = '';
      }
      if (successMsg) {
        successMsg.hidden = true;
        successMsg.textContent = '';
      }

      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const passwordInput = document.getElementById('password') as HTMLInputElement | null;
      const confirmInput = document.getElementById('passwordConfirm') as HTMLInputElement | null;
      const email = emailInput?.value.trim() || '';
      const password = passwordInput?.value || '';
      const passwordConfirm = confirmInput?.value || '';

      if (!email || !password || !passwordConfirm) {
        showError('Completá todos los campos.');
        return;
      }

      if (password !== passwordConfirm) {
        showError('Las contraseñas no coinciden.');
        return;
      }

      const btn = form.querySelector('.btn-login') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Creando cuenta...';
      }

      try {
        if (!isSupabaseConfigured || !supabase) {
          throw new Error('Falta configurar PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY.');
        }

        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: { emailRedirectTo: window.location.origin },
        });
        if (error) throw error;

        if (data.session) {
          window.dispatchEvent(new CustomEvent('auth-change'));
          window.location.href = '/';
          return;
        }

        showSuccess('Cuenta creada. Revisá tu correo para confirmar la dirección antes de iniciar sesión.');
      } catch (err) {
        showError(getSupabaseAuthError(err, 'No se pudo crear la cuenta.'));
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Crear cuenta';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRegisterForm);
  } else {
    setupRegisterForm();
  }

  document.addEventListener('astro:page-load', setupRegisterForm);
</script>
