---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RunLearn — CSRF (Cross-Site Request Forgery)">
  <div class="api-page">
    <div class="topbar">
      <div class="topbar-main">
        <a class="brand-link" href="/" aria-label="Volver al inicio de RunLearn">
          <span class="brand-mark">RL</span>
          <span>RunLearn</span>
        </a>
        <div class="crumbs" aria-label="Ruta actual">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <span class="current">CSRF</span>
        </div>
      </div>
      <div class="topbar-actions">
        <button class="sound-btn" id="btn-toggle-sound" type="button" aria-pressed="false">
          <span id="sound-icon" aria-hidden="true">🔊</span>
          <span id="sound-text">Sonido activo</span>
        </button>
        <a class="home-action" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10.8 9-7.2 9 7.2"/>
            <path d="M5.5 9.5V20h13V9.5"/>
            <path d="M9.5 20v-6h5v6"/>
          </svg>
          Inicio
        </a>
        <div class="badge-live"><span class="dot"></span>módulo interactivo</div>
      </div>
    </div>

    <h1>CSRF (Cross-Site Request Forgery)</h1>
    <p class="lede">
      Un ataque CSRF engaña a tu navegador para que envíe una petición legítima a un sitio donde estás logueado, <strong>sin tu consentimiento</strong>. El sitio malicioso no roba credenciales — simplemente aprovecha que el navegador adjunta las cookies automáticamente.
    </p>

    <!-- MODE SELECTOR -->
    <div class="mode-selector-card">
      <div class="mode-toggle-group">
        <button type="button" class="mode-btn active" id="btn-mode-vulnerable" data-mode="vulnerable">
          <span class="mode-icon">🔓</span>
          <div class="mode-btn-text">
            <span class="mode-name">Sin protección CSRF</span>
            <span class="mode-desc">Solo valida la cookie de sesión</span>
          </div>
        </button>
        <button type="button" class="mode-btn" id="btn-mode-secure" data-mode="secure">
          <span class="mode-icon">🛡️</span>
          <div class="mode-btn-text">
            <span class="mode-name">Con token CSRF</span>
            <span class="mode-desc">Requiere token Synchronizer Pattern</span>
          </div>
        </button>
      </div>
      <div class="mode-status-badge" id="mode-status-badge">
        <span class="mode-status-dot"></span>
        <span id="mode-status-text">VULNERABLE — solo cookie de sesión</span>
      </div>
    </div>

    <!-- SETUP -->
    <div class="setup-card" id="setup-card">
      <div class="setup-header">
        <span class="setup-icon">🏦</span>
        <span class="setup-title">Paso 1: Iniciar sesión en el banco</span>
      </div>
      <p class="setup-text">Primero creá una sesión de banco. Esto te da un ID de sesión (como una cookie) y, si activás el modo seguro, un token CSRF.</p>
      <button class="primary" id="btn-login" type="button">Iniciar sesión en el banco</button>
      <div class="session-info" id="session-info" style="display:none">
        <div class="session-row">
          <span class="session-label">Session ID (cookie):</span>
          <code class="session-value" id="session-id">—</code>
        </div>
        <div class="session-row">
          <span class="session-label">CSRF Token:</span>
          <code class="session-value token-value" id="csrf-token">—</code>
        </div>
        <div class="session-row">
          <span class="session-label">Saldo inicial:</span>
          <span class="session-value balance-value" id="initial-balance">—</span>
        </div>
      </div>
    </div>

    <!-- BROWSER TABS -->
    <div class="tabs-container" id="tabs-container" style="display:none">
      <!-- TAB: TU BANCO -->
      <div class="browser-tab bank-tab">
        <div class="tab-bar">
          <div class="tab-dots">
            <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
          </div>
          <div class="tab-url">
            <span class="tab-lock">🔒</span>
            <span>banco-seguro.com/cuenta</span>
          </div>
        </div>
        <div class="tab-body">
          <div class="bank-header">
            <span class="bank-logo">🏦</span>
            <span class="bank-name">Mi Banco Online</span>
            <span class="bank-user" id="bank-user">Usuario: juan@email.com</span>
          </div>
          <div class="bank-balance">
            <span class="balance-label">Saldo disponible</span>
            <span class="balance-amount" id="bank-balance">$50.000</span>
          </div>
          <div class="bank-movements" id="bank-movements">
            <div class="movement empty-movement">Sin movimientos recientes</div>
          </div>
        </div>
      </div>

      <!-- TAB: SITIO MALICIOSO -->
      <div class="browser-tab evil-tab">
        <div class="tab-bar evil-bar">
          <div class="tab-dots">
            <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
          </div>
          <div class="tab-url evil-url">
            <span class="tab-lock">⚠️</span>
            <span>sorteo-premios-gratis.com/ganaste</span>
          </div>
        </div>
        <div class="tab-body evil-body">
          <div class="evil-content" id="evil-content">
            <div class="evil-header">
              <span class="evil-icon">🎰</span>
              <span class="evil-title">¡FELICIDADES! ¡GANASTE!</span>
            </div>
            <div class="evil-text">
              Hacé clic aquí para reclamar tu premio de $5.000.000...
            </div>
            <div class="evil-fine-print">*Términos y condiciones aplican./oferta especial.</div>
          </div>
          <div class="evil-console" id="evil-console">
            <div class="console-header">Consola del atacante</div>
            <div class="console-output" id="console-output"></div>
          </div>
          <button class="evil-btn" id="btn-attack" type="button">
            <span>🎰</span> ¡RECLAMAR MI PREMIO!
          </button>
        </div>
      </div>
    </div>

    <!-- RESULT BANNER -->
    <div class="result-banner" id="result-banner" style="display:none">
      <div class="result-icon" id="result-icon"></div>
      <div class="result-body">
        <div class="result-title" id="result-title"></div>
        <div class="result-desc" id="result-desc"></div>
      </div>
    </div>

    <!-- SPLIT: CODE + EXPLANATION -->
    <div class="split">
      <div class="panel">
        <div class="panel-head">
          <span class="title">Código del backend</span>
          <span class="filename">csrf-demo.js</span>
        </div>
        <pre class="code"><span class="line" data-key="session"><span class="cm">// Sesión del usuario (cookie automática)</span></span>
<span class="line" data-key="session"><span class="kw">const</span> session = sessions.get(sessionId);</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="vuln"><span class="cm">// ⚠️ VULNERABLE — solo cookie</span></span>
<span class="line" data-key="vuln"><span class="kw">if</span> (mode === <span class="str">'vulnerable'</span>) {</span>
<span class="line" data-key="vuln">  <span class="cm">// No valida nada más. Si tenés cookie,</span></span>
<span class="line" data-key="vuln">  <span class="cm">// la petición se procesa.</span></span>
<span class="line" data-key="vuln">  procesarTransferencia(session);</span>
<span class="line" data-key="vuln">}</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="secure"><span class="cm">// ✅ SEGURO — synchronizer token</span></span>
<span class="line" data-key="secure"><span class="kw">if</span> (mode === <span class="str">'seguro'</span>) {</span>
<span class="line" data-key="secure">  <span class="kw">if</span> (csrfToken !== session.csrfToken) {</span>
<span class="line" data-key="secure">    <span class="kw">return</span> res.status(<span class="num">403</span>).json({</span>
<span class="line" data-key="secure">      error: <span class="str">'Token CSRF inválido'</span></span>
<span class="line" data-key="secure">    });</span>
<span class="line" data-key="secure">  }</span>
<span class="line" data-key="secure">  procesarTransferencia(session);</span>
<span class="line" data-key="secure">}</span>
<span class="line">&nbsp;</span>
<span class="line" data-key="why"><span class="cm">// ¿Por qué las cookies no alcanzan?</span></span>
<span class="line" data-key="why"><span class="cm">// El navegador envía cookies AUTOMÁTICAMENTE</span></span>
<span class="line" data-key="why"><span class="cm">// a cada petición al mismo dominio.</span></span>
<span class="line" data-key="why"><span class="cm">// Un &lt;form&gt; o fetch() desde cualquier sitio</span></span>
<span class="line" data-key="why"><span class="cm">// dispara la cookie si el target es el banco.</span></span></pre>
      </div>

      <div class="panel">
        <div class="panel-head">
          <span class="title">Qué está pasando</span>
        </div>
        <div class="explain-body">
          <div id="explain-idle" class="explain-idle">
            Primero iniciá sesión en el banco. Luego hacé clic en <strong>¡RECLAMAR MI PREMIO!</strong> en el sitio malicioso. Observá qué pasa en cada modo.
          </div>
          <div id="explain-active" style="display:none">
            <div class="explain-tag" id="explain-tag">ataque</div>
            <div class="explain-text" id="explain-text"></div>
          </div>
          <div class="console-line" id="console-line" style="display:none"></div>

          <div class="concepts-grid">
            <div class="concept-item">
              <div class="concept-icon">🍪</div>
              <div>
                <strong>¿Por qué las cookies no alcanzan?</strong> El navegador adjunta las cookies automáticamente a toda petición al mismo dominio. Un formulario oculto o un <code>fetch()</code> desde un sitio malicioso llega al banco con la cookie de sesión intacta — el banco no puede distinguirlo de una petición real.
              </div>
            </div>
            <div class="concept-item">
              <div class="concept-icon">🎫</div>
              <div>
                <strong>¿Qué es el Synchronizer Token?</strong> Un token aleatorio único que el banco genera al iniciar sesión, lo guarda en el servidor, y lo incluye en cada formulario. El sitio malicioso no puede adivinarlo ni leerlo de otra página — si el token no coincide, la petición se rechaza.
              </div>
            </div>
            <div class="concept-item">
              <div class="concept-icon">🔐</div>
              <div>
                <strong>¿Cómo se previene?</strong> El token CSRF se incluye como campo oculto en cada form o como header personalizado. El sitio malicioso puede hacer la petición, pero <strong>no puede conocer el token</strong> — no puede leer el HTML de tu banco por Same-Origin Policy. Sin el token válido, el servidor rechaza con 403.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
import { initSoundControls } from '../lib/soundControls.js';

(function () {
  const sound = initSoundControls();
  let mode = 'vulnerable';
  let sessionId = null;
  let csrfToken = null;
  let balance = 50000;

  // DOM refs
  const btnVulnerable = document.getElementById('btn-mode-vulnerable');
  const btnSecure = document.getElementById('btn-mode-secure');
  const modeStatusBadge = document.getElementById('mode-status-badge');
  const modeStatusText = document.getElementById('mode-status-text');
  const btnLogin = document.getElementById('btn-login');
  const sessionInfo = document.getElementById('session-info');
  const sessionIdEl = document.getElementById('session-id');
  const csrfTokenEl = document.getElementById('csrf-token');
  const initialBalanceEl = document.getElementById('initial-balance');
  const tabsContainer = document.getElementById('tabs-container');
  const bankBalance = document.getElementById('bank-balance');
  const bankMovements = document.getElementById('bank-movements');
  const evilContent = document.getElementById('evil-content');
  const consoleOutput = document.getElementById('console-output');
  const btnAttack = document.getElementById('btn-attack');
  const resultBanner = document.getElementById('result-banner');
  const resultIcon = document.getElementById('result-icon');
  const resultTitle = document.getElementById('result-title');
  const resultDesc = document.getElementById('result-desc');
  const explainIdle = document.getElementById('explain-idle');
  const explainActive = document.getElementById('explain-active');
  const explainTag = document.getElementById('explain-tag');
  const explainText = document.getElementById('explain-text');
  const consoleLine = document.getElementById('console-line');
  const codeLines = document.querySelectorAll('.line');

  function highlightCode(keys) {
    codeLines.forEach(line => {
      const k = line.getAttribute('data-key');
      line.classList.toggle('active', keys.includes(k));
    });
  }

  function setMode(newMode) {
    mode = newMode;
    if (mode === 'vulnerable') {
      btnVulnerable?.classList.add('active');
      btnSecure?.classList.remove('active');
      if (modeStatusBadge) modeStatusBadge.className = 'mode-status-badge danger';
      if (modeStatusText) modeStatusText.textContent = 'VULNERABLE — solo cookie de sesión';
    } else {
      btnSecure?.classList.add('active');
      btnVulnerable?.classList.remove('active');
      if (modeStatusBadge) modeStatusBadge.className = 'mode-status-badge safe';
      if (modeStatusText) modeStatusText.textContent = 'SEGURO — requiere token CSRF';
    }
    highlightCode(mode === 'vulnerable' ? ['vuln'] : ['secure']);
    resetTabs();
  }

  function resetTabs() {
    if (tabsContainer) tabsContainer.style.display = 'none';
    if (resultBanner) resultBanner.style.display = 'none';
    if (evilContent) evilContent.style.display = 'block';
    if (btnAttack) btnAttack.disabled = false;
    if (consoleOutput) consoleOutput.innerHTML = '';
    if (explainIdle) explainIdle.style.display = 'block';
    if (explainActive) explainActive.style.display = 'none';
    if (consoleLine) consoleLine.style.display = 'none';
  }

  async function login() {
    try {
      const res = await fetch('/api/csrf-demo/token');
      const data = await res.json();
      sessionId = data.sessionId;
      csrfToken = data.csrfToken;
      balance = data.balance;

      if (sessionIdEl) sessionIdEl.textContent = sessionId.substring(0, 24) + '...';
      if (csrfTokenEl) csrfTokenEl.textContent = mode === 'secure' ? csrfToken.substring(0, 24) + '...' : '(no emitido — modo vulnerable)';
      if (initialBalanceEl) initialBalanceEl.textContent = `$${balance.toLocaleString('es-AR')}`;
      if (bankBalance) bankBalance.textContent = `$${balance.toLocaleString('es-AR')}`;
      if (sessionInfo) sessionInfo.style.display = 'flex';
      if (tabsContainer) tabsContainer.style.display = 'grid';

      if (bankMovements) {
        bankMovements.innerHTML = '<div class="movement empty-movement">Sin movimientos recientes</div>';
      }

      highlightCode(['session']);
      sound.play('playSuccess');
    } catch {
      sound.play('playAlert');
    }
  }

  async function launchAttack() {
    if (!sessionId) return;
    btnAttack.disabled = true;
    if (evilContent) evilContent.style.display = 'none';
    if (resultBanner) resultBanner.style.display = 'none';

    sound.play('playAlert');

    // Step 1: attacker site constructs the request
    addConsoleLine('atk', 'Sitio malicioso detectado tu sesión activa en banco-seguro.com');
    addConsoleLine('atk', `Construyendo petición POST a /api/csrf-demo/transferir...`);
    addConsoleLine('atk', `Session ID capturado: ${sessionId.substring(0, 16)}...`);

    if (mode === 'seguro') {
      addConsoleLine('atk', 'Token CSRF: NO DISPONIBLE (protegido por Same-Origin Policy)');
    }

    addConsoleLine('atk', 'Disparando petición automática...');

    await sleep(800);

    try {
      const payload = {
        sessionId,
        to: 'cuenta-attacker-99999',
        amount: 5000,
        mode,
      };

      if (mode === 'seguro') {
        payload.csrfToken = 'token-falso-del-atacante';
      }

      const res = await fetch('/api/csrf-demo/transferir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok) {
        // Transfer succeeded
        balance = data.newBalance;
        if (bankBalance) bankBalance.textContent = `$${balance.toLocaleString('es-AR')}`;

        if (bankMovements) {
          bankMovements.innerHTML = `
            <div class="movement danger-movement">
              <span class="mov-desc">Transferencia automática (ataque CSRF)</span>
              <span class="mov-amount">-$${data.amount.toLocaleString('es-AR')}</span>
            </div>
            <div class="movement empty-movement">Sin movimientos recientes</div>
          `;
        }

        addConsoleLine('ok', `Transferencia ejecutada: $${data.amount.toLocaleString('es-AR')} → cuenta-attacker-99999`);
        addConsoleLine('ok', `Saldo nuevo: $${data.newBalance.toLocaleString('es-AR')}`);

        if (resultBanner) resultBanner.style.display = 'flex';
        if (resultIcon) resultIcon.textContent = '🚨';
        if (resultTitle) {
          resultTitle.textContent = 'Transferencia ejecutada sin tu consentimiento';
          resultTitle.className = 'result-title danger';
        }
        if (resultDesc) resultDesc.textContent = 'El sitio malicioso envió una petición a tu banco. Tu navegador adjuntó la cookie de sesión automáticamente. El banco no pudo distinguir esta petición de una legítima — no había ningún token CSRF que validar.';

        sound.play('playBlocked');
        highlightCode(['vuln', 'why']);

        if (explainIdle) explainIdle.style.display = 'none';
        if (explainActive) explainActive.style.display = 'block';
        if (explainTag) {
          explainTag.textContent = 'CSRF exitoso — saldo robado';
          explainTag.className = 'explain-tag danger';
        }
        if (explainText) {
          explainText.innerHTML = `<strong style="color:var(--rose,#fb7185)">La transferencia se ejecutó porque el banco solo validó la cookie:</strong> El navegador la adjuntó automáticamente a la petición del sitio malicioso. El banco no tiene forma de saber que la petición no vino de vos — <code>Same-Origin Policy</code> protege la lectura de respuestas, pero no el envío de peticiones POST con cookies.`;
        }
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line danger';
          consoleLine.innerHTML = `[CSRF] Transferencia de $5.000 ejecutada sin consentimiento. Saldo: $${balance.toLocaleString('es-AR')}`;
        }

      } else {
        // Transfer rejected
        addConsoleLine('err', `ERROR ${res.status}: ${data.error}`);

        if (resultBanner) resultBanner.style.display = 'flex';
        if (resultIcon) resultIcon.textContent = '🛡️';
        if (resultTitle) {
          resultTitle.textContent = 'Transferencia rechazada — token CSRF inválido';
          resultTitle.className = 'result-title safe';
        }
        if (resultDesc) resultDesc.textContent = 'El sitio malicioso no tenía el token CSRF válido. El servidor rechazó la petición con 403. Tu saldo está intacto.';

        sound.play('playSuccess');
        highlightCode(['secure', 'why']);

        if (explainIdle) explainIdle.style.display = 'none';
        if (explainActive) explainActive.style.display = 'block';
        if (explainTag) {
          explainTag.textContent = 'CSRF bloqueado — token validado';
          explainTag.className = 'explain-tag safe';
        }
        if (explainText) {
          explainText.innerHTML = `<strong style="color:var(--green,#10b981)">El token CSRF detuvo el ataque:</strong> El sitio malicioso no puede conocer el token porque <code>Same-Origin Policy</code> le impide leer el HTML de tu banco. Sin el token válido, el servidor rechaza la petición con <code>403 Forbidden</code>. El synchronizer token es lo que diferencia una petición legítima de una falsificada.`;
        }
        if (consoleLine) {
          consoleLine.style.display = 'block';
          consoleLine.className = 'console-line success';
          consoleLine.innerHTML = '[CSRF] Petición rechazada — token CSRF inválido o faltante (403).';
        }
      }
    } catch {
      addConsoleLine('err', 'Error de conexión con el servidor.');
    }
  }

  function addConsoleLine(type, text) {
    if (!consoleOutput) return;
    const cls = type === 'ok' ? 'line-ok' : type === 'err' ? 'line-err' : 'line-atk';
    const prefix = type === 'ok' ? '[OK]' : type === 'err' ? '[ERR]' : '[ATK]';
    consoleOutput.innerHTML += `<div class="${cls}">${prefix} ${escapeHtml(text)}</div>`;
    consoleOutput.scrollTop = consoleOutput.scrollHeight;
  }

  function escapeHtml(str) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    return str.replace(/[&<>"']/g, c => map[c]);
  }

  function sleep(ms) {
    return new Promise(r => setTimeout(r, ms));
  }

  // Event listeners
  btnVulnerable?.addEventListener('click', () => setMode('vulnerable'));
  btnSecure?.addEventListener('click', () => setMode('secure'));
  btnLogin?.addEventListener('click', login);
  btnAttack?.addEventListener('click', launchAttack);

  setMode('vulnerable');
})();
</script>

<style>
  .api-page {
    --api-panel: var(--surface-panel);
    --api-border: var(--border-subtle);
    --api-border-soft: var(--border-hairline);
    --api-muted: var(--text-secondary);
    --api-muted-2: var(--text-muted);
    --rose: #fb7185;
    --rose-soft: rgba(251, 113, 133, 0.18);
    --green: #10b981;
    --green-soft: rgba(16, 185, 129, 0.15);
    --red: #ef4444;
    --red-soft: rgba(239, 68, 68, 0.18);
    --amber: #f59e0b;

    width: min(100%, 980px);
    margin: 0 auto;
    padding: 0.35rem 0 1.25rem;
  }

  /* TOPBAR */
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 4px 2px 26px; border-bottom: 1px solid var(--api-border-soft); margin-bottom: 34px; }
  .topbar-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .brand-link { display: inline-flex; align-items: center; gap: 10px; width: fit-content; color: var(--text-primary); text-decoration: none; font-size: 15px; font-weight: 700; }
  .brand-link:hover { color: var(--text-white); }
  .brand-mark { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; color: #fff; background: var(--rose); font-size: 12px; font-weight: 800; box-shadow: 0 0 0 4px var(--rose-soft); }
  .topbar-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .home-action { display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 7px 12px; border: 1px solid var(--api-border); border-radius: 10px; color: var(--api-muted); background: rgba(255,255,255,0.03); text-decoration: none; font-size: 13px; font-weight: 600; transition: all .15s; }
  .home-action svg { width: 16px; height: 16px; }
  .home-action:hover { color: var(--text-primary); border-color: var(--border-hover); background: rgba(255,255,255,0.06); }
  .crumbs { font-size: 13.5px; color: var(--api-muted); display: flex; align-items: center; gap: 6px; }
  .crumbs .sep { color: var(--api-muted-2); }
  .crumbs .current { color: var(--text-primary); }
  .crumbs a { color: var(--api-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--text-primary); }
