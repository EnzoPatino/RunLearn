---
import Layout from "../layouts/Layout.astro";
import BackendErrorBanner from "../components/BackendErrorBanner.astro";
---

<Layout title="OAuth 2.0 & PKCE | RunLearn">
  <div class="dashboard">
    <BackendErrorBanner id="oauth-banner" />

    <header class="page-header">
      <div class="header-badge">Seguridad & Protocolos</div>
      <h1 class="page-title">OAuth 2.0 & PKCE</h1>
      <p class="page-subtitle">
        Flujo Authorization Code con Proof Key for Code Exchange (RFC 7636). Mitigación de interceptación de credenciales en clientes públicos sin client_secret.
      </p>
    </header>

    <section class="controls-section">
      <div class="control-group">
        <label class="control-label" for="client-id-input">Client ID (Public Client)</label>
        <input type="text" id="client-id-input" value="runlearn-spa-client" class="text-input" readonly />
      </div>

      <div class="control-group">
        <label class="control-label" for="scope-selector">Scope solicitado</label>
        <div class="scope-badges" id="scope-selector">
          <span class="scope-badge">openid</span>
          <span class="scope-badge">profile</span>
          <span class="scope-badge">email</span>
        </div>
      </div>

      <div class="control-group action-buttons">
        <button class="btn-primary" id="btn-run-pkce">Ejecutar handshake completo</button>
        <button class="btn-danger" id="btn-tamper-test">Simular ataque de intercepcion</button>
        <button class="btn-subtle" id="btn-reset">Restablecer</button>
      </div>
    </section>

    <!-- Visualizador de Criptografia PKCE -->
    <section class="crypto-section" aria-label="Derivacion criptografica PKCE">
      <div class="crypto-header">
        <span class="crypto-tag">DERIVACION DE CLAVES (RFC 7636 S256)</span>
        <button class="btn-regen" id="btn-regen-verifier">Generar nuevo verifier</button>
      </div>

      <div class="crypto-pipeline">
        <div class="crypto-box">
          <div class="box-label">CODE_VERIFIER (Secreto en memoria del cliente)</div>
          <div class="box-value font-mono" id="val-verifier">Generando...</div>
          <div class="box-meta">43 a 128 caracteres ASCII sin procesar (256 bits de entropia)</div>
        </div>

        <div class="crypto-arrow">
          <span class="arrow-label">SHA-256 + Base64URL</span>
          <div class="arrow-svg">
            <svg viewBox="0 0 60 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="0" y1="10" x2="52" y2="10" />
              <polyline points="45,4 53,10 45,16" />
            </svg>
          </div>
        </div>

        <div class="crypto-box highlight">
          <div class="box-label">CODE_CHALLENGE (Transmitido publicamente)</div>
          <div class="box-value font-mono" id="val-challenge">Generando...</div>
          <div class="box-meta">BASE64URL(SHA256(verifier)) — Funcion hash unidireccional</div>
        </div>
      </div>
    </section>

    <!-- Diagrama de Flujo del Protocolo -->
    <section class="flow-section" aria-label="Diagrama de secuencia">
      <div class="flow-actors">
        <div class="actor">
          <div class="actor-box">Single Page App</div>
          <div class="actor-line"></div>
        </div>
        <div class="actor">
          <div class="actor-box">Navegador / User-Agent</div>
          <div class="actor-line"></div>
        </div>
        <div class="actor">
          <div class="actor-box">Authorization Server</div>
          <div class="actor-line"></div>
        </div>
      </div>

      <div class="sequence-list" id="sequence-steps">
        <div class="seq-item" id="step-1">
          <span class="seq-num">1</span>
          <div class="seq-content">
            <span class="seq-title">Generacion de Verifier y Challenge</span>
            <span class="seq-desc">El cliente genera <code>code_verifier</code> criptografico y deriva <code>code_challenge</code> mediante SHA-256.</span>
          </div>
        </div>
        <div class="seq-item" id="step-2">
          <span class="seq-num">2</span>
          <div class="seq-content">
            <span class="seq-title">Peticion de Autorizacion (GET /authorize)</span>
            <span class="seq-desc">El navegador redirige al Auth Server con <code>code_challenge</code> y <code>code_challenge_method=S256</code>.</span>
          </div>
        </div>
        <div class="seq-item" id="step-3">
          <span class="seq-num">3</span>
          <div class="seq-content">
            <span class="seq-title">Emision de Authorization Code</span>
            <span class="seq-desc">Tras autenticar al usuario, el servidor emite un <code>code</code> efimero con TTL de 60s vinculado al challenge.</span>
          </div>
        </div>
        <div class="seq-item" id="step-4">
          <span class="seq-num">4</span>
          <div class="seq-content">
            <span class="seq-title">Canje de Token (POST /token)</span>
            <span class="seq-desc">La SPA envia <code>code</code> + <code>code_verifier</code> original en canal seguro TLS directo.</span>
          </div>
        </div>
        <div class="seq-item" id="step-5">
          <span class="seq-num">5</span>
          <div class="seq-content">
            <span class="seq-title">Verificacion y Emision de Access Token</span>
            <span class="seq-desc">El servidor recalcula SHA-256(verifier). Si coincide con el challenge previo, expide el JWT.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Terminal de Inspeccion HTTP -->
    <section class="terminal-section">
      <div class="terminal-bar">
        <span class="term-tag">HTTP PROTOCOL INSPECTOR</span>
        <span class="term-status" id="handshake-status">ESTADO: INACTIVO</span>
      </div>
      <div class="terminal-body font-mono" id="protocol-log">
        <div class="log-hint">Inicia el flujo presionando "Ejecutar handshake completo" o prueba el vector de ataque.</div>
      </div>
    </section>

    <!-- Analisis Tecnico -->
    <section class="edu-section">
      <h2 class="section-title">Vulnerabilidad de Authorization Code clasico y solucion PKCE</h2>

      <div class="analysis-grid">
        <div class="analysis-card threat">
          <div class="card-badge danger">AMENAZA: INTERCEPCION DE CODIGO</div>
          <h3 class="card-title">Ataque sin PKCE (RFC 6749)</h3>
          <p class="card-text">
            En clientes publicos (SPAs y apps moviles), no es posible resguardar un <code>client_secret</code> sin exponerlo en el bundle JavaScript. Si una extension maliciosa o malware en el dispositivo intercepta el redirect URI con el <code>code</code>, el atacante puede canjearlo directamente en <code>/token</code> y suplantar al usuario legitimamente.
          </p>
        </div>

        <div class="analysis-card solution">
          <div class="card-badge success">DEFENSA: PROOF KEY (RFC 7636)</div>
          <h3 class="card-title">Mitigacion matematica con PKCE</h3>
          <p class="card-text">
            El interceptor captura unicamente el <code>code</code> y el <code>code_challenge</code> publico. Debido a la propiedad de resistencia a la preimagen de SHA-256, es computacionalmente imposible deducir el <code>code_verifier</code> a partir del challenge. Al intentar canjear el token, el servidor rechaza la peticion con error <code>invalid_grant</code>.
          </p>
        </div>
      </div>

      <div class="code-compare">
        <div class="code-block">
          <div class="code-head">1. Solicitud de autorizacion (Front-Channel)</div>
          <pre><code>GET /authorize?
  response_type=code
  &client_id=runlearn-spa-client
  &redirect_uri=https%3A%2F%2Fmyapp.com%2Fcallback
  &scope=openid%20profile%20email
  &code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM
  &code_challenge_method=S256</code></pre>
        </div>

        <div class="code-block">
          <div class="code-head">2. Canje directo por token (Back-Channel)</div>
          <pre><code>POST /token HTTP/1.1
Host: auth.runlearn.dev
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code
&client_id=runlearn-spa-client
&code=SplxlOBeZQQYbYS6WxSbIA
&code_verifier=dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk</code></pre>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { getApiBaseUrl, fetchWithTimeout, showBackendErrorBanner, hideBackendErrorBanner } from '../lib/apiClient.js';
  import { initSoundControls } from '../lib/soundControls.js';

  const sound = initSoundControls();
  let currentVerifier = '';
  let currentChallenge = '';
  let currentAuthCode = '';
  let backendOnline = true;

  // Criptografia nativa en cliente (Web Crypto API)
  function generateRandomVerifier(length = 64) {
    const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
    const randomValues = new Uint8Array(length);
    window.crypto.getRandomValues(randomValues);
    return Array.from(randomValues, byte => charset[byte % charset.length]).join('');
  }

  async function deriveChallenge(verifier) {
    const encoder = new TextEncoder();
    const data = encoder.encode(verifier);
    const hashBuffer = await window.crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    // Base64URL encode
    const base64 = btoa(String.fromCharCode.apply(null, hashArray));
    return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  const valVerifierEl = document.getElementById('val-verifier');
  const valChallengeEl = document.getElementById('val-challenge');
  const protocolLog = document.getElementById('protocol-log');
  const statusEl = document.getElementById('handshake-status');

  async function refreshKeys() {
    currentVerifier = generateRandomVerifier(56);
    currentChallenge = await deriveChallenge(currentVerifier);
    if (valVerifierEl) valVerifierEl.textContent = currentVerifier;
    if (valChallengeEl) valChallengeEl.textContent = currentChallenge;
  }

  // Inicializar claves al cargar
  refreshKeys();

  document.getElementById('btn-regen-verifier')?.addEventListener('click', () => {
    sound.play?.('playStep');
    refreshKeys();
  });

  function clearActiveSteps() {
    document.querySelectorAll('.seq-item').forEach(el => el.classList.remove('active', 'error'));
  }

  function setActiveStep(num, isError = false) {
    const stepEl = document.getElementById(`step-${num}`);
    if (stepEl) {
      stepEl.classList.add(isError ? 'error' : 'active');
      stepEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function appendLog(rawText) {
    if (!protocolLog) return;
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.innerHTML = rawText;
    const hint = protocolLog.querySelector('.log-hint');
    if (hint) hint.remove();
    protocolLog.appendChild(entry);
    protocolLog.scrollTop = protocolLog.scrollHeight;
  }

  async function executeHandshake() {
    clearActiveSteps();
    if (protocolLog) protocolLog.innerHTML = '';
    sound.play?.('playStep');
    if (statusEl) statusEl.textContent = 'ESTADO: PROCESANDO HANDSHAKE';

    // Paso 1: Derivacion
    setActiveStep(1);
    appendLog(`[1] <span class="tok-kw">CLIENT_CRYPTO</span>: Generando code_verifier (entropia: 256 bits)`);
    appendLog(`    code_verifier  = "${currentVerifier}"`);
    appendLog(`    code_challenge = "${currentChallenge}" (method: S256)`);

    await new Promise(r => setTimeout(r, 450));

    // Paso 2: GET /authorize
    setActiveStep(2);
    appendLog(`\n[2] <span class="tok-req">HTTP GET</span> /api/oauth-demo/authorize?response_type=code&client_id=runlearn-spa-client&code_challenge=${currentChallenge}&code_challenge_method=S256`);

    let authData;
    try {
      const base = getApiBaseUrl();
      const res = await fetchWithTimeout(`${base}/api/oauth-demo/authorize`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          clientId: 'runlearn-spa-client',
          codeChallenge: currentChallenge,
          codeChallengeMethod: 'S256',
          redirectUri: 'https://myapp.runlearn.dev/callback',
        }),
      }, 4000);
      authData = await res.json();
      hideBackendErrorBanner('oauth-banner');
    } catch {
      backendOnline = false;
      showBackendErrorBanner('oauth-banner', 'Servidor de autorizacion simulado localmente.');
      authData = {
        authorizationCode: 'sim_' + Math.random().toString(36).substring(2, 14),
        expiresIn: 60,
      };
    }

    currentAuthCode = authData.authorizationCode;

    await new Promise(r => setTimeout(r, 450));

    // Paso 3: Código emitido
    setActiveStep(3);
    appendLog(`\n[3] <span class="tok-res">HTTP 302 FOUND</span> Location: https://myapp.runlearn.dev/callback?code=${currentAuthCode}&state=xyz`);
    appendLog(`    Authorization Server vinculo temporalmente code -> challenge`);

    await new Promise(r => setTimeout(r, 450));

    // Paso 4: POST /token
    setActiveStep(4);
    appendLog(`\n[4] <span class="tok-req">HTTP POST</span> /api/oauth-demo/token`);
    appendLog(`    Host: auth.runlearn.dev`);
    appendLog(`    Content-Type: application/x-www-form-urlencoded`);
    appendLog(`    grant_type=authorization_code&client_id=runlearn-spa-client&code=${currentAuthCode}&code_verifier=${currentVerifier}`);

    await new Promise(r => setTimeout(r, 550));

    // Paso 5: Verificación y emisión
    setActiveStep(5);
    let tokenData;
    try {
      if (backendOnline) {
        const base = getApiBaseUrl();
        const res = await fetchWithTimeout(`${base}/api/oauth-demo/token`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code: currentAuthCode,
            codeVerifier: currentVerifier,
            clientId: 'runlearn-spa-client',
          }),
        }, 4000);
        tokenData = await res.json();
      } else {
        tokenData = {
          accessToken: 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.simulated_token',
          tokenType: 'Bearer',
          expiresIn: 3600,
          scope: 'openid profile email',
        };
      }

      appendLog(`\n[5] <span class="tok-ok">HTTP 200 OK</span>`);
      appendLog(`    SHA256(received_verifier) === stored_challenge -> <span class="tok-ok">MATCH VALIDO</span>`);
      appendLog(`    Access Token emitido: ${tokenData.accessToken?.substring(0, 32)}...`);
      appendLog(`    Token Type: ${tokenData.tokenType || 'Bearer'} | Expires In: ${tokenData.expiresIn || 3600}s`);

      if (statusEl) statusEl.textContent = 'ESTADO: AUTORIZACION EXITOSA (200 OK)';
      window.dispatchEvent(new Event('runlearn:simulation-complete'));
    } catch (err) {
      appendLog(`\n[ERR] Error al procesar token: ${err.message}`);
    }
  }

  // Simulación de ataque: Un atacante intercepta el code pero envía un verifier incorrecto/falso
  async function executeTamperAttack() {
    clearActiveSteps();
    if (protocolLog) protocolLog.innerHTML = '';
    sound.play?.('playStep');
    if (statusEl) statusEl.textContent = 'ESTADO: SIMULANDO INTENTO DE REPLAY/INTERCEPCION';

    const fakeVerifier = generateRandomVerifier(56);

    appendLog(`[AMENAZA] Atacante en red local intercepta la redireccion con el authorization_code.`);
    appendLog(`          Codigo interceptado: ${currentAuthCode || 'auth_code_interceptado_98af'}`);
    appendLog(`          El atacante intenta canjear el codigo con su propio verifier: "${fakeVerifier.substring(0, 24)}..."`);

    setActiveStep(4);
    await new Promise(r => setTimeout(r, 600));

    setActiveStep(5, true);
    appendLog(`\n<span class="tok-req">HTTP POST</span> /api/oauth-demo/token`);
    appendLog(`    code=${currentAuthCode || 'auth_code_interceptado_98af'}`);
    appendLog(`    code_verifier=${fakeVerifier}`);

    await new Promise(r => setTimeout(r, 500));

    appendLog(`\n<span class="tok-err">HTTP 400 BAD REQUEST</span>`);
    appendLog(`    error: "invalid_grant"`);
    appendLog(`    error_description: "PKCE fallida: BASE64URL(SHA-256(verifier)) !== stored_challenge"`);
    appendLog(`    <span class="tok-ok">MITIGACION CONFIRMADA</span>: El token nunca fue emitido al atacante.`);

    if (statusEl) statusEl.textContent = 'ESTADO: ATAQUE MITIGADO EXITOSAMENTE (400 BAD REQUEST)';
    sound.play?.('error');
    window.dispatchEvent(new Event('runlearn:simulation-complete'));
  }

  document.getElementById('btn-run-pkce')?.addEventListener('click', executeHandshake);
  document.getElementById('btn-tamper-test')?.addEventListener('click', executeTamperAttack);
  document.getElementById('btn-reset')?.addEventListener('click', () => {
    clearActiveSteps();
    if (protocolLog) protocolLog.innerHTML = '<div class="log-hint">Estado reinicializado. Presiona "Ejecutar handshake completo".</div>';
    if (statusEl) statusEl.textContent = 'ESTADO: INACTIVO';
    refreshKeys();
  });
</script>

<style>
  .dashboard {
    width: 100%;
    min-height: 100vh;
    background: var(--canvas-bg);
    color: var(--text-primary);
    font-family: var(--font-main);
    padding: 2.5rem 1.5rem;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
  }

  .header-badge {
    display: inline-block;
    background: rgba(251, 113, 133, 0.1);
    color: var(--color-gitlab);
    border: 1px solid rgba(251, 113, 133, 0.3);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    color: var(--text-white);
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 800px;
    margin: 0;
  }

  .controls-section {
    background: var(--surface-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-end;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .control-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .text-input {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 0.45rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    outline: none;
    min-width: 180px;
  }

  .scope-badges {
    display: flex;
    gap: 0.4rem;
  }

  .scope-badge {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .action-buttons {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
  }

  .btn-primary, .btn-danger, .btn-subtle {
    border-radius: var(--radius-pill);
    padding: 0.5rem 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--ease-fast);
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--color-gitlab);
    color: #ffffff;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn-danger {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  .btn-danger:hover {
    background: rgba(239, 68, 68, 0.25);
  }

  .btn-subtle {
    background: var(--surface-card);
    border-color: var(--border-subtle);
    color: var(--text-secondary);
  }

  .btn-subtle:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .crypto-section {
    background: var(--surface-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .crypto-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .crypto-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .btn-regen {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.8rem;
    font-size: 0.72rem;
    cursor: pointer;
    transition: all var(--ease-fast);
  }

  .btn-regen:hover {
    color: var(--text-white);
    border-color: var(--border-hover);
  }

  .crypto-pipeline {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .crypto-box {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem;
  }

  .crypto-box.highlight {
    border-color: rgba(251, 113, 133, 0.3);
  }

  .box-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .box-value {
    font-size: 0.82rem;
    color: var(--color-gitlab);
    word-break: break-all;
    background: rgba(0, 0, 0, 0.2);
    padding: 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
    min-height: 2.2rem;
  }

  .box-meta {
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .crypto-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .arrow-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .arrow-svg {
    width: 60px;
    height: 20px;
    color: var(--color-gitlab);
  }

  .flow-section {
    background: var(--surface-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .flow-actors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .actor-box {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
