---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import TechGrid from '../components/TechGrid.astro';
import SectionDivider from '../components/SectionDivider.astro';
import CoursesTray from '../components/CoursesTray.astro';
---

<Layout title="DevPlatform – Dashboard & Aula Virtual">
  <!-- 1. Header / Navbar -->
  <Navbar />

  <!-- 2. Tecnologías Bento Grid (2x4) -->
  <TechGrid />

  <!-- 3. Divisor de Sección con contador -->
  <SectionDivider title="Tus apuntes / Cursos asignados" count="4 Activos" />

  <!-- 4. Bandeja de Cursos & Apuntes -->
  <CoursesTray />
</Layout>
