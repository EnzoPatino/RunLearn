---
import Layout from '../layouts/Layout.astro';
import BackendErrorBanner from '../components/BackendErrorBanner.astro';
---

<Layout title="RunLearn — GraphQL vs REST">
  <div class="api-page">
    <header class="topbar">
      <div class="topbar-main">
        <a class="brand-link" href="/" aria-label="Volver al inicio de RunLearn">
          <span class="brand-mark">RL</span>
          <span>RunLearn</span>
        </a>
        <nav class="crumbs" aria-label="Ruta actual">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <a href="/clases">Clases</a>
          <span class="sep">/</span>
          <span class="current">GraphQL vs REST</span>
        </nav>
      </div>
      <div class="topbar-actions">
        <button class="sound-btn" id="btn-toggle-sound" type="button" aria-pressed="false">
          <span id="sound-icon" aria-hidden="true"></span>
          <span id="sound-text">Sonido activo</span>
        </button>
        <a class="home-action" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10.8 9-7.2 9 7.2"/>
            <path d="M5.5 9.5V20h13V9.5"/>
            <path d="M9.5 20v-6h5v6"/>
          </svg>
          Inicio
        </a>
        <div class="badge-live"><span class="dot"></span>módulo interactivo</div>
      </div>
    </header>

    <section class="lesson-header">
      <span class="badge-tag">Backend & Arquitectura de APIs</span>
      <h1>GraphQL vs REST: Over-fetching y Red de Resolvers</h1>
      <p class="lede">
        En una arquitectura <strong>REST</strong> tradicional, los endpoints son fijos: pedir un usuario suele devolver decenas de campos innecesarios (<em>Over-fetching</em>), y para traer sus artículos hay que hacer peticiones adicionales encadenadas (<em>Under-fetching / N+1</em>). <strong>GraphQL</strong> invierte el control: el cliente envía un documento de consulta y el servidor ejecuta un árbol de <strong>resolvers</strong> para entregar únicamente los bytes solicitados en una sola llamada <code>POST /graphql</code>.
      </p>
    </section>

    <!-- Banner de error si el backend no responde -->
    <BackendErrorBanner
      id="graphql-backend-error"
      message="No se pudo conectar con el servidor backend. Usando simulación local en el navegador."
      hint="El backend Express expone /api/graphql-demo/query con cálculo real de tamaños en bytes."
    />

    <!-- SELECTOR DE ENFOQUE -->
    <div class="paradigm-selector">
      <button type="button" class="paradigm-btn active" id="btn-mode-graphql">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 21 8.5 21 15.5 12 22 3 15.5 3 8.5 12 2" />
        </svg>
        <div class="paradigm-info">
          <span class="paradigm-title">Enfoque GraphQL</span>
          <span class="paradigm-sub">1 petición POST · Payload quirúrgico</span>
        </div>
      </button>

      <button type="button" class="paradigm-btn" id="btn-mode-rest">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <line x1="3" y1="9" x2="21" y2="9" />
          <line x1="9" y1="21" x2="9" y2="9" />
        </svg>
        <div class="paradigm-info">
          <span class="paradigm-title">Enfoque REST Tradicional</span>
          <span class="paradigm-sub">3 peticiones GET · Over-fetching masivo</span>
        </div>
      </button>
    </div>

    <!-- TARJETA COMPARATIVA DE MÉTRICAS EN VIVO -->
    <div class="metrics-strip">
      <div class="metric-card">
        <span class="metric-label">Peticiones de Red</span>
        <span class="metric-value" id="val-requests">1 HTTP</span>
        <span class="metric-sub" id="sub-requests">1 solo viaje cliente-servidor</span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Bytes Transferidos</span>
        <span class="metric-value highlight" id="val-bytes">194 B</span>
        <span class="metric-sub" id="sub-bytes">95% menos tráfico</span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Latencia Estimada</span>
        <span class="metric-value" id="val-latency">~28 ms</span>
        <span class="metric-sub" id="sub-latency">Sin cuellos de botella N+1</span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Campos Descartados</span>
        <span class="metric-value" id="val-wasted">0 campos</span>
        <span class="metric-sub" id="sub-wasted">Sin desperdicio de CPU o RAM</span>
      </div>
    </div>

    <!-- MAIN INTERACTIVE WORKSPACE -->
    <div class="workspace-grid">
      <!-- PANEL IZQUIERDO: QUERY BUILDER O MAPA REST -->
      <div class="workspace-card" id="left-card">
        <div class="card-head">
          <span id="left-card-title">Constructor de Consulta (GraphQL Query)</span>
          <span class="badge-mini" id="query-mode-badge">POST /graphql</span>
        </div>

        <div class="card-content">
          <!-- BUILDER GRAPHQL -->
          <div id="graphql-builder">
            <p class="builder-hint">Elegí qué campos querés pedirle al servidor:</p>
            <div class="fields-group">
              <span class="group-title">Campos de Autor:</span>
              <div class="checkboxes-grid">
                <label class="field-chk"><input type="checkbox" id="chk-nombre" checked /> <code>nombre</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-email" checked /> <code>email</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-rol" /> <code>rol</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-avatar" /> <code>avatar</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-bio" /> <code>bio</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-ubicacion" /> <code>ubicacion</code></label>
              </div>
            </div>

            <div class="fields-group">
              <span class="group-title">Artículos Anidados:</span>
              <div class="checkboxes-grid">
                <label class="field-chk"><input type="checkbox" id="chk-include-articles" checked /> Incluir <code>articulos</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-art-titulo" checked /> <code>titulo</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-art-vistas" /> <code>vistas</code></label>
                <label class="field-chk"><input type="checkbox" id="chk-art-likes" /> <code>likes</code></label>
              </div>
            </div>

            <div class="query-preview">
              <span class="preview-label">Consulta a enviar:</span>
              <pre id="query-text"><code>query &#123;
  author &#123;
    nombre
    email
    articulos &#123;
      titulo
    &#125;
  &#125;
&#125;</code></pre>
            </div>
          </div>

          <!-- MAPA REST -->
          <div id="rest-map" style="display: none;">
            <p class="builder-hint">Para armar la misma pantalla, REST obliga a realizar 3 llamadas independientes:</p>
            <div class="rest-steps-list">
              <div class="rest-step-item">
                <span class="step-badge">Paso 1</span>
                <div class="step-desc">
                  <strong>GET /api/authors/1</strong>
                  <p>Descarga datos del autor (18 campos, incluye preferencias privadas, fechas, etc.).</p>
                </div>
              </div>
              <div class="rest-step-item">
                <span class="step-badge">Paso 2</span>
                <div class="step-desc">
                  <strong>GET /api/authors/1/articles</strong>
                  <p>Descarga el listado completo de artículos con contenido de 3.000 palabras.</p>
                </div>
              </div>
              <div class="rest-step-item">
                <span class="step-badge">Paso 3</span>
                <div class="step-desc">
                  <strong>GET /api/articles/101/stats</strong>
                  <p>Petición adicional para obtener métricas agregadas de interacciones.</p>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="btn-execute" id="btn-execute">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Ejecutar y Comparar
          </button>
        </div>
      </div>

      <!-- PANEL DERECHO: TERMINAL DE RESPUESTA & WATERFALL -->
      <div class="workspace-card">
        <div class="card-head">
          <span>Respuesta HTTP del Servidor</span>
          <span class="badge-mini badge-status" id="res-status-badge">200 OK</span>
        </div>

        <div class="card-content">
          <!-- WATERFALL DE PETICIONES -->
          <div class="waterfall-box">
            <span class="waterfall-title">Línea de tiempo de red (Network Waterfall):</span>
            <div class="waterfall-track" id="waterfall-track">
              <!-- Renderizado dinámicamente -->
              <div class="wf-bar wf-graphql" style="width: 25%;">
                <span>POST /graphql (28ms)</span>
              </div>
            </div>
          </div>

          <!-- TERMINAL JSON -->
          <div class="json-terminal">
            <pre><code id="json-output">// Hacé clic en "Ejecutar y Comparar" para ver los datos devueltos.</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN EDUCATIVA: EXPLICACIÓN DE ARQUITECTURA -->
    <section class="edu-card">
      <h2>Conceptos clave: ¿Cuándo conviene cada uno?</h2>
      <div class="edu-grid">
        <div class="edu-col">
          <div class="edu-tag tag-graphql">GraphQL</div>
          <h3>Ventajas competitivas</h3>
          <ul>
            <li><strong>Ideal para clientes móviles:</strong> Minimiza el consumo de batería y datos móviles al recortar campos no visibles en pantalla.</li>
            <li><strong>Fin del versionado de APIs:</strong> No hace falta crear <code>/v1/</code>, <code>/v2/</code>; simplemente se deprecian campos en el esquema.</li>
            <li><strong>Single Round-trip:</strong> Resuelve relaciones complejas en un solo viaje HTTP gracias al árbol de resolvers.</li>
          </ul>
        </div>

        <div class="edu-col">
          <div class="edu-tag tag-rest">REST</div>
          <h3>Ventajas competitivas</h3>
          <ul>
            <li><strong>Caché HTTP nativa:</strong> Permite que proxies, CDNs (Cloudflare/CloudFront) y navegadores guarden en caché respuestas <code>GET</code> fácilmente.</li>
            <li><strong>Simplicidad y tooling:</strong> Sin librerías complejas en cliente; llamadas estándar con <code>fetch()</code> o <code>curl</code>.</li>
            <li><strong>Protección contra ataques:</strong> En GraphQL una consulta anidada recursiva puede tumbar el servidor; REST tiene endpoints de complejidad predecible.</li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initSoundControls } from '../lib/soundControls.js';
  import { getApiBaseUrl, fetchWithTimeout, showBackendErrorBanner, hideBackendErrorBanner } from '../lib/apiClient.js';

  const sound = initSoundControls();
  const API_BASE = getApiBaseUrl();

  let activeMode = 'graphql';
  let simulationCompleted = false;

  const btnModeGraphql = document.getElementById('btn-mode-graphql');
  const btnModeRest = document.getElementById('btn-mode-rest');
  const graphqlBuilder = document.getElementById('graphql-builder');
  const restMap = document.getElementById('rest-map');
  const leftCardTitle = document.getElementById('left-card-title');
  const queryModeBadge = document.getElementById('query-mode-badge');
  const btnExecute = document.getElementById('btn-execute');
  const queryText = document.getElementById('query-text');
  const jsonOutput = document.getElementById('json-output');
  const waterfallTrack = document.getElementById('waterfall-track');

  // Metricas
  const valRequests = document.getElementById('val-requests');
  const subRequests = document.getElementById('sub-requests');
  const valBytes = document.getElementById('val-bytes');
  const subBytes = document.getElementById('sub-bytes');
  const valLatency = document.getElementById('val-latency');
  const subLatency = document.getElementById('sub-latency');
  const valWasted = document.getElementById('val-wasted');
  const subWasted = document.getElementById('sub-wasted');

  // Checkboxes
  const chkNombre = document.getElementById('chk-nombre');
  const chkEmail = document.getElementById('chk-email');
  const chkRol = document.getElementById('chk-rol');
  const chkAvatar = document.getElementById('chk-avatar');
  const chkBio = document.getElementById('chk-bio');
  const chkUbicacion = document.getElementById('chk-ubicacion');
  const chkIncludeArticles = document.getElementById('chk-include-articles');
  const chkArtTitulo = document.getElementById('chk-art-titulo');
  const chkArtVistas = document.getElementById('chk-art-vistas');
  const chkArtLikes = document.getElementById('chk-art-likes');

  function getSelectedFields() {
    const fields = [];
    if (chkNombre?.checked) fields.push('nombre');
    if (chkEmail?.checked) fields.push('email');
    if (chkRol?.checked) fields.push('rol');
    if (chkAvatar?.checked) fields.push('avatar');
    if (chkBio?.checked) fields.push('bio');
    if (chkUbicacion?.checked) fields.push('ubicacion');

    const articleFields = [];
    if (chkArtTitulo?.checked) articleFields.push('titulo');
    if (chkArtVistas?.checked) articleFields.push('vistas');
    if (chkArtLikes?.checked) articleFields.push('likes');

    return {
      fields: fields.length > 0 ? fields : ['nombre'],
      includeArticles: Boolean(chkIncludeArticles?.checked),
      articleFields: articleFields.length > 0 ? articleFields : ['titulo'],
    };
  }

  function updateQueryPreview() {
    const { fields, includeArticles, articleFields } = getSelectedFields();
    let q = 'query {\n  author {\n';
    fields.forEach((f) => { q += `    ${f}\n`; });
    if (includeArticles) {
      q += '    articulos {\n';
      articleFields.forEach((af) => { q += `      ${af}\n`; });
      q += '    }\n';
    }
    q += '  }\n}';
    if (queryText) queryText.innerHTML = `<code>${q}</code>`;
  }

  document.querySelectorAll('.field-chk input').forEach((chk) => {
    chk.addEventListener('change', updateQueryPreview);
  });

  function switchMode(mode) {
    activeMode = mode;
    sound.play('playStep');

    btnModeGraphql?.classList.toggle('active', mode === 'graphql');
    btnModeRest?.classList.toggle('active', mode === 'rest');

    if (mode === 'graphql') {
      if (graphqlBuilder) graphqlBuilder.style.display = 'block';
      if (restMap) restMap.style.display = 'none';
      if (leftCardTitle) leftCardTitle.textContent = 'Constructor de Consulta (GraphQL Query)';
      if (queryModeBadge) {
        queryModeBadge.textContent = 'POST /graphql';
        queryModeBadge.className = 'badge-mini';
      }
    } else {
      if (graphqlBuilder) graphqlBuilder.style.display = 'none';
      if (restMap) restMap.style.display = 'block';
      if (leftCardTitle) leftCardTitle.textContent = 'Flujo Secuencial de Endpoints REST';
      if (queryModeBadge) {
        queryModeBadge.textContent = '3x GET Endpoints';
        queryModeBadge.className = 'badge-mini badge-warning';
      }
    }
  }

  btnModeGraphql?.addEventListener('click', () => switchMode('graphql'));
  btnModeRest?.addEventListener('click', () => switchMode('rest'));

  async function executeComparison() {
    sound.play('playStep');
    if (btnExecute) btnExecute.disabled = true;

    if (activeMode === 'graphql') {
      const selected = getSelectedFields();

      try {
        const res = await fetchWithTimeout(
          `${API_BASE}/api/graphql-demo/query`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(selected),
          },
          3000
        );
        hideBackendErrorBanner('graphql-backend-error');
        const data = await res.json();
        renderGraphqlResult(data);
      } catch {
        showBackendErrorBanner('graphql-backend-error', 'Backend offline. Ejecutando simulación en cliente.');
        // Fallback local
        const mockData = {
          mode: 'graphql',
          httpRequests: 1,
          byteSize: 215,
          simulatedLatencyMs: 28,
          data: {
            author: {
              nombre: 'Sofía Valenzuela',
              email: 'sofia.valenzuela@runlearn.dev',
              articulos: [{ titulo: 'Mitigando ataques DDoS con Token Bucket' }],
            },
          },
        };
        renderGraphqlResult(mockData);
      }
    } else {
      // Modo REST
      try {
        const res = await fetchWithTimeout(
          `${API_BASE}/api/graphql-demo/rest`,
          { method: 'GET' },
          3000
        );
        hideBackendErrorBanner('graphql-backend-error');
        const data = await res.json();
        renderRestResult(data);
      } catch {
        showBackendErrorBanner('graphql-backend-error', 'Backend offline. Ejecutando simulación en cliente.');
        // Fallback local REST
        const mockData = {
          mode: 'rest',
          httpRequests: 3,
          byteSize: 4890,
          simulatedLatencyMs: 145,
          data: {
            step1_author: { id: 1, nombre: 'Sofía Valenzuela', email: '...', bio: '...', preferences: '...' },
            step2_articles: [{ id: 101, titulo: '...', contenidoExtenso: 'Lorem ipsum...' }],
            step3_stats: { views: 4820, likes: 342 },
          },
        };
        renderRestResult(mockData);
      }
    }

    if (btnExecute) btnExecute.disabled = false;

    if (!simulationCompleted) {
      simulationCompleted = true;
      setTimeout(() => {
        window.dispatchEvent(new Event('runlearn:simulation-complete'));
      }, 1200);
    }
  }

  function renderGraphqlResult(data) {
    if (valRequests) valRequests.textContent = '1 HTTP';
    if (subRequests) subRequests.textContent = '1 solo viaje cliente-servidor';

    if (valBytes) {
      valBytes.textContent = `${data.byteSize} B`;
      valBytes.className = 'metric-value highlight';
    }
    if (subBytes) subBytes.textContent = '95% menos ancho de banda';

    if (valLatency) valLatency.textContent = `~${data.simulatedLatencyMs} ms`;
    if (subLatency) subLatency.textContent = 'Sin bloqueo secuencial N+1';

    if (valWasted) valWasted.textContent = '0 campos';
    if (subWasted) subWasted.textContent = 'Cada campo recibido fue solicitado';

    if (waterfallTrack) {
      waterfallTrack.innerHTML = `
        <div class="wf-bar wf-graphql" style="width: 25%;">
          <span>POST /graphql (${data.simulatedLatencyMs}ms)</span>
        </div>
      `;
    }

    if (jsonOutput) {
      jsonOutput.textContent = JSON.stringify(data.data, null, 2);
    }
  }

  function renderRestResult(data) {
    if (valRequests) valRequests.textContent = '3 HTTPs';
    if (subRequests) subRequests.textContent = 'Peticiones en cascada (N+1)';

    if (valBytes) {
      valBytes.textContent = `${(data.byteSize / 1024).toFixed(1)} KB`;
      valBytes.className = 'metric-value warning';
    }
    if (subBytes) subBytes.textContent = 'Over-fetching: 30+ campos inútiles';

    if (valLatency) valLatency.textContent = `~${data.simulatedLatencyMs} ms`;
    if (subLatency) subLatency.textContent = 'Suma de 3 round-trips de red';

    if (valWasted) valWasted.textContent = '28 campos';
    if (subWasted) subWasted.textContent = 'Desperdicio de CPU, batería y red';

    if (waterfallTrack) {
      waterfallTrack.innerHTML = `
        <div class="wf-bar wf-rest" style="width: 32%; margin-left: 0;">
          <span>1. GET /author (42ms)</span>
        </div>
        <div class="wf-bar wf-rest" style="width: 45%; margin-left: 25%;">
          <span>2. GET /articles (68ms)</span>
        </div>
        <div class="wf-bar wf-rest" style="width: 28%; margin-left: 55%;">
          <span>3. GET /stats (35ms)</span>
        </div>
      `;
    }

    if (jsonOutput) {
      jsonOutput.textContent = JSON.stringify(data.data, null, 2);
    }
  }

  btnExecute?.addEventListener('click', executeComparison);
  updateQueryPreview();
</script>

<style>
  .api-page {
    width: min(1200px, calc(100% - 32px));
    margin: 24px auto 80px;
    color: var(--text-primary);
  }

  .topbar {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 18px;
    background: var(--surface-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }

  .topbar-main, .topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-white);
    text-decoration: none;
    font-weight: 800;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: #60a5fa;
    color: #111;
    font: 700 11px var(--font-mono);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover, .crumbs .current { color: var(--text-primary); }

  .sound-btn, .home-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font: 600 12px var(--font-main);
    cursor: pointer;
    text-decoration: none;
  }

  .sound-btn:hover, .home-action:hover {
    color: var(--text-white);
    border-color: var(--border-hover);
  }

  .badge-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgba(96, 165, 250, 0.12);
    border: 1px solid rgba(96, 165, 250, 0.3);
    border-radius: var(--radius-pill);
    color: #60a5fa;
    font: 700 10px var(--font-mono);
    text-transform: uppercase;
  }

  .badge-live .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 8px #60a5fa;
  }

  .lesson-header {
    margin: 32px 0 24px;
  }

  .badge-tag {
    display: inline-block;
    color: #60a5fa;
    font: 700 11px var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .lesson-header h1 {
    font-size: clamp(32px, 5vw, 44px);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -.03em;
  }

  .lede {
    max-width: 860px;
    margin: 14px 0 0;
    color: var(--text-secondary);
    font-size: clamp(15px, 1.8vw, 17px);
    line-height: 1.65;
  }

  /* PARADIGM SELECTOR */
  .paradigm-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 24px 0;
  }

  .paradigm-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--surface-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    cursor: pointer;
