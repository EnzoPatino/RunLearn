---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import TechCard from '../components/TechCard.astro';
import ClassIcon from '../components/ClassIcon.astro';
import { categoriasClases, clasesRecientes } from '../data/clases.js';
---

<Layout title="RunLearn - Clases">
  <Navbar />

  <section class="classes-hero" aria-labelledby="recent-classes-title">
    <div class="classes-heading">
      <div>
        <span class="eyebrow">Recientes</span>
        <h1 id="recent-classes-title">Clases</h1>
      </div>

      <div class="carousel-controls" aria-label="Controles del carrusel">
        <button class="carousel-btn" type="button" data-carousel-prev aria-label="Ver clases anteriores">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.707 4.293a1 1 0 010 1.414L8.414 10l4.293 4.293a1 1 0 01-1.414 1.414l-5-5a1 1 0 010-1.414l5-5a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </button>
        <button class="carousel-btn" type="button" data-carousel-next aria-label="Ver clases siguientes">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 15.707a1 1 0 010-1.414L11.586 10 7.293 5.707a1 1 0 111.414-1.414l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>

    <div class="recent-carousel" data-carousel tabindex="0">
      {clasesRecientes.map((clase) => (
        <a
          class="recent-card"
          href={clase.route}
          style={`--theme-color: ${clase.colorAccent}; --theme-glow: color-mix(in srgb, ${clase.colorAccent} 22%, transparent);`}
        >
          <div class="recent-icon">
            <ClassIcon name={clase.icon} />
          </div>
          <div class="recent-copy">
            <span>{clase.category}</span>
            <strong>{clase.title}</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="classes-library" aria-labelledby="all-classes-title">
    <div class="classes-heading classes-heading--compact">
      <div>
        <span class="eyebrow">Biblioteca</span>
        <h2 id="all-classes-title">Todas las clases</h2>
      </div>
    </div>

    <div class="filter-chips" aria-label="Filtros por categoría">
      <button class="filter-chip is-active" type="button" data-filter="all">Todas</button>
      {categoriasClases.map((categoria) => (
        <button class="filter-chip" type="button" data-filter={categoria}>{categoria}</button>
      ))}
    </div>

    <div class="classes-grid" data-classes-grid>
      {clasesRecientes.map((clase) => (
        <div class="class-grid-item" data-category={clase.category}>
          <TechCard
            id={clase.id}
            badge={clase.category}
            title={clase.title}
            meta={clase.description}
            themeColor={clase.colorAccent}
            href={clase.route}
            icon={clase.icon}
          />
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .classes-hero,
  .classes-library {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .classes-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .classes-heading--compact {
    align-items: center;
  }

  .eyebrow {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  h1,
  h2 {
    margin: 0;
    color: var(--text-primary);
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .carousel-btn {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--ease-fast);
  }

  .carousel-btn:hover,
  .carousel-btn:focus-visible {
    color: var(--text-white);
    border-color: var(--border-hover);
    background: rgba(255, 255, 255, 0.07);
    outline: none;
  }

  .carousel-btn svg {
    width: 18px;
    height: 18px;
  }

  .recent-carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 28vw);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    padding-bottom: 0.25rem;
  }

  .recent-card {
    min-height: 116px;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-card), var(--glass-highlight);
    transition: transform var(--ease-spring), border-color var(--ease-spring), background-color var(--ease-fast), box-shadow var(--ease-spring);
  }

  .recent-card:hover,
  .recent-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--theme-color);
    background: var(--surface-card-hover);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.7), 0 0 24px -2px var(--theme-glow);
    outline: none;
  }

  .recent-icon {
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--theme-color);
  }

  .recent-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .recent-copy span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .recent-copy strong {
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.2;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-chip {
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    padding: 0.45rem 0.8rem;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--ease-fast);
  }

  .filter-chip:hover,
  .filter-chip:focus-visible,
  .filter-chip.is-active {
    color: var(--text-white);
    border-color: rgba(59, 130, 246, 0.35);
    background: rgba(59, 130, 246, 0.16);
    outline: none;
  }

  .classes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .class-grid-item.is-hidden {
    display: none;
  }

  @media (max-width: 960px) {
    .recent-carousel {
      grid-auto-columns: minmax(210px, 44vw);
    }

    .classes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .classes-heading {
      align-items: flex-start;
    }

    .recent-carousel {
      grid-auto-columns: minmax(190px, 78vw);
      gap: 0.65rem;
    }

    .classes-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }

    .carousel-controls {
      display: none;
    }
  }
</style>

<script>
  const carousel = document.querySelector('[data-carousel]');
  const previousButton = document.querySelector('[data-carousel-prev]');
  const nextButton = document.querySelector('[data-carousel-next]');

  function scrollCarousel(direction) {
    if (!carousel) return;
    const distance = Math.round(carousel.clientWidth * 0.8);
    carousel.scrollBy({ left: direction * distance, behavior: 'smooth' });
  }

  previousButton?.addEventListener('click', () => scrollCarousel(-1));
  nextButton?.addEventListener('click', () => scrollCarousel(1));

  const filterButtons = document.querySelectorAll('[data-filter]');
  const classItems = document.querySelectorAll('[data-category]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory = button.getAttribute('data-filter');

      filterButtons.forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');

      classItems.forEach((item) => {
        const shouldShow = selectedCategory === 'all' || item.getAttribute('data-category') === selectedCategory;
        item.classList.toggle('is-hidden', !shouldShow);
      });
    });
  });
</script>
