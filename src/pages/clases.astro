---
// src/pages/clases.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { clases, categoriasClases, categoryColors } from '../data/clases.js';

const totalClases = clases.length;
---

<Layout title="RunLearn – Catálogo de Clases">
  <Navbar />

  <section id="clases" class="classes-section">
    <!-- Encabezado con contador dinámico -->
    <div class="eyebrow" id="count">Biblioteca · {totalClases} clases</div>
    <h1 class="classes-title">Todas las <em>clases</em></h1>

    <!-- Barra de progreso del alumno -->
    <div class="progress-tracker" id="progress-tracker">
      <div class="progress-meta">
        <span class="progress-title">Tu avance del curso</span>
        <span class="progress-val" id="progress-val">0 / {totalClases} (0%)</span>
      </div>
      <div class="progress-bar-wrap" role="progressbar" aria-valuemin="0" aria-valuemax={totalClases} aria-valuenow="0">
        <div class="progress-bar-fill" id="progress-bar-fill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Barra de búsqueda y chips de categoría -->
    <div class="bar">
      <label class="search" for="q">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input
          id="q"
          placeholder="Buscar clase…"
          aria-label="Buscar clase por nombre o descripción"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd>/</kbd>
      </label>

      <div class="chips" id="chips" role="group" aria-label="Filtrar por categoría">
        <button
          class="chip is-active"
          style={`--c: var(--lime);`}
          data-c="Todas"
          aria-pressed="true"
        >
          <i></i>Todas
        </button>
        {categoriasClases.map((cat) => {
          const color = categoryColors[cat] || "var(--lime)";
          return (
            <button
              class="chip"
              style={`--c: ${color};`}
              data-c={cat}
              aria-pressed="false"
            >
              <i></i>{cat}
            </button>
          );
        })}
      </div>
    </div>

    <!-- Grilla de clases interactiva -->
    <div class="grid" id="grid">
      {clases.map((clase) => {
        const color = clase.colorAccent || categoryColors[clase.category] || "var(--lime)";
        return (
          <a
            class="card"
            href={clase.route}
            style={`--c: ${color};`}
            data-id={clase.id}
            data-title={clase.title}
            data-category={clase.category}
            data-desc={clase.description}
            data-command={clase.snippetCmd}
            data-result={clase.snippetResult}
          >
            <div class="ctop">
              <span class="tag">
                <i></i>{clase.category}
              </span>
              <div class="ctop-actions">
                <button
                  class="card-check"
                  type="button"
                  data-check-id={clase.id}
                  title="Marcar clase como completada"
                  aria-label={`Marcar ${clase.title} como completada`}
                >
                  <svg viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </button>
                <span class="go" aria-hidden="true">↗</span>
              </div>
            </div>

            <h3>{clase.title}</h3>
            <p>{clase.description}</p>

            <div class="mini">
              <div class="c">{clase.snippetCmd}</div>
              <div class="r">
                <span class={clase.snippetOk ? "ok" : "bad"}>
                  {clase.snippetOk ? "✓" : "✗"}
                </span>{" "}
                {clase.snippetResult}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Mensaje cuando no hay resultados (oculto por defecto) -->
    <div class="empty" id="empty-state" hidden>
      <strong>No encontramos clases</strong>
      <span>Probá con otro término o cambiá el filtro de categoría.</span>
    </div>
  </section>
</Layout>

<style>
  .classes-section {
    width: 100%;
    position: relative;
    animation: pg .4s both;
  }

  @keyframes pg {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .classes-title {
    font-size: clamp(34px, 5.4vw, 60px);
    margin: 10px 0 20px;
    letter-spacing: -.03em;
  }

  /* Progreso del curso */
  .progress-tracker {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px 18px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-family: var(--m);
  }

  .progress-title {
    color: var(--mut);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-size: 11px;
    font-weight: 600;
  }

  .progress-val {
    color: var(--lime);
    font-weight: 700;
  }

  .progress-bar-wrap {
    width: 100%;
    height: 6px;
    background: #070806;
    border-radius: 99px;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--lime);
    box-shadow: 0 0 10px rgba(198, 244, 50, 0.4);
    border-radius: 99px;
    transition: width .4s var(--ease-spring);
  }

  .ctop-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-check {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: transparent;
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
    transition: all .2s ease;
    z-index: 2;
  }

  .card-check svg {
    width: 14px;
    height: 14px;
  }

  .card-check:hover {
    border-color: var(--lime);
    background: rgba(198, 244, 50, 0.1);
    color: var(--lime);
  }

  .card-check.active {
    background: var(--lime);
    border-color: var(--lime);
    color: #0b0c0a;
    box-shadow: 0 0 10px rgba(198, 244, 50, 0.35);
  }

  .card.is-done {
    border-color: rgba(198, 244, 50, 0.3);
  }

  .bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin: 20px 0 26px;
  }

  .search {
    flex: 1 1 260px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0 14px;
    min-height: 48px;
    cursor: text;
    transition: border-color .2s;
  }

  .search:focus-within {
    border-color: var(--lime);
  }

  .search-icon {
    font-size: 18px;
    color: var(--mut);
    line-height: 1;
  }

  .search input {
    all: unset;
    flex: 1;
    font-family: var(--m);
    font-size: 14px;
    color: var(--fg);
    min-height: 44px;
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    max-width: 100%;
    scrollbar-width: thin;
  }

  .chip {
    all: unset;
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--f);
    font-size: 13px;
    font-weight: 500;
    color: var(--mut);
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 0 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: border-color .2s, color .2s, background-color .2s;
    box-sizing: border-box;
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--c);
  }

  .chip[aria-pressed="true"],
  .chip.is-active {
    background: var(--c);
    color: #0b0c0a;
    border-color: var(--c);
    font-weight: 700;
  }

  .chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
  }

  .chip[aria-pressed="true"] i,
  .chip.is-active i {
    background: #0b0c0a;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }

  .card {
    position: relative;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    transition: transform .25s ease, border-color .25s ease;
    min-height: 216px;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--c) 16%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--c);
  }

  .card:hover::before {
    opacity: 1;
  }

  .ctop {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tag {
    font-family: var(--m);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--c);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tag i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c);
  }

  .go {
    color: var(--mut);
    font-size: 16px;
    transition: transform .25s ease, color .25s ease;
  }

  .card:hover .go {
    color: var(--c);
    transform: translate(3px, -3px);
  }

  .card h3 {
    margin: 6px 0 0;
    font-size: 22px;
    letter-spacing: -.02em;
    font-family: var(--f);
    font-weight: 700;
    color: var(--fg);
  }

  .card p {
    margin: 0;
    font-size: 14px;
    color: var(--mut);
    line-height: 1.45;
  }

  .mini {
    margin-top: auto;
    font-family: var(--m);
    font-size: 12px;
    line-height: 1.6;
    background: #070806;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: #cfd5c4;
    overflow: hidden;
  }

  .mini .c {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini .c::before {
    content: "$ ";
    color: var(--lime);
    font-weight: bold;
  }

  .mini .r {
    opacity: 0;
    max-height: 0;
    transition: opacity .3s ease, max-height .3s ease, margin-top .3s ease;
    white-space: normal;
  }

  .card:hover .r,
  .card:focus-visible .r {
    opacity: 1;
    max-height: 60px;
    margin-top: 4px;
  }

  @media (pointer: coarse) {
    .mini .r {
      opacity: 1;
      max-height: 60px;
      margin-top: 4px;
    }
  }

  .ok {
    color: #34d399;
    font-weight: bold;
  }

  .bad {
    color: var(--bad);
    font-weight: bold;
  }

  .empty {
    color: var(--mut);
    padding: 48px 0;
    text-align: center;
    font-size: 15px;
    border: 1px dashed var(--line);
    border-radius: 16px;
    margin-top: 10px;
  }

  .empty strong,
  .empty span {
    display: block;
  }

  .empty strong {
    color: var(--fg);
    margin-bottom: 5px;
  }

  .empty span {
    font-size: 13px;
  }

  .card.is-hidden {
    display: none !important;
  }
</style>

<script>
  import sounds from '../lib/sounds.js';
  import { getProgreso, toggleProgresoClase } from '../lib/progreso.js';

  const countEl = document.getElementById('count');
  const searchInput = document.getElementById('q');
  const chipsContainer = document.getElementById('chips');
  const gridContainer = document.getElementById('grid');
  const emptyState = document.getElementById('empty-state');
  const cards = Array.from(document.querySelectorAll('.card'));
  const totalCards = cards.length;

  let activeCategory = 'Todas';
  let searchTerm = '';
  const normalize = (value) => String(value || '')
    .toLocaleLowerCase('es')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

  function filterCards() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const searchableText = normalize([
        card.dataset.title,
        card.dataset.category,
        card.dataset.desc,
        card.dataset.command,
        card.dataset.result,
      ].join(' '));
      const cardCategory = card.dataset.category || '';

      const matchesCategory = activeCategory === 'Todas' || cardCategory === activeCategory;
      const matchesSearch =
        searchTerm === '' ||
        searchableText.includes(searchTerm);

      const isVisible = matchesCategory && matchesSearch;
      card.classList.toggle('is-hidden', !isVisible);

      if (isVisible) visibleCount++;
    });

    if (countEl) {
      countEl.textContent = `Biblioteca · ${visibleCount} de ${totalCards} clases`;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  }

  async function syncProgresoUI() {
    const progreso = await getProgreso();
    let completedCount = 0;

    cards.forEach((card) => {
      const id = card.dataset.id;
      const isDone = Boolean(progreso[id]);
      card.classList.toggle('is-done', isDone);
      const checkBtn = card.querySelector('.card-check');
      if (checkBtn) {
        checkBtn.classList.toggle('active', isDone);
        checkBtn.setAttribute('aria-pressed', String(isDone));
      }
      if (isDone) completedCount++;
    });

    const percent = totalCards > 0 ? Math.round((completedCount / totalCards) * 100) : 0;
    const progressVal = document.getElementById('progress-val');
    const progressFill = document.getElementById('progress-bar-fill');
    if (progressVal) progressVal.textContent = `${completedCount} / ${totalCards} (${percent}%)`;
    if (progressFill) progressFill.style.width = `${percent}%`;
  }

  // Interacción de chips de categoría
  chipsContainer?.addEventListener('click', (e) => {
    const btn = e.target.closest('.chip');
    if (!btn) return;

    activeCategory = btn.dataset.c || 'Todas';

    document.querySelectorAll('.chip').forEach((chip) => {
      const isSelected = chip === btn;
      chip.setAttribute('aria-pressed', String(isSelected));
      chip.classList.toggle('is-active', isSelected);
    });

    try { sounds.playStep(); } catch {}
    filterCards();
  });

  // Búsqueda en vivo
  searchInput?.addEventListener('input', (e) => {
    searchTerm = normalize(e.target.value.trim());
    filterCards();
  });

  // Interacción para marcar clase completada
  gridContainer?.addEventListener('click', async (e) => {
    const checkBtn = e.target.closest('.card-check');
    if (!checkBtn) return;
    e.preventDefault();
    e.stopPropagation();

    const id = checkBtn.dataset.checkId;
    if (!id) return;

    try {
      sounds.playSuccess();
    } catch {}

    await toggleProgresoClase(id);
    syncProgresoUI();
  });

  // Foco dinámico para el resplandor de la tarjeta (spotlight en hover solo con mouse)
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    gridContainer?.addEventListener('pointermove', (e) => {
      const card = e.target.closest('.card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
      card.style.setProperty('--my', (e.clientY - rect.top) + 'px');
    }, { passive: true });
  }

  // Atajo de teclado: presionar '/' para enfocar el buscador
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement?.tagName || '')) {
      e.preventDefault();
      searchInput?.focus();
      try { sounds.playStep(); } catch {}
    }
  });

  window.addEventListener('runlearn:progreso-updated', syncProgresoUI);
  window.addEventListener('auth-change', syncProgresoUI);

  // Inicializar estado
  filterCards();
  syncProgresoUI();
</script>
