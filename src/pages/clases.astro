---
// src/pages/clases.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { clases, categoriasClases, categoryColors } from '../data/clases.js';

const totalClases = clases.length;
---

<Layout title="RunLearn – Catálogo de Clases">
  <Navbar />

  <section id="clases" class="classes-section">
    <!-- Encabezado con contador dinámico -->
    <div class="eyebrow" id="count">Biblioteca · {totalClases} clases</div>
    <h1 class="classes-title">Todas las <em>clases</em></h1>

    <!-- Barra de búsqueda y chips de categoría -->
    <div class="bar">
      <label class="search" for="q">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input
          id="q"
          placeholder="Buscar clase…"
          aria-label="Buscar clase por nombre o descripción"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd>/</kbd>
      </label>

      <div class="chips" id="chips" role="group" aria-label="Filtrar por categoría">
        <button
          class="chip is-active"
          style={`--c: var(--lime);`}
          data-c="Todas"
          aria-pressed="true"
        >
          <i></i>Todas
        </button>
        {categoriasClases.map((cat) => {
          const color = categoryColors[cat] || "var(--lime)";
          return (
            <button
              class="chip"
              style={`--c: ${color};`}
              data-c={cat}
              aria-pressed="false"
            >
              <i></i>{cat}
            </button>
          );
        })}
      </div>
    </div>

    <!-- Grilla de clases interactiva -->
    <div class="grid" id="grid">
      {clases.map((clase) => {
        const color = clase.colorAccent || categoryColors[clase.category] || "var(--lime)";
        return (
          <a
            class="card"
            href={clase.route}
            style={`--c: ${color};`}
            data-title={clase.title.toLowerCase()}
            data-category={clase.category}
            data-desc={clase.description.toLowerCase()}
          >
            <div class="ctop">
              <span class="tag">
                <i></i>{clase.category}
              </span>
              <span class="go" aria-hidden="true">↗</span>
            </div>

            <h3>{clase.title}</h3>
            <p>{clase.description}</p>

            <div class="mini">
              <div class="c">{clase.snippetCmd}</div>
              <div class="r">
                <span class={clase.snippetOk ? "ok" : "bad"}>
                  {clase.snippetOk ? "✓" : "✗"}
                </span>{" "}
                {clase.snippetResult}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Mensaje cuando no hay resultados (oculto por defecto) -->
    <div class="empty" id="empty-state" hidden>
      Sin resultados. Probá otra búsqueda o seleccioná «Todas».
    </div>
  </section>
</Layout>

<style>
  .classes-section {
    width: 100%;
    position: relative;
    animation: pg .4s both;
  }

  @keyframes pg {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .classes-title {
    font-size: clamp(34px, 5.4vw, 60px);
    margin: 10px 0 20px;
    letter-spacing: -.03em;
  }

  .bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin: 20px 0 26px;
  }

  .search {
    flex: 1 1 260px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0 14px;
    min-height: 48px;
    cursor: text;
    transition: border-color .2s;
  }

  .search:focus-within {
    border-color: var(--lime);
  }

  .search-icon {
    font-size: 18px;
    color: var(--mut);
    line-height: 1;
  }

  .search input {
    all: unset;
    flex: 1;
    font-family: var(--m);
    font-size: 14px;
    color: var(--fg);
    min-height: 44px;
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    max-width: 100%;
    scrollbar-width: thin;
  }

  .chip {
    all: unset;
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--f);
    font-size: 13px;
    font-weight: 500;
    color: var(--mut);
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 0 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: border-color .2s, color .2s, background-color .2s;
    box-sizing: border-box;
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--c);
  }

  .chip[aria-pressed="true"],
  .chip.is-active {
    background: var(--c);
    color: #0b0c0a;
    border-color: var(--c);
    font-weight: 700;
  }

  .chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
  }

  .chip[aria-pressed="true"] i,
  .chip.is-active i {
    background: #0b0c0a;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }

  .card {
    position: relative;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    transition: transform .25s ease, border-color .25s ease;
    min-height: 216px;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--c) 16%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--c);
  }

  .card:hover::before {
    opacity: 1;
  }

  .ctop {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tag {
    font-family: var(--m);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--c);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tag i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c);
  }

  .go {
    color: var(--mut);
    font-size: 16px;
    transition: transform .25s ease, color .25s ease;
  }

  .card:hover .go {
    color: var(--c);
    transform: translate(3px, -3px);
  }

  .card h3 {
    margin: 6px 0 0;
    font-size: 22px;
    letter-spacing: -.02em;
    font-family: var(--f);
    font-weight: 700;
    color: var(--fg);
  }

  .card p {
    margin: 0;
    font-size: 14px;
    color: var(--mut);
    line-height: 1.45;
  }

  .mini {
    margin-top: auto;
    font-family: var(--m);
    font-size: 12px;
    line-height: 1.6;
    background: #070806;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: #cfd5c4;
    overflow: hidden;
  }

  .mini .c {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini .c::before {
    content: "$ ";
    color: var(--lime);
    font-weight: bold;
  }

  .mini .r {
    opacity: 0;
    max-height: 0;
    transition: opacity .3s ease, max-height .3s ease, margin-top .3s ease;
    white-space: normal;
  }

  .card:hover .r,
  .card:focus-visible .r {
    opacity: 1;
    max-height: 60px;
    margin-top: 4px;
  }

  @media (pointer: coarse) {
    .mini .r {
      opacity: 1;
      max-height: 60px;
      margin-top: 4px;
    }
  }

  .ok {
    color: #34d399;
    font-weight: bold;
  }

  .bad {
    color: var(--bad);
    font-weight: bold;
  }

  .empty {
    color: var(--mut);
    padding: 48px 0;
    text-align: center;
    font-size: 15px;
    border: 1px dashed var(--line);
    border-radius: 16px;
    margin-top: 10px;
  }

  .card.is-hidden {
    display: none !important;
  }
</style>

<script>
  import sounds from '../lib/sounds.js';

  const countEl = document.getElementById('count');
  const searchInput = document.getElementById('q');
  const chipsContainer = document.getElementById('chips');
  const gridContainer = document.getElementById('grid');
  const emptyState = document.getElementById('empty-state');
  const cards = Array.from(document.querySelectorAll('.card'));
  const totalCards = cards.length;

  let activeCategory = 'Todas';
  let searchTerm = '';

  function filterCards() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardTitle = card.dataset.title || '';
      const cardCategory = card.dataset.category || '';
      const cardDesc = card.dataset.desc || '';

      const matchesCategory = activeCategory === 'Todas' || cardCategory === activeCategory;
      const matchesSearch =
        searchTerm === '' ||
        cardTitle.includes(searchTerm) ||
        cardDesc.includes(searchTerm) ||
        cardCategory.toLowerCase().includes(searchTerm);

      const isVisible = matchesCategory && matchesSearch;
      card.classList.toggle('is-hidden', !isVisible);

      if (isVisible) visibleCount++;
    });

    if (countEl) {
      countEl.textContent = `Biblioteca · ${visibleCount} de ${totalCards} clases`;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  }

  // Interacción de chips de categoría
  chipsContainer?.addEventListener('click', (e) => {
    const btn = e.target.closest('.chip');
    if (!btn) return;

    activeCategory = btn.dataset.c || 'Todas';

    document.querySelectorAll('.chip').forEach((chip) => {
      const isSelected = chip === btn;
      chip.setAttribute('aria-pressed', String(isSelected));
      chip.classList.toggle('is-active', isSelected);
    });

    try { sounds.playStep(); } catch {}
    filterCards();
  });

  // Búsqueda en vivo
  searchInput?.addEventListener('input', (e) => {
    searchTerm = e.target.value.toLowerCase().trim();
    filterCards();
  });

  // Foco dinámico para el resplandor de la tarjeta (spotlight en hover)
  gridContainer?.addEventListener('pointermove', (e) => {
    const card = e.target.closest('.card');
    if (!card) return;
    const rect = card.getBoundingClientRect();
    card.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
    card.style.setProperty('--my', (e.clientY - rect.top) + 'px');
  });

  // Atajo de teclado: presionar '/' para enfocar el buscador
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement?.tagName || '')) {
      e.preventDefault();
      searchInput?.focus();
      try { sounds.playStep(); } catch {}
    }
  });

  // Inicializar estado
  filterCards();
</script>
