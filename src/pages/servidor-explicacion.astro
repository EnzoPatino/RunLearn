---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RunLearn — Cómo funciona el Servidor">
  <div class="api-page">
    <div class="topbar">
      <div class="topbar-main">
        <a class="brand-link" href="/" aria-label="Volver al inicio de RunLearn">
          <span class="brand-mark">RL</span>
          <span>RunLearn</span>
        </a>
        <div class="crumbs" aria-label="Ruta actual">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <span class="current">Servidor</span>
        </div>
      </div>
      <div class="topbar-actions">
        <a class="home-action" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10.8 9-7.2 9 7.2"/>
            <path d="M5.5 9.5V20h13V9.5"/>
            <path d="M9.5 20v-6h5v6"/>
          </svg>
          Inicio
        </a>
        <div class="badge-live"><span class="dot"></span>telemetría en vivo</div>
      </div>
    </div>

    <h1>Cómo funciona el Servidor</h1>
    <p class="lede">
      Un servidor backend no es solo una máquina remota: es un <strong>proceso Node.js continuo</strong> que mantiene un socket TCP abierto en el puerto <code>5000</code>, administra el Event Loop en memoria y coordina conexiones con PostgreSQL y Redis. Este panel consulta <code>/api/metrics</code> en tiempo real para mostrar su estado real y vivo.
    </p>

    <!-- Diagrama interactivo de arquitectura del servidor -->
    <div class="diagram-card">
      <div class="diagram" id="diagram">
        <svg class="lines">
          <line x1="9%" y1="50%" x2="91%" y2="50%" stroke="var(--api-line)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="node" id="node-cliente" style="left:9%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div class="label">Navegador</div>
        </div>

        <div class="node" id="node-servidor" style="left:36.3%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2" />
              <rect x="2" y="14" width="20" height="8" rx="2" />
              <line x1="6" y1="6" x2="6.01" y2="6" stroke-width="2.5" />
              <line x1="6" y1="18" x2="6.01" y2="18" stroke-width="2.5" />
              <line x1="10" y1="6" x2="14" y2="6" />
              <line x1="10" y1="18" x2="14" y2="18" />
            </svg>
          </div>
          <div class="label">Servidor :5000</div>
        </div>

        <div class="node" id="node-postgres" style="left:63.7%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="6" rx="7" ry="2.6"/>
              <path d="M5 6v12c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V6"/>
              <path d="M5 12c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6"/>
            </svg>
          </div>
          <div class="label">PostgreSQL</div>
        </div>

        <div class="node" id="node-redis" style="left:91%">
          <div class="icon-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"/>
              <polyline points="2 17 12 22 22 17"/>
              <polyline points="2 12 12 17 22 12"/>
            </svg>
          </div>
          <div class="label">Redis Caché</div>
        </div>

        <div class="packet" id="packet"></div>
      </div>
    </div>

    <div class="controls">
      <div class="controls-left">
        <button class="primary" id="btn-run">Simular ciclo de vida</button>
        <button class="ghost" id="btn-reset">Reiniciar</button>
        <button class="action-btn" id="btn-manual-ping">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          Petición manual (+1 request)
        </button>
      </div>
      <div class="controls-left">
        <div class="step-track" id="step-track"></div>
        <span class="step-count" id="step-count">0 / 5</span>
      </div>
    </div>

    <!-- SECCIÓN DE TELEMETRÍA EN VIVO -->
    <section class="live-dashboard" aria-label="Telemetría en Vivo del Servidor">
      <div class="live-header">
        <div class="live-header-info">
          <div class="status-indicator online" id="status-indicator">
            <span class="pulse-dot"></span>
            <span class="status-text" id="status-text">Conectando al servidor...</span>
          </div>
          <span class="sync-info" id="sync-info">Sondeando cada 3s</span>
        </div>
        <div class="live-header-actions">
          <span class="endpoint-badge">GET http://localhost:5000/api/metrics</span>
          <span class="timestamp-chip" id="last-sync-chip">Última sinc: --:--:--</span>
        </div>
      </div>

      <div class="metrics-grid">
        <!-- Card 1: Uptime -->
        <div class="metric-card uptime-card">
          <div class="metric-card-top">
            <span class="metric-title">Uptime del Proceso</span>
            <span class="metric-badge">process.uptime()</span>
          </div>
          <div class="metric-main-value" id="val-uptime-formatted">--m --s</div>
          <div class="metric-sub" id="val-uptime-seconds">0 segundos transcurridos</div>
          <div class="metric-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Tiempo continuo sin reinicios</span>
          </div>
        </div>

        <!-- Card 2: Requests -->
        <div class="metric-card requests-card" id="card-requests">
          <div class="metric-card-top">
            <span class="metric-title">Peticiones Atendidas</span>
            <span class="metric-badge highlight" id="req-delta-badge">En memoria</span>
          </div>
          <div class="metric-main-value highlight" id="val-requests">--</div>
          <div class="metric-sub">Peticiones recibidas desde el arranque</div>
          <div class="metric-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            <span>Incrementa con cada llamada al backend</span>
          </div>
        </div>

        <!-- Card 3: PostgreSQL -->
        <div class="metric-card service-card" id="card-pg">
          <div class="metric-card-top">
            <span class="metric-title">Base de Datos</span>
            <span class="metric-badge">PostgreSQL 16</span>
          </div>
          <div class="service-status-row">
            <div class="service-chip" id="chip-pg">
              <span class="chip-dot"></span>
              <span id="text-pg">Verificando...</span>
            </div>
          </div>
          <div class="metric-sub">Host: postgres | Puerto: 5432</div>
          <div class="metric-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span id="pg-pool-text">Pool activo (SELECT 1)</span>
          </div>
        </div>

        <!-- Card 4: Redis -->
        <div class="metric-card service-card" id="card-redis">
          <div class="metric-card-top">
            <span class="metric-title">Caché & Sesiones</span>
            <span class="metric-badge">Redis 7</span>
          </div>
          <div class="service-status-row">
            <div class="service-chip" id="chip-redis">
              <span class="chip-dot"></span>
              <span id="text-redis">Verificando...</span>
            </div>
          </div>
          <div class="metric-sub">Host: redis | Puerto: 6379</div>
          <div class="metric-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"/>
              <polyline points="2 17 12 22 22 17"/>
              <polyline points="2 12 12 17 22 12"/>
            </svg>
            <span id="redis-ping-text">Conexión viva (PING/PONG)</span>
          </div>
        </div>
      </div>

      <!-- Resumen secundario de sistema & JSON en vivo -->
      <div class="telemetry-details">
        <div class="telemetry-detail-item">
          <span class="detail-label">Plataforma / Runtime:</span>
          <span class="detail-value" id="val-runtime">Node.js (Linux)</span>
        </div>
        <div class="telemetry-detail-item">
          <span class="detail-label">Memoria RSS:</span>
          <span class="detail-value" id="val-mem-rss">-- MB</span>
        </div>
        <div class="telemetry-detail-item">
          <span class="detail-label">Heap Usado:</span>
          <span class="detail-value" id="val-mem-heap">-- MB</span>
        </div>
        <div class="telemetry-detail-item">
          <span class="detail-label">Timestamp del Servidor:</span>
          <span class="detail-value mono" id="val-timestamp">--</span>
        </div>
      </div>

      <!-- Visor de payload JSON -->
      <div class="json-inspector">
        <div class="json-header">
          <span class="json-title">Respuesta cruda de <code>/api/metrics</code> (actualizada en tiempo real)</span>
          <button class="json-copy-btn" id="btn-copy-json">Copiar JSON</button>
        </div>
        <pre class="json-code" id="raw-json">Cargando métricas del backend...</pre>
      </div>
    </section>

    <!-- Split: Código del endpoint vs Explicación conceptual -->
    <div class="split">
      <div class="panel">
        <div class="panel-head">
          <div class="tabs">
            <button class="tab active" data-tab="routes">routes/metrics.routes.js</button>
            <button class="tab" data-tab="middleware">metrics.js (contador)</button>
          </div>
          <span class="filename" id="code-filename">routes/metrics.routes.js</span>
        </div>

        <div id="tab-content-routes">
          <pre class="code"><span class="line" data-key="router"><span class="kw">router</span>.get(<span class="str">'/'</span>, <span class="kw">async</span> (req, res) =&gt; &#123;</span>
<span class="line" data-key="health">  <span class="comment">// 1. Verifica estado de Postgres y Redis concurrentemente</span></span>
<span class="line" data-key="health">  <span class="kw">const</span> [dbResult, redisResult] = <span class="kw">await</span> Promise.all([</span>
<span class="line" data-key="health">    checkDbConnection(),</span>
<span class="line" data-key="health">    checkRedisConnection()</span>
<span class="line" data-key="health">  ]);</span>
<span class="line" data-key="uptime">  <span class="comment">// 2. Extrae métricas del proceso en ejecución</span></span>
<span class="line" data-key="uptime">  <span class="kw">const</span> uptimeSeconds = Math.floor(process.uptime());</span>
<span class="line" data-key="uptime">  <span class="kw">const</span> mem = process.memoryUsage();</span>
<span class="line" data-key="response">  <span class="comment">// 3. Empaqueta telemetría y contador de requests</span></span>
<span class="line" data-key="response">  <span class="kw">return</span> res.json(&#123;</span>
<span class="line" data-key="response">    status: <span class="str">'ok'</span>,</span>
<span class="line" data-key="response">    timestamp: <span class="kw">new</span> Date().toISOString(),</span>
<span class="line" data-key="response">    uptime: uptimeSeconds,</span>
<span class="line" data-key="response">    requestsCount: getTotalRequests(),</span>
<span class="line" data-key="response">    services: &#123;</span>
<span class="line" data-key="response">      postgres: dbResult.ok ? <span class="str">'connected'</span> : <span class="str">'disconnected'</span>,</span>
<span class="line" data-key="response">      redis: redisResult.ok ? <span class="str">'connected'</span> : <span class="str">'disconnected'</span></span>
<span class="line" data-key="response">    &#125;</span>
<span class="line" data-key="response">  &#125;);</span>
<span class="line" data-key="router">&#125;);</span></pre>
        </div>

        <div id="tab-content-middleware" style="display:none">
          <pre class="code"><span class="line"><span class="kw">let</span> totalRequests = <span class="num">0</span>; <span class="comment">// Vive en la memoria del proceso Node.js</span></span>
<span class="line">&nbsp;</span>
<span class="line"><span class="comment">// Middleware global: se ejecuta antes de cada endpoint</span></span>
<span class="line"><span class="kw">export function</span> trackRequest(req, res, next) &#123;</span>
<span class="line">  totalRequests++; <span class="comment">// Incrementa el contador con cada petición</span></span>
<span class="line">  next();          <span class="comment">// Pasa el control a la siguiente ruta</span></span>
<span class="line">&#125;</span>
<span class="line">&nbsp;</span>
<span class="line"><span class="kw">export function</span> getTotalRequests() &#123;</span>
<span class="line">  <span class="kw">return</span> totalRequests;</span>
<span class="line">&#125;</span></pre>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <span class="title">Qué está pasando en el servidor</span>
        </div>
        <div class="explain-body">
          <div id="explain-idle" class="explain-idle">
            El servidor Express se ejecuta continuamente. Cada 3 segundos, este navegador consulta <code>/api/metrics</code> y los números de arriba cambian para reflejar el paso del tiempo y las peticiones reales procesadas.
          </div>
          <div id="explain-active" style="display:none">
            <div class="explain-tag" id="explain-tag">petición</div>
            <div class="explain-text" id="explain-text"></div>
          </div>
          <div class="console-line" id="console-line" style="display:none"></div>

          <div class="concepts-grid">
            <div class="concept-item">
              <div class="concept-icon">⏱️</div>
              <div>
                <strong>process.uptime():</strong> Mide los segundos exactos transcurridos desde que arrancó el proceso Node.js. Si el servidor se reinicia, vuelve a cero.
              </div>
            </div>
            <div class="concept-item">
              <div class="concept-icon">📈</div>
              <div>
                <strong>Contador en Memoria:</strong> <code>totalRequests++</code> es una variable en la RAM del servidor. Es ultra rápida (sin I/O de disco) y refleja la carga viva del proceso.
              </div>
            </div>
            <div class="concept-item">
              <div class="concept-icon">🔌</div>
              <div>
                <strong>Pools de Conexión:</strong> Postgres y Redis no abren y cierran sockets por petición; mantienen un pool permanente para responder en milisegundos.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
(function () {
  const steps = [
    {
      from: 'cliente', to: 'servidor', dir: 'request',
      code: 'router', file: 'metrics.routes.js',
      text: 'El navegador emite una petición HTTP <strong>GET /api/metrics</strong> hacia el puerto <code>5000</code>. El middleware <code>trackRequest</code> incrementa <code>totalRequests++</code> de inmediato en la RAM del servidor.'
    },
    {
      from: 'servidor', to: 'postgres', dir: 'request',
      code: 'health', file: 'metrics.routes.js',
      text: 'El servidor ejecuta <strong>checkDbConnection()</strong> usando el cliente activo del pool de PostgreSQL (<code>SELECT 1</code>) para confirmar que la base de datos responde.'
    },
    {
      from: 'servidor', to: 'redis', dir: 'request',
      code: 'health', file: 'metrics.routes.js',
      text: 'En paralelo mediante <strong>Promise.all</strong>, el servidor envía un comando <code>PING</code> a Redis esperando recibir <code>PONG</code>.'
    },
    {
      from: 'postgres', to: 'servidor', dir: 'response',
      code: 'uptime', file: 'metrics.routes.js',
      text: 'Tanto Postgres como Redis devuelven confirmación positiva. El servidor calcula <strong>process.uptime()</strong> y el uso de memoria con <code>process.memoryUsage()</code>.'
    },
    {
      from: 'servidor', to: 'cliente', dir: 'response',
      code: 'response', file: 'metrics.routes.js',
      text: 'El servidor serializa el objeto JSON de telemetría y responde con status <code>200 OK</code>. La interfaz actualiza los contadores en pantalla.',
      finalJson: true
    }
  ];

  const nodePos = { cliente: 9, servidor: 36.3, postgres: 63.7, redis: 91 };

  const packet = document.getElementById('packet');
  const btnRun = document.getElementById('btn-run');
  const btnReset = document.getElementById('btn-reset');
  const btnManualPing = document.getElementById('btn-manual-ping');
  const stepTrack = document.getElementById('step-track');
  const stepCount = document.getElementById('step-count');
  const codeFilename = document.getElementById('code-filename');
  const explainIdle = document.getElementById('explain-idle');
  const explainActive = document.getElementById('explain-active');
  const explainTag = document.getElementById('explain-tag');
  const explainText = document.getElementById('explain-text');
  const consoleLine = document.getElementById('console-line');

  const allNodes = ['cliente', 'servidor', 'postgres', 'redis'].map(id => document.getElementById('node-' + id));
  const allCodeLines = document.querySelectorAll('.line');

  // Construir barras de progreso
  steps.forEach((s, i) => {
    const seg = document.createElement('div');
    seg.className = 'seg';
    seg.dataset.index = String(i);
    seg.dataset.dir = s.dir;
    stepTrack?.appendChild(seg);
  });
  const segs = stepTrack?.querySelectorAll('.seg');

  let running = false;
  let currentStep = -1;

  function clearHighlights() {
    allNodes.forEach(n => n?.classList.remove('active'));
    allCodeLines.forEach(l => l.classList.remove('active', 'response'));
  }

  function setNodeActive(id: string, color: string) {
    const node = document.getElementById('node-' + id);
    if (node) {
      node.classList.add('active');
      node.style.setProperty('--node-color', color);
    }
  }

  function renderStep(i: number) {
    const s = steps[i];
    const color = s.dir === 'request' ? 'var(--amber)' : 'var(--blue)';

    clearHighlights();
    setNodeActive(s.from, color);
    setNodeActive(s.to, color);

    if (packet) {
      packet.classList.add('visible');
      packet.style.background = s.dir === 'request' ? 'var(--amber)' : 'var(--blue)';
      packet.style.left = nodePos[s.from as keyof typeof nodePos] + '%';
      void packet.offsetWidth;
      packet.style.left = nodePos[s.to as keyof typeof nodePos] + '%';
    }

    document.querySelectorAll('.line[data-key="' + s.code + '"]').forEach(l => {
      l.classList.add('active');
      if (s.dir === 'response') l.classList.add('response');
    });

    if (codeFilename) codeFilename.textContent = s.file;

    if (explainIdle) explainIdle.style.display = 'none';
    if (explainActive) explainActive.style.display = 'block';
    if (explainTag) {
      explainTag.textContent = s.dir === 'request' ? 'petición →' : '← respuesta';
      explainTag.className = 'explain-tag' + (s.dir === 'response' ? ' response' : '');
    }
    if (explainText) explainText.innerHTML = s.text;

    if (s.finalJson && consoleLine) {
      consoleLine.style.display = 'block';
      consoleLine.innerHTML = 'Status: <span class="json-str">200 OK</span> · Telemetría recibida correctamente';
    } else if (consoleLine) {
      consoleLine.style.display = 'none';
    }

    segs?.forEach((seg, idx) => {
      if (idx <= i) {
        seg.classList.add('filled');
        (seg as HTMLElement).style.background = steps[idx].dir === 'request' ? 'var(--amber)' : 'var(--blue)';
      } else {
        seg.classList.remove('filled');
        (seg as HTMLElement).style.background = '';
      }
    });

    if (stepCount) stepCount.textContent = (i + 1) + ' / ' + steps.length;
  }

  function reset(soft = false) {
    running = false;
    currentStep = -1;
    clearHighlights();
    if (packet) {
      packet.classList.remove('visible');
      packet.style.left = '9%';
    }
    if (explainIdle) explainIdle.style.display = 'block';
    if (explainActive) explainActive.style.display = 'none';
    if (consoleLine) consoleLine.style.display = 'none';
    if (codeFilename) codeFilename.textContent = 'routes/metrics.routes.js';
    segs?.forEach(s => {
      s.classList.remove('filled');
      (s as HTMLElement).style.background = '';
    });
    if (stepCount) stepCount.textContent = '0 / ' + steps.length;
    if (btnRun) {
      btnRun.textContent = 'Simular ciclo de vida';
      (btnRun as HTMLButtonElement).disabled = false;
    }
  }

  function nextStep() {
    if (!running) return;
    currentStep++;
    if (currentStep >= steps.length) {
      running = false;
      if (btnRun) {
        btnRun.textContent = 'Volver a simular';
        (btnRun as HTMLButtonElement).disabled = false;
      }
      return;
    }
    renderStep(currentStep);
    setTimeout(nextStep, 1800);
  }

  function start() {
    if (running) return;
    running = true;
    currentStep = -1;
    if (btnRun) {
      btnRun.textContent = 'Simulando...';
      (btnRun as HTMLButtonElement).disabled = true;
    }
    nextStep();
  }

  btnRun?.addEventListener('click', start);
  btnReset?.addEventListener('click', () => reset(true));

  // Tabs de código
  const tabs = document.querySelectorAll('.tab');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const tabTarget = (tab as HTMLElement).dataset.tab;
      const routesContent = document.getElementById('tab-content-routes');
      const middlewareContent = document.getElementById('tab-content-middleware');
      if (codeFilename) {
        codeFilename.textContent = tabTarget === 'routes' ? 'routes/metrics.routes.js' : 'metrics.js';
      }
      if (routesContent && middlewareContent) {
        if (tabTarget === 'routes') {
          routesContent.style.display = 'block';
          middlewareContent.style.display = 'none';
        } else {
          routesContent.style.display = 'none';
          middlewareContent.style.display = 'block';
        }
      }
    });
  });

  // ============================================================
  // POLLING EN VIVO DE /api/metrics
  // ============================================================
  const API_BASE = (window as any).RUNLEARN_API_URL || 'http://localhost:5000';
  let serverUptimeSeconds = 0;
  let lastServerFetchTime = Date.now();
  let pollIntervalTimer: any = null;
  let tickTimer: any = null;

  const statusIndicator = document.getElementById('status-indicator');
  const statusText = document.getElementById('status-text');
  const lastSyncChip = document.getElementById('last-sync-chip');
  const valUptimeFormatted = document.getElementById('val-uptime-formatted');
  const valUptimeSeconds = document.getElementById('val-uptime-seconds');
  const valRequests = document.getElementById('val-requests');
  const chipPg = document.getElementById('chip-pg');
  const textPg = document.getElementById('text-pg');
  const chipRedis = document.getElementById('chip-redis');
  const textRedis = document.getElementById('text-redis');
  const valRuntime = document.getElementById('val-runtime');
  const valMemRss = document.getElementById('val-mem-rss');
  const valMemHeap = document.getElementById('val-mem-heap');
  const valTimestamp = document.getElementById('val-timestamp');
  const rawJsonEl = document.getElementById('raw-json');
  const cardRequests = document.getElementById('card-requests');
  const reqDeltaBadge = document.getElementById('req-delta-badge');

  function formatTimeAgo(seconds: number) {
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);
    const parts = [];
    if (d > 0) parts.push(`${d}d`);
    if (h > 0 || d > 0) parts.push(`${h}h`);
    parts.push(`${m}m`);
    parts.push(`${s}s`);
    return parts.join(' ');
  }

  function triggerRequestPulse() {
    if (cardRequests) {
      cardRequests.classList.add('flash');
      setTimeout(() => cardRequests.classList.remove('flash'), 500);
    }
    if (reqDeltaBadge) {
      reqDeltaBadge.textContent = '¡Petición +1!';
      setTimeout(() => { reqDeltaBadge.textContent = 'En memoria'; }, 1200);
    }
  }

  async function fetchServerMetrics(isManual = false) {
    try {
      const res = await fetch(`${API_BASE}/api/metrics`, {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
      });

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const data = await res.json();
      serverUptimeSeconds = typeof data.uptime === 'number' ? data.uptime : 0;
      lastServerFetchTime = Date.now();

      // Actualizar estado del indicador
      if (statusIndicator) {
        statusIndicator.className = 'status-indicator online';
      }
      if (statusText) {
        statusText.textContent = 'ONLINE · Backend activo en puerto 5000';
      }

      // Actualizar requests
      if (valRequests) {
        const prev = valRequests.textContent;
        valRequests.textContent = data.requestsCount !== undefined ? String(data.requestsCount) : '--';
        if (prev !== '--' && prev !== String(data.requestsCount)) {
          triggerRequestPulse();
        }
      }

      // Actualizar Uptime inicial
      updateUptimeDisplay();

      // Servicios
      const pgConnected = data.services?.postgres === 'connected';
      if (chipPg && textPg) {
        chipPg.className = 'service-chip ' + (pgConnected ? 'connected' : 'disconnected');
        textPg.textContent = pgConnected ? 'Conectado' : 'Desconectado';
      }

      const redisConnected = data.services?.redis === 'connected';
      if (chipRedis && textRedis) {
        chipRedis.className = 'service-chip ' + (redisConnected ? 'connected' : 'disconnected');
        textRedis.textContent = redisConnected ? 'Conectado' : 'Desconectado';
      }

      // Sistema y memoria
      if (valRuntime && data.system) {
        valRuntime.textContent = `Node ${data.system.nodeVersion || ''} (${data.system.platform || 'linux'})`;
      }
      if (valMemRss && data.system?.memoryRssMb) {
        valMemRss.textContent = `${data.system.memoryRssMb} MB`;
      }
      if (valMemHeap && data.system?.heapUsedMb) {
        valMemHeap.textContent = `${data.system.heapUsedMb} MB`;
      }
      if (valTimestamp) {
        valTimestamp.textContent = data.timestamp || new Date().toISOString();
      }

      // Raw JSON
      if (rawJsonEl) {
        rawJsonEl.textContent = JSON.stringify(data, null, 2);
      }

      // Sincronización chip
      if (lastSyncChip) {
        const now = new Date();
        lastSyncChip.textContent = `Última sinc: ${now.toLocaleTimeString()}`;
      }

    } catch (err: any) {
      if (statusIndicator) {
        statusIndicator.className = 'status-indicator offline';
      }
      if (statusText) {
        statusText.textContent = 'DESCONECTADO · Asegurate de que el backend en :5000 esté corriendo';
      }
      if (rawJsonEl) {
        rawJsonEl.textContent = `Error al conectar con ${API_BASE}/api/metrics:\n${err?.message || err}`;
      }
    }
  }

  function updateUptimeDisplay() {
    // Calcula el uptime sumando los segundos transcurridos desde el último fetch
    const elapsedSinceFetch = Math.floor((Date.now() - lastServerFetchTime) / 1000);
    const currentTotalUptime = Math.max(0, serverUptimeSeconds + elapsedSinceFetch);

    if (valUptimeFormatted) {
      valUptimeFormatted.textContent = formatTimeAgo(currentTotalUptime);
    }
    if (valUptimeSeconds) {
      valUptimeSeconds.textContent = `${currentTotalUptime.toLocaleString()} segundos transcurridos`;
    }
  }

  // Ticker de 1 segundo para avance suave de cronómetro
  tickTimer = setInterval(updateUptimeDisplay, 1000);

  // Polling continuo cada 3.5 segundos al endpoint real
  fetchServerMetrics();
  pollIntervalTimer = setInterval(() => fetchServerMetrics(false), 3500);

  // Botón manual de ping
  btnManualPing?.addEventListener('click', () => {
    btnManualPing.classList.add('active-click');
    setTimeout(() => btnManualPing.classList.remove('active-click'), 300);
    fetchServerMetrics(true);
  });

  // Copiar JSON
  const btnCopy = document.getElementById('btn-copy-json');
  btnCopy?.addEventListener('click', () => {
    if (rawJsonEl && rawJsonEl.textContent) {
      navigator.clipboard.writeText(rawJsonEl.textContent).then(() => {
        const orig = btnCopy.textContent;
        btnCopy.textContent = '¡Copiado!';
        setTimeout(() => { btnCopy.textContent = orig; }, 1500);
      });
    }
  });

  reset(true);
})();
</script>

