---
// src/components/TechCard.astro
interface Props {
  id: string;
  badge: string;
  title: string;
  meta: string;
  themeColor: string;
  themeGlow: string;
  href?: string;
}

const { id, badge, title, meta, themeColor, themeGlow, href } = Astro.props;
---

{href ? (
  <a
    class={`tech-card tech-card--${id}`}
    href={href}
    style={`--theme-color: ${themeColor}; --theme-glow: ${themeGlow};`}
  >
    <div class="tech-card__top">
      <span class="tech-badge">{badge}</span>
      <span class="tech-indicator">●</span>
    </div>

    <div class="tech-card__center">
      <div class="tech-card__icon-box">
        <slot name="icon" />
      </div>
      <h3 class="tech-card__title">{title}</h3>
    </div>

    <div class="tech-card__footer">
      <span class="tech-meta">{meta}</span>
      <span class="arrow-arrow">→</span>
    </div>
  </a>
) : (
  <article
    class={`tech-card tech-card--${id}`}
    tabindex="0"
    role="button"
    style={`--theme-color: ${themeColor}; --theme-glow: ${themeGlow};`}
  >
    <div class="tech-card__top">
      <span class="tech-badge">{badge}</span>
      <span class="tech-indicator">●</span>
    </div>

    <div class="tech-card__center">
      <div class="tech-card__icon-box">
        <slot name="icon" />
      </div>
      <h3 class="tech-card__title">{title}</h3>
    </div>

    <div class="tech-card__footer">
      <span class="tech-meta">{meta}</span>
      <span class="arrow-arrow">→</span>
    </div>
  </article>
)}

<style>
  .tech-card {
    position: relative;
    background-color: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.15rem 1.15rem 1rem;
    min-height: 124px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    overflow: hidden;
    outline: none;
    box-shadow: var(--shadow-card), var(--glass-highlight);
    color: inherit;
    text-decoration: none;
    transition: 
      transform var(--ease-spring),
      border-color var(--ease-spring),
      background-color var(--ease-fast),
      box-shadow var(--ease-spring);
    user-select: none;
  }

  .tech-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% -10%,
      var(--theme-glow, rgba(255, 255, 255, 0.08)) 0%,
      transparent 65%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .tech-card:hover {
    transform: translateY(-4px) scale(1.01);
    border-color: var(--theme-color, var(--border-hover));
    background-color: var(--surface-card-hover);
    box-shadow: 
      0 16px 36px -8px rgba(0, 0, 0, 0.7),
      0 0 24px -2px var(--theme-glow, rgba(255, 255, 255, 0.1));
  }

  .tech-card:hover::before {
    opacity: 1;
  }

  .tech-card:focus-visible {
    outline: 2px solid var(--theme-color, var(--brand-blue));
    outline-offset: 3px;
  }

  .tech-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .tech-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    transition: color var(--ease-fast), border-color var(--ease-fast);
  }

  .tech-indicator {
    font-size: 0.5rem;
    color: var(--text-muted);
    transition: color var(--ease-fast), text-shadow var(--ease-fast);
  }

  .tech-card:hover .tech-badge {
    color: var(--theme-color, var(--text-primary));
    border-color: rgba(255, 255, 255, 0.1);
  }

  .tech-card:hover .tech-indicator {
    color: var(--theme-color, var(--brand-blue));
    text-shadow: 0 0 8px var(--theme-color, var(--brand-blue));
  }

  .tech-card__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0.4rem 0;
    position: relative;
    z-index: 1;
  }

  .tech-card__icon-box {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: grid;
    place-items: center;
    transition: transform var(--ease-spring), background var(--ease-fast), border-color var(--ease-fast);
  }

  .tech-card:hover .tech-card__icon-box {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }

  :global(.tech-icon) {
    width: 24px;
    height: 24px;
    color: var(--theme-color, var(--text-primary));
    transition: transform var(--ease-spring);
  }

  .tech-card:hover :global(.tech-icon) {
    transform: scale(1.1);
  }

  .tech-card__title {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    text-align: center;
  }

  .tech-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .tech-meta {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--ease-fast);
  }

  .arrow-arrow {
    font-size: 0.8125rem;
    color: var(--text-muted);
    transform: translateX(-4px);
    opacity: 0;
    transition: all var(--ease-spring);
  }

  .tech-card:hover .tech-meta {
    color: var(--text-secondary);
  }

  .tech-card:hover .arrow-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--theme-color, var(--text-white));
  }
</style>
