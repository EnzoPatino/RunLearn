---
// src/components/TechCard.astro
import ClassIcon from './ClassIcon.astro';

interface Props {
  id: string;
  badge: string;
  title: string;
  meta: string;
  themeColor: string;
  themeGlow?: string;
  href?: string;
  icon?: string;
  snippetCmd?: string;
  snippetResult?: string;
  snippetOk?: boolean;
}

const {
  id,
  badge,
  title,
  meta,
  themeColor,
  themeGlow = `color-mix(in srgb, ${Astro.props.themeColor} 22%, transparent)`,
  href,
  icon,
  snippetCmd,
  snippetResult,
  snippetOk = true,
} = Astro.props;
---

{href ? (
  <a
    class={`card tech-card tech-card--${id}`}
    href={href}
    style={`--c: ${themeColor}; --theme-color: ${themeColor}; --theme-glow: ${themeGlow};`}
  >
    <div class="ctop">
      <span class="tag">
        <i></i>{badge}
      </span>
      <span class="go" aria-hidden="true">↗</span>
    </div>

    <h3>{title}</h3>
    <p>{meta}</p>

    {snippetCmd && (
      <div class="mini">
        <div class="c">{snippetCmd}</div>
        {snippetResult && (
          <div class="r">
            <span class={snippetOk ? "ok" : "bad"}>{snippetOk ? "✓" : "✗"}</span>{" "}
            {snippetResult}
          </div>
        )}
      </div>
    )}
  </a>
) : (
  <article
    class={`card tech-card tech-card--${id}`}
    tabindex="0"
    role="button"
    style={`--c: ${themeColor}; --theme-color: ${themeColor}; --theme-glow: ${themeGlow};`}
  >
    <div class="ctop">
      <span class="tag">
        <i></i>{badge}
      </span>
      <span class="go" aria-hidden="true">↗</span>
    </div>

    <h3>{title}</h3>
    <p>{meta}</p>

    {snippetCmd && (
      <div class="mini">
        <div class="c">{snippetCmd}</div>
        {snippetResult && (
          <div class="r">
            <span class={snippetOk ? "ok" : "bad"}>{snippetOk ? "✓" : "✗"}</span>{" "}
            {snippetResult}
          </div>
        )}
      </div>
    )}
  </article>
)}

<style>
  .card {
    position: relative;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    transition: transform .25s ease, border-color .25s ease;
    min-height: 216px;
    box-sizing: border-box;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--c) 16%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--c);
  }

  .card:hover::before {
    opacity: 1;
  }

  .ctop {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tag {
    font-family: var(--m);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--c);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tag i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c);
  }

  .go {
    color: var(--mut);
    font-size: 16px;
    transition: transform .25s ease, color .25s ease;
  }

  .card:hover .go {
    color: var(--c);
    transform: translate(3px, -3px);
  }

  .card h3 {
    margin: 6px 0 0;
    font-size: 22px;
    letter-spacing: -.02em;
    font-family: var(--f);
    font-weight: 700;
    color: var(--fg);
  }

  .card p {
    margin: 0;
    font-size: 14px;
    color: var(--mut);
    line-height: 1.45;
  }

  .mini {
    margin-top: auto;
    font-family: var(--m);
    font-size: 12px;
    line-height: 1.6;
    background: #070806;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: #cfd5c4;
    overflow: hidden;
  }

  .mini .c {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini .c::before {
    content: "$ ";
    color: var(--lime);
    font-weight: bold;
  }

  .mini .r {
    opacity: 0;
    max-height: 0;
    transition: opacity .3s ease, max-height .3s ease, margin-top .3s ease;
    white-space: normal;
  }

  .card:hover .r,
  .card:focus-visible .r {
    opacity: 1;
    max-height: 60px;
    margin-top: 4px;
  }

  @media (pointer: coarse) {
    .mini .r {
      opacity: 1;
      max-height: 60px;
      margin-top: 4px;
    }
  }

  .ok {
    color: #34d399;
    font-weight: bold;
  }

  .bad {
    color: var(--bad);
    font-weight: bold;
  }
</style>
