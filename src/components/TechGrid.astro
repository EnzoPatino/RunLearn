---
// src/components/TechGrid.astro
import TechCard from './TechCard.astro';
import { clases } from '../data/clases.js';
---

<section class="bento-section" aria-label="Módulos de Tecnologías">
  <div class="tech-grid">
    {clases.map((clase) => (
      <TechCard
        id={clase.id}
        badge={clase.category}
        title={clase.title}
        meta={clase.description}
        themeColor={clase.colorAccent}
        href={clase.route}
        icon={clase.icon}
      />
    ))}
  </div>
</section>

<style>
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }
  }
</style>
