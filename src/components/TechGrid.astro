---
// src/components/TechGrid.astro
import TechCard from './TechCard.astro';
---

<section class="bento-section" aria-label="Módulos de Tecnologías">
  <div class="tech-grid">
    <!-- 1. API -->
    <TechCard 
      id="api"
      badge="Backend"
      title="API"
      meta="REST & GraphQL"
      themeColor="#38bdf8"
      themeGlow="var(--brand-blue-glow)"
      href="/api-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="8" rx="2" />
        <rect x="2" y="14" width="20" height="8" rx="2" />
        <line x1="6" y1="6" x2="6.01" y2="6" stroke-width="2.5" />
        <line x1="6" y1="18" x2="6.01" y2="18" stroke-width="2.5" />
        <path d="M14 6h4" />
        <path d="M14 18h4" />
      </svg>
    </TechCard>

    <!-- 2. Docker -->
    <TechCard 
      id="docker"
      badge="DevOps"
      title="Docker"
      meta="Contenedores"
      themeColor="#38bdf8"
      themeGlow="var(--color-docker-glow)"
      href="/docker-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 13.5c0 4.5-4 7.5-9.5 7.5S3 17.5 3 13.5c0-1.8 1-3.5 2-4.5 1 .5 2 1 3.5 0 1.5 1.5 3 1.5 5 1s3.5-.5 4.5-2c1.5 1 3 1 4 2z" />
        <rect x="4" y="10" width="2.5" height="2.5" rx="0.4" />
        <rect x="7.5" y="10" width="2.5" height="2.5" rx="0.4" />
        <rect x="11" y="10" width="2.5" height="2.5" rx="0.4" />
        <rect x="7.5" y="6.5" width="2.5" height="2.5" rx="0.4" />
        <rect x="11" y="6.5" width="2.5" height="2.5" rx="0.4" />
      </svg>
    </TechCard>

    <!-- 3. Algoritmo de número -->
    <TechCard 
      id="algoritmo"
      badge="Lógica"
      title="Algoritmo de número"
      meta="Estructuras & Lógica"
      themeColor="#fb923c"
      themeGlow="var(--color-html-glow)"
      href="/algoritmo-numero"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="9" x2="20" y2="9" />
        <line x1="4" y1="15" x2="20" y2="15" />
        <line x1="10" y1="3" x2="8" y2="21" />
        <line x1="16" y1="3" x2="14" y2="21" />
      </svg>
    </TechCard>

    <!-- 4. Servidor -->
    <TechCard 
      id="servidor"
      badge="Sistema"
      title="Servidor"
      meta="Linux Shell & Cloud"
      themeColor="#f97316"
      themeGlow="var(--color-ubuntu-glow)"
      href="/servidor-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="8" rx="2" />
        <rect x="2" y="14" width="20" height="8" rx="2" />
        <line x1="6" y1="6" x2="6.01" y2="6" stroke-width="2.5" />
        <line x1="6" y1="18" x2="6.01" y2="18" stroke-width="2.5" />
        <line x1="10" y1="6" x2="14" y2="6" />
        <line x1="10" y1="18" x2="14" y2="18" />
      </svg>
    </TechCard>

    <!-- 5. GitHub -->
    <TechCard 
      id="github"
      badge="Control"
      title="GitHub"
      meta="Repositorios"
      themeColor="#e2e8f0"
      themeGlow="var(--color-github-glow)"
      href="/github-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
      </svg>
    </TechCard>

    <!-- 6. Bots -->
    <TechCard 
      id="bots"
      badge="Automatización"
      title="Bots"
      meta="Agentes & Scripts"
      themeColor="#fb7185"
      themeGlow="var(--color-gitlab-glow)"
      href="/bots-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="10" rx="2" />
        <circle cx="12" cy="5" r="2" />
        <path d="M12 7v4" />
        <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="2.5" />
        <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="2.5" />
      </svg>
    </TechCard>

    <!-- 7. HTTP / HTTPS -->
    <TechCard 
      id="http"
      badge="Redes"
      title="HTTP / HTTPS"
      meta="Protocolos"
      themeColor="#22d3ee"
      themeGlow="var(--color-http-glow)"
      href="/http-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="2" y1="12" x2="22" y2="12" />
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
      </svg>
    </TechCard>

    <!-- 8. Base de datos -->
    <TechCard 
      id="database"
      badge="Almacén"
      title="Base de datos"
      meta="SQL & NoSQL"
      themeColor="#c084fc"
      themeGlow="var(--color-db-glow)"
      href="/database-explicacion"
    >
      <svg slot="icon" class="tech-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="12" cy="5" rx="9" ry="3" />
        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
      </svg>
    </TechCard>
  </div>
</section>

<style>
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }
  }
</style>
