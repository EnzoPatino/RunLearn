---
interface Step {
  node: string;
  label: string;
  code: string;
  explanation: string;
}

interface Props {
  title: string;
  category: string;
  description: string;
  nodes: { id: string; label: string }[];
  steps: Step[];
}

const { title, category, description, nodes, steps } = Astro.props;
---

<div class="lesson-page" data-lesson>
  <header class="lesson-topbar">
    <a class="lesson-brand" href="/" aria-label="Volver al inicio de RunLearn"><span>RL</span> RunLearn</a>
    <nav class="lesson-crumbs" aria-label="Ruta actual">
      <a href="/">Inicio</a><span>/</span><a href="/clases">Clases</a><span>/</span><strong>{title}</strong>
    </nav>
    <button class="lesson-sound" id="btn-toggle-sound" type="button" aria-pressed="false">
      <span id="sound-icon" aria-hidden="true"></span><span id="sound-text">Sonido activo</span>
    </button>
  </header>

  <section class="lesson-intro">
    <span class="lesson-category">{category}</span>
    <h1>{title}</h1>
    <p>{description}</p>
  </section>

  <section class="lesson-flow" aria-label="Diagrama interactivo de la clase">
    <div class="flow-track">
      {nodes.map((node) => (
        <div class="flow-item">
          <div class="flow-node" data-node={node.id} aria-label={node.label}>
            <span aria-hidden="true"></span>
          </div>
          <span class="flow-label">{node.label}</span>
          <span class="flow-connector" aria-hidden="true"></span>
        </div>
      ))}
    </div>
    <div class="flow-caption">
      <span class="flow-pulse" aria-hidden="true"></span>
      <span id="lesson-step-label" aria-live="polite">{steps[0]?.label}</span>
      <span class="flow-count" id="lesson-count">01 / {String(steps.length).padStart(2, '0')}</span>
    </div>
    <div class="lesson-progress" role="progressbar" aria-label="Avance de la explicación" aria-valuemin="1" aria-valuemax={steps.length} aria-valuenow="1">
      <span id="lesson-progress-fill"></span>
    </div>
  </section>

  <section class="lesson-panels">
    <article class="lesson-panel lesson-code-panel">
      <div class="panel-heading"><span>Flujo por dentro</span><span class="panel-file">{title.toLowerCase().replaceAll(' ', '-')}.txt</span></div>
      <pre><code id="lesson-code">{steps[0]?.code}</code></pre>
      <div class="lesson-controls">
        <button type="button" class="lesson-button lesson-button--quiet" id="lesson-reset">Reiniciar</button>
        <div class="lesson-step-buttons">
          <button type="button" class="lesson-button lesson-button--quiet" id="lesson-prev" aria-label="Paso anterior">←</button>
          <button type="button" class="lesson-button lesson-button--next" id="lesson-next">Siguiente paso →</button>
        </div>
      </div>
    </article>
    <article class="lesson-panel lesson-explanation-panel">
      <div class="panel-heading"><span>Qué está pasando</span><span class="live-mark">EN VIVO</span></div>
      <h2 id="lesson-heading">{steps[0]?.label}</h2>
      <p id="lesson-explanation">{steps[0]?.explanation}</p>
      <a class="lesson-back-link" href="/clases">Explorar otras clases <span aria-hidden="true">→</span></a>
    </article>
  </section>

  <div class="lesson-sources" hidden>
    {steps.map((step) => (
      <div data-step-source data-node={step.node} data-label={step.label}>
        <span data-explanation>{step.explanation}</span>
        <code data-code>{step.code}</code>
      </div>
    ))}
  </div>
</div>

<script>
  import { initSoundControls } from '../lib/soundControls.js';

  const lesson = document.querySelector('[data-lesson]');
  if (lesson && !lesson.hasAttribute('data-ready')) {
    lesson.setAttribute('data-ready', 'true');
    const sound = initSoundControls();
    const sources = [...lesson.querySelectorAll('.lesson-sources [data-step-source]')];
    const steps = sources.map((source) => ({
      node: source.dataset.node,
      label: source.dataset.label,
      explanation: source.querySelector('[data-explanation]')?.textContent || '',
      code: source.querySelector('[data-code]')?.textContent || '',
    }));
    const nodes = [...lesson.querySelectorAll('[data-node]')].filter((node) => node.classList.contains('flow-node'));
    const progress = lesson.querySelector('.lesson-progress');
    const progressFill = lesson.querySelector('#lesson-progress-fill');
    const previous = lesson.querySelector('#lesson-prev');
    const next = lesson.querySelector('#lesson-next');
    let current = 0;

    function showStep(index, playSound = true) {
      current = Math.max(0, Math.min(steps.length - 1, index));
      const step = steps[current];
      lesson.querySelector('#lesson-step-label').textContent = step.label;
      lesson.querySelector('#lesson-count').textContent = `${String(current + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
      lesson.querySelector('#lesson-heading').textContent = step.label;
      lesson.querySelector('#lesson-explanation').textContent = step.explanation;
      lesson.querySelector('#lesson-code').textContent = step.code;
      nodes.forEach((node) => node.classList.toggle('is-active', node.dataset.node === step.node));
      progress.setAttribute('aria-valuenow', String(current + 1));
      progressFill.style.width = `${((current + 1) / steps.length) * 100}%`;
      previous.disabled = current === 0;
      next.textContent = current === steps.length - 1 ? 'Volver al inicio ↻' : 'Siguiente paso →';
      if (playSound) sound.play('playStep');
    }

    previous.addEventListener('click', () => showStep(current - 1));
    next.addEventListener('click', () => showStep(current === steps.length - 1 ? 0 : current + 1));
    lesson.querySelector('#lesson-reset').addEventListener('click', () => showStep(0));
    showStep(0, false);
  }
</script>

<style>
  .lesson-page { --lesson-accent: var(--lime); width: min(1120px, calc(100% - 40px)); margin: 24px auto 64px; color: var(--fg); }
  .lesson-topbar { min-height: 62px; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 0 18px; border: 1px solid var(--line); border-radius: 18px; background: rgba(18,20,15,.88); }
  .lesson-brand { display: inline-flex; align-items: center; gap: 9px; color: var(--fg); text-decoration: none; font-weight: 800; white-space: nowrap; }
  .lesson-brand span { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 9px; color: var(--ink); background: var(--lesson-accent); font: 700 11px var(--m); }
  .lesson-crumbs { display: flex; align-items: center; gap: 9px; color: var(--mut); font-size: 12px; min-width: 0; }
  .lesson-crumbs a { color: inherit; text-decoration: none; }
  .lesson-crumbs a:hover, .lesson-crumbs strong { color: var(--fg); }
  .lesson-crumbs strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lesson-sound { display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px; border: 1px solid var(--line); border-radius: 10px; color: var(--mut); background: transparent; cursor: pointer; font: 600 11px var(--m); white-space: nowrap; }
  .lesson-intro { padding: clamp(38px, 8vw, 82px) 0 32px; }
  .lesson-category { display: inline-block; margin-bottom: 14px; color: var(--lesson-accent); font: 700 11px var(--m); letter-spacing: .14em; text-transform: uppercase; }
  .lesson-intro h1 { margin: 0; font-size: clamp(40px, 8vw, 82px); line-height: .98; letter-spacing: -.055em; }
  .lesson-intro p { max-width: 760px; margin: 20px 0 0; color: var(--mut); font-size: clamp(16px, 2vw, 19px); line-height: 1.65; }
  .lesson-flow, .lesson-panel { border: 1px solid var(--line); border-radius: 20px; background: linear-gradient(145deg, rgba(20,23,17,.96), rgba(13,15,12,.98)); }
  .lesson-flow { padding: clamp(20px, 4vw, 38px); }
  .flow-track { display: flex; align-items: flex-start; width: 100%; counter-reset: flow-stage; }
  .flow-item { position: relative; display: flex; flex: 1; flex-direction: column; align-items: flex-start; min-width: 0; }
  .flow-item:last-child { flex: 0 0 auto; }
  .flow-node { display: grid; width: 52px; height: 52px; place-items: center; border: 1px solid #343a2b; border-radius: 16px; color: var(--mut); background: #0b0d09; counter-increment: flow-stage; transition: color .2s, border-color .2s, box-shadow .2s, transform .2s; }
  .flow-node::before { content: counter(flow-stage, decimal-leading-zero); font: 700 12px var(--m); }
  .flow-item:last-child .flow-connector { display: none; }
  .flow-node.is-active { color: var(--lesson-accent); border-color: var(--lesson-accent); box-shadow: 0 0 24px color-mix(in srgb, var(--lesson-accent) 20%, transparent); transform: translateY(-3px); }
  .flow-label { margin-top: 10px; color: var(--mut); font: 600 11px var(--m); }
  .flow-connector { position: absolute; top: 26px; left: 52px; width: calc(100% - 52px); height: 1px; background: linear-gradient(90deg, #343a2b, #596044); }
  .flow-caption { display: flex; align-items: center; gap: 9px; margin-top: 28px; color: var(--text-secondary); font: 600 12px var(--m); }
  .flow-pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--lesson-accent); box-shadow: 0 0 12px var(--lesson-accent); }
  .flow-count { margin-left: auto; color: var(--mut); }
  .lesson-progress { height: 3px; margin-top: 14px; overflow: hidden; border-radius: 9px; background: #24291e; }
  .lesson-progress span { display: block; width: 0; height: 100%; background: var(--lesson-accent); transition: width .3s ease; }
  .lesson-panels { display: grid; grid-template-columns: 1.1fr .9fr; gap: 16px; margin-top: 16px; }
  .lesson-panel { min-width: 0; padding: clamp(19px, 3vw, 28px); }
  .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 16px; border-bottom: 1px solid var(--line); color: var(--text-secondary); font: 700 11px var(--m); letter-spacing: .08em; text-transform: uppercase; }
  .panel-file { overflow: hidden; color: var(--mut); font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .live-mark { color: var(--lesson-accent); font-size: 9px; }
  .lesson-code-panel pre { min-height: 140px; margin: 0; padding: 24px 0; overflow: auto; color: #cbd5b7; font: 500 13px/1.8 var(--m); white-space: pre-wrap; }
  .lesson-controls, .lesson-step-buttons { display: flex; align-items: center; justify-content: space-between; gap: 9px; }
  .lesson-controls { border-top: 1px solid var(--line); padding-top: 16px; }
  .lesson-button { min-height: 40px; padding: 0 13px; border: 1px solid var(--line); border-radius: 10px; font: 700 11px var(--m); cursor: pointer; transition: background .2s, border-color .2s, opacity .2s; }
  .lesson-button--quiet { color: var(--mut); background: transparent; }
  .lesson-button--quiet:hover:not(:disabled) { color: var(--fg); border-color: #515a40; }
  .lesson-button--next { color: var(--ink); border-color: var(--lesson-accent); background: var(--lesson-accent); }
  .lesson-button:disabled { opacity: .4; cursor: not-allowed; }
  .lesson-explanation-panel h2 { margin: 26px 0 12px; font-size: 25px; letter-spacing: -.03em; }
  .lesson-explanation-panel p { min-height: 100px; color: var(--mut); font-size: 15px; line-height: 1.75; }
  .lesson-back-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: var(--lesson-accent); text-decoration: none; font-weight: 700; font-size: 13px; }
  .lesson-back-link span { transition: transform .2s; }
  .lesson-back-link:hover span { transform: translateX(4px); }
  .lesson-page :focus-visible { outline: 2px solid var(--lesson-accent); outline-offset: 3px; }
  @media (max-width: 700px) {
    .lesson-page { width: min(100% - 24px, 560px); margin-top: 12px; }
    .lesson-topbar { padding: 10px 12px; flex-wrap: wrap; }
    .lesson-crumbs { order: 3; width: 100%; padding: 2px 0 4px; }
    .lesson-sound { margin-left: auto; }
    .lesson-panels { grid-template-columns: 1fr; }
    .flow-node { width: 42px; height: 42px; border-radius: 13px; }
    .flow-connector { top: 21px; left: 42px; width: calc(100% - 42px); }
    .flow-label { font-size: 9px; overflow-wrap: anywhere; }
  }
  @media (max-width: 390px) {
    .lesson-sound #sound-text { display: none; }
    .flow-node { width: 36px; height: 36px; border-radius: 11px; }
    .flow-connector { top: 18px; left: 36px; width: calc(100% - 36px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-node, .lesson-progress span, .lesson-button, .lesson-back-link span { transition: none; }
  }
</style>
