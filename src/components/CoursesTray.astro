---
// src/components/CoursesTray.astro
import CourseCard from './CourseCard.astro';
---

<section class="courses-tray" aria-label="Cursos en progreso">
  <div class="courses-grid">
    <!-- 1. GitLab -->
    <CourseCard
      id="gitlab"
      name="GitLab"
      status="En curso"
      statusType="default"
      progress={72}
      moduleInfo="Módulo 3 de 5"
      themeColor="#fb7185"
      themeGlow="var(--color-gitlab-glow)"
    >
      <svg slot="icon" class="course-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51A.42.42 0 0 1 5.48 2h.06a.42.42 0 0 1 .4.28l2.45 7.51h7.22l2.45-7.51a.42.42 0 0 1 .4-.28h.06a.42.42 0 0 1 .41.16l2.44 7.51 1.22 3.78a.84.84 0 0 1-.29.94z" />
      </svg>
    </CourseCard>

    <!-- 2. Docker -->
    <CourseCard
      id="docker"
      name="Docker"
      status="En curso"
      statusType="default"
      progress={45}
      moduleInfo="Módulo 2 de 6"
      themeColor="#38bdf8"
      themeGlow="var(--color-docker-glow)"
    >
      <svg slot="icon" class="course-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 13.5c0 4.5-4 7.5-9.5 7.5S3 17.5 3 13.5c0-1.8 1-3.5 2-4.5 1 .5 2 1 3.5 0 1.5 1.5 3 1.5 5 1s3.5-.5 4.5-2c1.5 1 3 1 4 2z" />
        <rect x="4" y="10" width="2.5" height="2.5" rx="0.4" />
        <rect x="8" y="10" width="2.5" height="2.5" rx="0.4" />
      </svg>
    </CourseCard>

    <!-- 3. DNS -->
    <CourseCard
      id="dns"
      name="DNS"
      status="Completado"
      statusType="ready"
      progress={100}
      moduleInfo="Finalizado"
      themeColor="#34d399"
      themeGlow="rgba(16, 185, 129, 0.2)"
    >
      <svg slot="icon" class="course-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="3" width="20" height="7" rx="2" />
        <rect x="2" y="14" width="20" height="7" rx="2" />
        <line x1="6" y1="6.5" x2="6.01" y2="6.5" stroke-width="2.5" />
        <line x1="6" y1="17.5" x2="6.01" y2="17.5" stroke-width="2.5" />
      </svg>
    </CourseCard>

    <!-- 4. Clase Personalizada -->
    <CourseCard
      id="custom"
      name="Clase personalizada"
      status="Nuevo"
      statusType="action"
      customDescription="Crea un temario a medida con IA"
      themeColor="#60a5fa"
      themeGlow="var(--brand-blue-glow)"
      isAction={true}
    >
      <svg slot="icon" class="course-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19" stroke-linecap="round" />
        <line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round" />
      </svg>
    </CourseCard>
  </div>
</section>

<style>
  .courses-tray {
    background: rgba(18, 22, 29, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1rem;
    box-shadow: var(--glass-highlight);
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .courses-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }
</style>
