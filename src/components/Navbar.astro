  .search-empty {
    padding: 1.5rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .search-empty em {
    color: var(--text-secondary);
    font-style: normal;
    font-weight: 600;
  }

  .search-modal__footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--border-hairline);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .search-modal__footer kbd {
    font-family: inherit;
    padding: 0.05rem 0.3rem;
    margin-right: 0.2rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  @media (max-width: 960px) {
    .navbar__search-hint .kbd-shortcut {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .navbar {
      height: auto;
      padding: 0.85rem 1rem;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .navbar__nav {
      order: 3;
      width: 100%;
      justify-content: center;
    }

    .navbar__left {
      flex: 1;
      min-width: 0;
      gap: 0.65rem;
    }

    .navbar__meta {
      max-width: calc(100vw - 8rem);
    }

    .nav-pill {
      padding: 0.4rem 0.75rem;
      font-size: 0.8125rem;
    }

    .navbar__menu {
      right: 0;
      left: 0;
      width: auto;
    }

    .search-modal {
      padding: 8vh 0.75rem 1rem;
    }

    .search-modal__footer {
      display: none;
    }
  }
</style>

<script>
  let currentAvatarUser = null;

  function renderLoggedOut() {
    currentAvatarUser = null;
    const avatar = document.getElementById('navbar-avatar');
    const avatarImage = document.getElementById('navbar-avatar-image');
    const avatarGenerated = document.getElementById('navbar-avatar-generated');
    const avatarInitials = document.getElementById('navbar-avatar-initials');
    const avatarPlaceholder = document.getElementById('navbar-avatar-placeholder');
    const status = document.getElementById('navbar-avatar-status');
    const welcome = document.getElementById('navbar-welcome');
    const userTitle = document.getElementById('navbar-user-title');
    const loginLink = document.getElementById('navbar-login-link');
    const registerLink = document.getElementById('navbar-register-link');
    const logoutButton = document.getElementById('navbar-logout-btn');
    const mainAuthLink = document.getElementById('navbar-main-auth-link');

    if (avatar) {
      avatar.classList.add('navbar__avatar--offline');
      avatar.title = 'No logueado';
      avatar.disabled = true;
    }
    if (avatarImage) { avatarImage.hidden = true; avatarImage.removeAttribute('src'); }
    if (avatarGenerated) avatarGenerated.hidden = true;
    if (avatarInitials) avatarInitials.hidden = true;
    if (avatarPlaceholder) avatarPlaceholder.hidden = false;
    if (status) {
      status.classList.add('avatar-status--offline');
      status.title = 'No logueado';
    }
    if (welcome) {
      welcome.textContent = 'Estado';
    }
    if (userTitle) {
      userTitle.textContent = 'No logueado';
    }
    if (loginLink) loginLink.hidden = false;
    if (registerLink) registerLink.hidden = false;
    if (logoutButton) logoutButton.hidden = true;
    if (mainAuthLink) mainAuthLink.hidden = false;
  }

  function renderLoggedIn(user) {
    currentAvatarUser = user;
    const avatar = document.getElementById('navbar-avatar');
    const avatarImage = document.getElementById('navbar-avatar-image');
    const avatarGenerated = document.getElementById('navbar-avatar-generated');
    const avatarInitials = document.getElementById('navbar-avatar-initials');
    const avatarPlaceholder = document.getElementById('navbar-avatar-placeholder');
    const status = document.getElementById('navbar-avatar-status');
    const welcome = document.getElementById('navbar-welcome');
    const userTitle = document.getElementById('navbar-user-title');
    const loginLink = document.getElementById('navbar-login-link');
    const registerLink = document.getElementById('navbar-register-link');
    const logoutButton = document.getElementById('navbar-logout-btn');
    const mainAuthLink = document.getElementById('navbar-main-auth-link');

    if (avatar) {
      avatar.classList.remove('navbar__avatar--offline');
      avatar.title = user?.email ? `Personalizar avatar de ${user.email}` : 'Personalizar avatar';
      avatar.disabled = false;
    }
    const metadata = user?.user_metadata || {};
    const profileName = metadata.full_name || metadata.name || metadata.display_name || user?.email?.split('@')[0] || 'Estudiante';
    const avatarUrl = metadata.runlearn_avatar ? null : metadata.avatar_url || metadata.picture || metadata.photo_url;
    const seedText = String(user?.id || profileName);
    let seed = Number.isInteger(metadata.runlearn_avatar?.style) ? metadata.runlearn_avatar.style : 0;
    if (!Number.isInteger(metadata.runlearn_avatar?.style)) for (const char of seedText) seed = (seed * 31 + char.charCodeAt(0)) >>> 0;
    applyAvatarStyle(seed);
    if (avatarGenerated) avatarGenerated.hidden = Boolean(avatarUrl);
    if (avatarImage) {
      avatarImage.hidden = !avatarUrl;
      if (avatarUrl) {
        avatarImage.src = avatarUrl;
        avatarImage.onerror = () => { avatarImage.hidden = true; if (avatarGenerated) avatarGenerated.hidden = false; };
      } else avatarImage.removeAttribute('src');
    }
    if (avatarPlaceholder) avatarPlaceholder.hidden = true;
    if (status) {
      status.classList.remove('avatar-status--offline');
      status.title = 'En línea';
    }
    if (welcome) {
      welcome.textContent = user?.user_metadata?.rol ? `Rol: ${user.user_metadata.rol}` : 'Espacio de Trabajo';
    }
    if (userTitle) {
      userTitle.textContent = profileName;
    }
    if (loginLink) loginLink.hidden = true;
    if (registerLink) registerLink.hidden = true;
    if (logoutButton) logoutButton.hidden = false;
    if (mainAuthLink) mainAuthLink.hidden = true;
  }

  const avatarPalettes = [
    ['#91aaff', '#5878e5'], ['#f4a27e', '#d97757'], ['#ffe36c', '#f0bd17'],
    ['#83d5df', '#4eabb9'], ['#53545c', '#08090c'], ['#ffd08a', '#e89a52'],
    ['#f7c4e6', '#e9a5d4'], ['#e2e4e8', '#b9bdc4'], ['#ff8585', '#df565a'],
    ['#e5eaff', '#cbd4ea'],
  ];
  const avatarBlobPaths = [
    'M32 4C46 4 58 15 60 29c2 14-8 27-22 31C22 64 7 54 5 39 3 23 16 7 32 4Z',
    'M18 8c6-5 12 2 17 0 6-3 10-1 13 5 2 4 8 5 9 11 2 8-4 10-2 16 2 7-5 14-12 15-6 1-9-4-15-1-7 3-14-1-15-8-1-5-8-7-7-14 1-5 5-8 4-13-1-4 3-9 8-11Z',
    'M32 3c13 0 24 10 26 24 2 15-7 32-23 34C17 63 6 49 6 34 6 17 17 4 32 3Z',
    'M32 3c8 11 22 15 25 27 4 15-7 30-23 31C17 62 5 49 8 34 10 21 24 14 32 3Z',
    'M32 5C48 5 59 17 59 33S48 60 32 60 5 49 5 33 16 5 32 5Z',
    'M32 14c10 0 18 8 18 18S42 50 32 50 14 42 14 32s8-18 18-18Z',
    'M18 18c5-7 13-8 19-3 7-3 15 2 15 10 8 5 8 15 1 20-4 9-14 11-21 5-9 4-19-1-18-10-8-5-7-17 4-22Z',
    'M21 16c5-8 16-8 21-1 10 0 15 10 10 18 3 9-5 18-14 17-7 7-19 3-20-6-9-5-8-19 3-22Z',
    'M18 7c7-4 12 3 18 2 6-1 12-3 16 3 4 5 0 10 5 15 5 6 0 12-1 17-2 8-9 10-16 8-7 4-13-1-18 0-8 1-13-5-10-12-5-7 0-12-2-18-2-6 1-12 8-15Z',
    'M31 7c9-1 17 5 20 12 10 3 13 13 8 21-3 8-12 12-20 9-8 7-21 3-22-7-10-4-12-16-4-23 3-7 10-11 18-12Z',
  ];
  const avatarNames = ['Strobi', 'Freddy', 'Citrus', 'Nova', 'Grok bot', 'Sunee', 'Kirby', 'Cloudee', 'Cubee', 'Onee'];

  function applyAvatarStyle(seed) {
    seed = Math.abs(Number(seed) || 0) % avatarPalettes.length;
    const [light, color] = avatarPalettes[seed];
    const lightStop = document.getElementById('avatar-blob-light');
    const colorStop = document.getElementById('avatar-blob-color');
    const shape = document.getElementById('avatar-blob-shape');
    const decor = document.getElementById('avatar-blob-decoration');
    if (lightStop) lightStop.setAttribute('stop-color', light);
    if (colorStop) colorStop.setAttribute('stop-color', color);
    if (shape) shape.setAttribute('d', avatarBlobPaths[seed]);
    if (decor) {
      decor.setAttribute('fill', light);
      decor.setAttribute('opacity', seed === 5 ? '.9' : '0');
      decor.innerHTML = seed === 5
        ? Array.from({ length: 8 }, (_, index) => `<circle cx="32" cy="8" r="4.5" transform="rotate(${index * 45} 32 32)" />`).join('')
        : '';
    }
    const avatar = document.getElementById('navbar-avatar');
    if (avatar) avatar.dataset.avatarStyle = String(seed);
  }

  function initAvatarCustomizer() {
    const dialog = document.getElementById('avatar-customizer');
    const trigger = document.getElementById('navbar-avatar');
    const choices = document.getElementById('avatar-customizer-choices');
    const preview = document.getElementById('avatar-customizer-preview');
    const save = document.getElementById('avatar-customizer-save');
    const status = document.getElementById('avatar-customizer-status');
    if (!dialog || !trigger || !choices || !preview || !save || dialog.dataset.initialized) return;
    dialog.dataset.initialized = 'true';
    let previewSaved = true;

    function makeAvatarSvg(index, idPrefix) {
      const [light, color] = avatarPalettes[index];
      const flower = index === 5
        ? Array.from({ length: 8 }, (_, petal) => `<circle cx="32" cy="8" r="4.5" transform="rotate(${petal * 45} 32 32)" fill="${light}"/>`).join('')
        : '';
      const shape = index === 5
        ? `<circle cx="32" cy="32" r="19" fill="url(#${idPrefix}-fill)"/>`
        : `<path d="${avatarBlobPaths[index]}" fill="url(#${idPrefix}-fill)"/>`;
      const eyeX = index === 3 ? [27, 39] : index === 8 ? [27, 40] : [27, 40];
      const eyeY = index === 3 ? [28, 25] : [29, 27];
      return `<svg class="avatar-generated" viewBox="0 0 64 64" role="img" aria-label="${avatarNames[index]}"><defs><radialGradient id="${idPrefix}-fill" cx="30%" cy="24%"><stop stop-color="${light}"/><stop offset="1" stop-color="${color}"/></radialGradient></defs>${flower}${shape}<g class="avatar-blob-eyes"><ellipse class="avatar-blob-eye" cx="${eyeX[0]}" cy="${eyeY[0]}" rx="2.2" ry="4.2" transform="rotate(-13 ${eyeX[0]} ${eyeY[0]})"/><ellipse class="avatar-blob-eye" cx="${eyeX[1]}" cy="${eyeY[1]}" rx="2.5" ry="4.8" transform="rotate(-13 ${eyeX[1]} ${eyeY[1]})"/><circle cx="${eyeX[0]-.6}" cy="${eyeY[0]-1}" r=".75" fill="#fff" opacity=".72"/><circle cx="${eyeX[1]-.7}" cy="${eyeY[1]-1.5}" r=".85" fill="#fff" opacity=".72"/></g></svg>`;
    }

    function showStyle(index) {
      const style = ((index % avatarPalettes.length) + avatarPalettes.length) % avatarPalettes.length;
      previewSaved = false;
      trigger.dataset.avatarStyle = String(style);
      applyAvatarStyle(style);
      const generated = document.getElementById('navbar-avatar-generated');
      const image = document.getElementById('navbar-avatar-image');
      if (generated) generated.hidden = false;
      if (image) image.hidden = true;
      preview.innerHTML = makeAvatarSvg(style, 'avatar-preview');
      choices.querySelectorAll('button').forEach((button, choiceIndex) => button.setAttribute('aria-pressed', String(choiceIndex === style)));
      status.textContent = 'Vista previa · guardá para conservarlo';
    }

    choices.innerHTML = avatarPalettes.map((_, index) => `<button class="avatar-choice" type="button" aria-pressed="false" aria-label="Elegir ${avatarNames[index]}">${makeAvatarSvg(index, `avatar-choice-${index}`)}<span>${avatarNames[index]}</span></button>`).join('');
    choices.addEventListener('click', event => {
      const button = event.target.closest('.avatar-choice');
      if (button) showStyle(Array.from(choices.children).indexOf(button));
    });
    trigger.addEventListener('click', () => {
      showStyle(Number(trigger.dataset.avatarStyle || 0));
      dialog.showModal();
    });
    save.addEventListener('click', async () => {
      save.disabled = true;
      status.textContent = 'Guardando en tu perfil…';
      try {
        const { supabase } = await import('../lib/supabaseClient.js');
        const { data, error } = await supabase.auth.updateUser({ data: { runlearn_avatar: { style: Number(trigger.dataset.avatarStyle || 0) } } });
        if (error) throw error;
        if (data.user) renderLoggedIn(data.user);
        previewSaved = true;
        status.textContent = 'Avatar guardado en tu perfil';
        window.setTimeout(() => dialog.close(), 450);
      } catch (error) {
        status.textContent = error?.message || 'No se pudo guardar. Intentá de nuevo.';
      } finally {
        save.disabled = false;
      }
    });
    dialog.addEventListener('close', () => {
      if (!previewSaved && currentAvatarUser) renderLoggedIn(currentAvatarUser);
    });
    trigger.addEventListener('pointermove', event => {
      const rect = trigger.getBoundingClientRect();
      const x = (event.clientX - rect.left - rect.width / 2) / rect.width;
      const y = (event.clientY - rect.top - rect.height / 2) / rect.height;
      trigger.style.setProperty('--look-x', `${x * 2}px`);
      trigger.style.setProperty('--look-y', `${y * 2}px`);
    });
    trigger.addEventListener('pointerleave', () => { trigger.style.removeProperty('--look-x'); trigger.style.removeProperty('--look-y'); });
  }

  if (document.documentElement.dataset.supabaseNavbarInitialized !== 'true') {
    document.documentElement.dataset.supabaseNavbarInitialized = 'true';
    initAvatarCustomizer();

    // Comprobación ultrarrápida sincrónica: ¿hay tokens de supabase en localStorage?
    let hasStoredSession = false;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && (k.startsWith('sb-') || k.includes('supabase.auth.token'))) {
          hasStoredSession = true;
          break;
        }
      }
    } catch {}

    const loadAuth = async () => {
      try {
        const { isSupabaseConfigured, supabase } = await import('../lib/supabaseClient.js');
        if (!isSupabaseConfigured || !supabase) {
          renderLoggedOut();
          return;
        }

        const { data, error } = await supabase.auth.getSession();
        if (error || !data.session?.user) {
          renderLoggedOut();
        } else {
          renderLoggedIn(data.session.user);
        }

        supabase.auth.onAuthStateChange((_event, session) => {
          if (session?.user) renderLoggedIn(session.user);
          else renderLoggedOut();
        });

        window.addEventListener('auth-change', async () => {
          const { data } = await supabase.auth.getSession();
          if (data.session?.user) renderLoggedIn(data.session.user);
          else renderLoggedOut();
        });

        document.getElementById('navbar-logout-btn')?.addEventListener('click', async () => {
          await supabase.auth.signOut();
          window.location.href = '/';
        });
      } catch (e) {
        renderLoggedOut();
      }
    };

    if (hasStoredSession) {
      loadAuth();
    } else {
      renderLoggedOut();
      // En dispositivos móviles y conexiones lentas diferimos cualquier carga al tiempo ocioso
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => {
          window.addEventListener('auth-change', loadAuth, { once: true });
        }, { timeout: 4000 });
      } else {
        setTimeout(() => {
          window.addEventListener('auth-change', loadAuth, { once: true });
        }, 2000);
      }
    }
  }
</script>

<script>
  import { clases } from '../data/clases.js';
  import { initSoundControls } from '../lib/soundControls.js';

  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const searchCount = document.getElementById('search-count');
  const searchEmpty = document.getElementById('search-empty');
  const searchEmptyQuery = document.getElementById('search-empty-query');
  const searchBtn = document.getElementById('navbar-search-btn');
  const searchCloseBtn = document.getElementById('search-close');
  const menuBtn = document.getElementById('navbar-menu-btn');
  const menu = document.getElementById('navbar-menu');

  // El modal usa position:fixed y vive dentro de .dashboard, cuyo
  // backdrop-filter crea un containing block: lo movemos a <body>.
  if (searchModal && searchModal.parentElement !== document.body) {
    document.body.appendChild(searchModal);
  }

  initSoundControls({
    buttonId: 'menu-sound-btn',
    iconId: 'menu-sound-icon',
    textId: 'menu-sound-text',
    activeText: 'Sonido activo',
    mutedText: 'Silenciado',
  });

  const normalize = (value) =>
    String(value)
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

  let matches = [];
  let activeIndex = 0;

  function updateActive() {
    const items = searchResults.querySelectorAll('.search-result');
    items.forEach((item, index) => {
      const isActive = index === activeIndex;
      item.classList.toggle('is-active', isActive);
      const link = item.querySelector('a');
      if (link) link.setAttribute('aria-selected', String(isActive));
      if (isActive) item.scrollIntoView?.({ block: 'nearest' });
    });
  }

  function renderResults(query) {
    const q = normalize(query.trim());
    matches = q
      ? clases.filter((clase) => normalize(clase.title).includes(q) || normalize(clase.category).includes(q))
      : clases.slice();
    activeIndex = 0;

    searchResults.innerHTML = '';

    for (const clase of matches) {
      const item = document.createElement('li');
      item.className = 'search-result';
      item.setAttribute('role', 'presentation');

      const link = document.createElement('a');
      link.href = clase.route;
      link.setAttribute('role', 'option');

      const body = document.createElement('div');
      body.className = 'search-result__body';

      const title = document.createElement('span');
      title.className = 'search-result__title';
      title.textContent = clase.title;

      const meta = document.createElement('span');
      meta.className = 'search-result__meta';
      meta.textContent = `${clase.category} · ${clase.description}`;

      const arrow = document.createElement('span');
      arrow.className = 'search-result__arrow';
      arrow.textContent = '→';

      body.append(title, meta);
      link.append(body, arrow);
      item.append(link);
      searchResults.append(item);
    }

    const total = matches.length;
    searchCount.textContent = `${total} ${total === 1 ? 'clase' : 'clases'}`;
    searchEmpty.hidden = total > 0;
    searchResults.hidden = total === 0;
    if (total === 0) searchEmptyQuery.textContent = query.trim();

    updateActive();
  }

  function openSearch() {
    if (!searchModal) return;
    closeMenu();
    searchModal.hidden = false;
    searchBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    searchInput.value = '';
    renderResults('');
    requestAnimationFrame(() => searchInput.focus());
  }

  function closeSearch() {
    if (!searchModal || searchModal.hidden) return;
    searchModal.hidden = true;
    searchBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (document.activeElement === searchInput || document.activeElement === searchCloseBtn) {
      searchBtn?.focus();
    }
  }

  function toggleSearch() {
    if (!searchModal) return;
    if (searchModal.hidden) openSearch();
    else closeSearch();
  }

  function openMenu() {
    if (!menu || !menuBtn) return;
    menu.hidden = false;
    menuBtn.setAttribute('aria-expanded', 'true');
    menuBtn.setAttribute('aria-label', 'Cerrar panel de opciones');
  }

  function closeMenu() {
    if (!menu || !menuBtn) return;
    if (menu.hidden) return;
    menu.hidden = true;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Abrir panel de opciones');
  }

  function toggleMenu() {
    if (!menu) return;
    if (menu.hidden) openMenu();
    else closeMenu();
  }

  searchBtn?.addEventListener('click', toggleSearch);
  searchCloseBtn?.addEventListener('click', closeSearch);
  searchModal?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);

  searchInput?.addEventListener('input', () => renderResults(searchInput.value));

  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (matches.length) activeIndex = (activeIndex + 1) % matches.length;
      updateActive();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (matches.length) activeIndex = (activeIndex - 1 + matches.length) % matches.length;
      updateActive();
    } else if (event.key === 'Enter') {
      const target = matches[activeIndex];
      if (target) {
        event.preventDefault();
        window.location.href = target.route;
      }
    } else if (event.key === 'Escape') {
      event.preventDefault();
      closeSearch();
    }
  });

  searchResults?.addEventListener('click', (event) => {
    if (event.target.closest('a')) closeSearch();
  });

  menuBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    toggleMenu();
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (event) => {
    if (!menu || menu.hidden) return;
    if (menu.contains(event.target) || menuBtn?.contains(event.target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    const key = event.key.toLowerCase();
    if ((event.metaKey || event.ctrlKey) && key === 'k') {
      if (event.target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(event.target.tagName)) return;
      event.preventDefault();
      toggleSearch();
      return;
    }
    if (event.key === 'Escape') {
      closeSearch();
      closeMenu();
    }
  });

  menu?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const items = [...menu.querySelectorAll('a:not([hidden]), button:not([hidden])')]
      .filter((item) => !item.hasAttribute('disabled'));
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
