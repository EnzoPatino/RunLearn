  .search-result a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
    transition: background var(--ease-fast), border-color var(--ease-fast);
  }

  .search-result.is-active a,
  .search-result a:hover {
