  .navbar__menu-btn:hover .navbar__menu-icon {
    stroke: var(--text-white);
  }

  .shortcut-other { display: none; }

  @media (hover: none) and (pointer: coarse) {
    .navbar__search-hint .kbd-shortcut { display: none; }
  }

  @media (max-width: 960px) {
    .shortcut-mac { display: none; }
    .shortcut-other { display: inline; }
  }

  .navbar :focus-visible,
  .search-modal :focus-visible {
    outline: 2px solid var(--lime);
